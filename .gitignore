# Dependencies
node_modules/

# Astro build output
dist/
.astro/

# Environment variables / secrets
.env
.env.*
!.env.example
# Broad glob, not just the exact filename — catches accidental copies
# like ".dev.vars.txt" (e.g. an editor's "Save As" appending an
# extension to a dotfile), which the exact-match version above missed
# and which real secrets ended up sitting in, unprotected, once.
.dev.vars*
!.dev.vars.example

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cloudflare
.wrangler/
# Regenerate with `npx wrangler types` whenever wrangler.toml's bindings change.
worker-configuration.d.ts
