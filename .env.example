# Copy this file to .env and fill in real values once the Sanity project
# exists (see sanity.config.ts). .env is gitignored; .env.example is not.

# Sanity project — create at sanity.io (Free tier, per CLAUDE.md)
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Used client-side by the Astro site to read published content.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Server-side only. Needed by the migration script to write content
# (a "write" token from https://www.sanity.io/manage -> API -> Tokens).
# Never commit this value or paste it into chat — same handling as the
# RentCast/RentEngine keys elsewhere in this project.
SANITY_API_WRITE_TOKEN=

# Rental analysis tool (see claude/rental-analysis-tool-build.md).
# Read at BUILD time (Astro inlines PUBLIC_* vars into the static intake
# form page) — safe to expose client-side, it's a site key not a secret.
# The matching TURNSTILE_SECRET_KEY, MAPBOX_TOKEN, and RentEngine keys are
# read at REQUEST time by the Cloudflare Worker instead — see
# .dev.vars.example, not this file.
PUBLIC_TURNSTILE_SITE_KEY=
