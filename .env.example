# Copy this file to .env and fill in real values once the Sanity project
# exists (see sanity.config.ts). .env is gitignored; .env.example is not.

# Sanity project — create at sanity.io (Free tier, per CLAUDE.md)
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Used client-side by the Astro site to read published content.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Server-side only. Needed by the migration script to write content
# (a "write" token from https://www.sanity.io/manage -> API -> Tokens).
# Never commit this value or paste it into chat — same handling as the
# RentCast/RentEngine keys elsewhere in this project.
SANITY_API_WRITE_TOKEN=

# Rental analysis tool (see claude/rental-analysis-tool-build.md).
# Read at BUILD time (Astro inlines PUBLIC_* vars into the static intake
# form page) — safe to expose client-side, it's a site key not a secret.
# The matching TURNSTILE_SECRET_KEY, MAPBOX_TOKEN, and RentEngine keys are
# read at REQUEST time by the Cloudflare Worker instead — see
# .dev.vars.example, not this file.
PUBLIC_TURNSTILE_SITE_KEY=

# Address autocomplete on the same intake form (2026-09-24). A separate,
# HTTP-referrer-restricted key on the SAME Google Cloud Maps Platform
# project as GOOGLE_STREETVIEW_API_KEY (.dev.vars.example) — that one is
# server-side-only and proxied, this one runs client-side as the visitor
# types, so it can't be the same key. Needs "Maps JavaScript API" and
# "Places API" enabled on that project. Safe to expose client-side once
# referrer-restricted, same reasoning as PUBLIC_TURNSTILE_SITE_KEY above.
PUBLIC_GOOGLE_PLACES_API_KEY=

# Homes-for-rent listings build (claude/listings-build-notes.md). These
# pages are STATIC (generated via getStaticPaths at `astro build` time),
# so their RentEngine credential has to come through Vite's build-time
# env here, not .dev.vars (which only reaches request-time SSR routes).
# Same real key/account as .dev.vars.example's RENTENGINE_RENTAL_ANALYSIS_KEY/
# RENTENGINE_ACCOUNT_ID — one shared RentEngine credential (Michael's call,
# 2026-09-20), just present in two files because of that build-time vs.
# request-time split, not because they're different keys.
RENTENGINE_LISTINGS_KEY=
RENTENGINE_LISTINGS_ACCOUNT_ID=
