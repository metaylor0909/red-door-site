# Copy to .dev.vars (gitignored) for local `astro dev`/`wrangler` testing.
# These are read at REQUEST time inside the Cloudflare Worker via
# `import { env } from 'cloudflare:workers'` — this is a different
# mechanism from the Vite-inlined PUBLIC_* vars in .env (see .env.example).
# In production, set these with `wrangler secret put <NAME>`, not in
# wrangler.toml, and never paste real values into chat.
# See claude/rental-analysis-tool-build.md for what each key is for.

# Cloudflare Turnstile — required per CLAUDE.md's forms decision. If left
# blank, the submit endpoint skips spam verification and logs a warning
# instead of blocking local dev. Do not ship without this set for real.
TURNSTILE_SECRET_KEY=

# Mapbox Geocoding API — reuses the token already held for the listings
# map (decision #8, step 2).
MAPBOX_TOKEN=

# RentEngine's one shared key for every SSR (request-time) use: the
# rental-analysis tool's comps calls AND the hosted report page's small
# homes-for-rent cross-sell section's /units call. REVISED 2026-09-20 —
# decision #7 originally split comps vs. listings into two separate
# RentEngine keys; Michael's call now is one key for everything instead.
# The homes-for-rent build's own STATIC pages (src/pages/homes-for-rent/,
# src/pages/[city]-homes-for-rent.astro) need this same value too, but
# read it via .env's RENTENGINE_LISTINGS_KEY instead (see .env.example) —
# they build via getStaticPaths (Vite/import.meta.env at build time), not
# SSR (cloudflare:workers/.dev.vars at request time), so the one real
# credential has to be copied into both files under each file's own
# naming, not because they're actually two different keys.
RENTENGINE_RENTAL_ANALYSIS_KEY=
# Only needed if the token is scoped to multiple accounts. Not a secret —
# the real value is already confirmed in claude/rental-analysis-tool-
# build.md: 6ecca3ec-8e5a-42ed-87ea-af21f97d546e.
RENTENGINE_ACCOUNT_ID=

# RentCast — decision #10's bedroom-count rent adjustment. Shared with
# the (separate, not-yet-built) homes-for-rent project's own RentCast
# usage, per Michael's call — same key/account, not split like the
# RentEngine keys are.
RENTCAST_API_KEY=

# Resend — sends the owner's headline email and the LeadSimple
# lead-creation email (decision #8 step 12). Scope this key to sending
# access only. Sends through mail.rdpmindy.com (revised 2026-09-20 from
# mail.reddoorrents.com — see the build brief), already verified.
RESEND_API_KEY=

# Decision #6's BD-alert Zap (LeadSimple note + email to Chris Knight) —
# already confirmed live: https://hooks.zapier.com/hooks/catch/18363408/4dtgfdv/
# (see claude/rental-analysis-tool-build.md, decision #8). Not a rotating
# secret, but left blank here anyway rather than pre-filled, so nobody
# fires a real alert to Chris's inbox by accident during local testing.
ZAPIER_BD_ALERT_WEBHOOK_URL=
