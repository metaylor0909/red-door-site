---
// The real rental-analysis intake form (address -> property details ->
// contact info -> submit), extracted 2026-09-24 from
// src/pages/rental-analysis/index.astro so the SAME form can be embedded
// directly in the homepage's and every property-management page's
// "What Could Your [City] Rental Earn?" section, instead of that section
// just linking out to /rental-analysis. Those sections previously
// rendered copy + a button only — see index.astro (homepage),
// indianapolis-property-management.astro, and
// [city]-property-management.astro's own headers for that history: the
// pre-real-tool placeholder mockup form was dropped there rather than
// duplicated three-plus times, but the real tool existed by then, so
// "duplicated" was never actually necessary — extracting it into one
// component (used on 21 pages: homepage, indianapolis-property-
// management, and all 19 [city]-property-management pages, plus the
// standalone /rental-analysis page itself) resolves that without
// maintaining the form in more than one place.
//
// Every page that renders this must have exactly one instance of it —
// the form-navigation script below finds its form via
// `document.querySelector('[data-analysis-form]')`, a single-match
// query, same as before extraction.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
// Address autocomplete — reuses the same Google Cloud Maps Platform
// project as GOOGLE_STREETVIEW_API_KEY (street-view.ts), not a new
// vendor, but a DIFFERENT key: that one is server-side-only and proxied,
// this one runs in the browser as the visitor types and so must be its
// own key, restricted by HTTP referrer to this site's domains — see
// street-view.ts's header comment for why keys here are split by
// exposure surface, not shared. Same graceful-degrade pattern as
// Turnstile/Resend/RentCast elsewhere in this tool: if unset, the script
// tag below never loads and the three address fields stay plain manual
// inputs exactly as before this was added.
const googlePlacesApiKey = import.meta.env.PUBLIC_GOOGLE_PLACES_API_KEY;
---

<form class="form-card" data-analysis-form novalidate>
  <div class="form-card-head">
    <div>
      <h2>Get your personalized rent estimate</h2>
      <p>Answer a few quick questions to get started.</p>
    </div>
    <span class="time-badge">About 2 min</span>
  </div>

  <div class="progress-label">
    <span data-progress-stepname class="progress-stepname">Property address</span>
    <span data-progress-text>Step 1 of 3</span>
  </div>
  <div class="progress-track" aria-hidden="true"><span class="progress-fill" data-progress-fill></span></div>

  <div class="form-step is-active" data-step="0">
    <h3>Where is the rental property?</h3>
    <p class="step-subtext">The address helps us find the most relevant nearby rental comparisons.</p>
    <label class="address-autocomplete-field">Street address
      <input
        name="property_street"
        autocomplete="address-line1"
        placeholder="123 Main Street"
        data-address-autocomplete
        required
      />
    </label>
    <div class="field-grid">
      <label>City
        <input name="property_city_input" autocomplete="address-level2" placeholder="Indianapolis" required />
      </label>
      <label>ZIP code
        <input name="property_zip_input" autocomplete="postal-code" inputmode="numeric" placeholder="46220" required />
      </label>
    </div>
    <label>Property type
      <select name="property_type" required>
        <option value="">Choose a property type</option>
        <option value="single-family">Single-family home</option>
        <option value="townhome">Townhome</option>
        <option value="condo">Condo</option>
        <option value="duplex">Duplex</option>
        <option value="multi-family">Multi-family property</option>
        <option value="other">Other</option>
      </select>
    </label>
  </div>

  <div class="form-step" data-step="1">
    <h3>Tell us a little about the property</h3>
    <p class="step-subtext">A few details help narrow the rental range and make the follow-up more useful.</p>
    <div class="field-grid">
      <label>Bedrooms
        <select name="property_beds" required>
          <option value="">Select</option>
          <option value="0">Studio</option>
          <option value="1">1</option>
          <option value="2">2</option>
          <option value="3">3</option>
          <option value="4">4</option>
          <option value="5">5+</option>
        </select>
      </label>
      <label>Bathrooms
        <select name="property_baths" required>
          <option value="">Select</option>
          <option value="1">1</option>
          <option value="1.5">1.5</option>
          <option value="2">2</option>
          <option value="2.5">2.5</option>
          <option value="3">3</option>
          <option value="3.5">3.5+</option>
        </select>
      </label>
    </div>
    <label>Square footage
      <input name="property_sqft" type="number" min="1" inputmode="numeric" placeholder="1500" required />
    </label>
    <label>Current property status
      <select name="property_status" required>
        <option value="">Choose the closest option</option>
        <option value="vacant">Vacant and ready to rent</option>
        <option value="owner-occupied">Owner occupied</option>
        <option value="tenant-occupied">Tenant occupied</option>
        <option value="being-purchased">Being purchased</option>
        <option value="needs-repairs">Needs repairs or renovation</option>
      </select>
    </label>
    <label>When would you like help?
      <select name="desired_timeline" required>
        <option value="">Select a timeline</option>
        <option value="asap">As soon as possible</option>
        <option value="within-30-days">Within 30 days</option>
        <option value="within-2-3-months">Within 2-3 months</option>
        <option value="just-researching">Just researching for now</option>
      </select>
    </label>
    <label>Current or expected monthly rent <span class="consent">Optional</span>
      <input name="current_rent" type="number" min="1" inputmode="numeric" placeholder="1750" />
    </label>
  </div>

  <div class="form-step" data-step="2">
    <h3>Where should we send your analysis?</h3>
    <p class="step-subtext">A local rental specialist can also follow up if there are details that affect the estimate.</p>
    <div class="field-grid">
      <label>First name
        <input name="owner_first_name" autocomplete="given-name" required />
      </label>
      <label>Last name
        <input name="owner_last_name" autocomplete="family-name" required />
      </label>
    </div>
    <label>Email address
      <input type="email" name="owner_email" autocomplete="email" placeholder="you@example.com" required />
    </label>
    <label>Phone number
      <input type="tel" name="owner_phone" autocomplete="tel" placeholder="(317) 555-0123" required />
    </label>
    <label>Preferred way to connect
      <select name="preferred_contact_method" required>
        <option value="">Choose one</option>
        <option value="phone">Phone</option>
        <option value="email">Email</option>
        <option value="text">Text</option>
      </select>
    </label>
    <label class="checkbox-label">
      <input type="checkbox" name="contact_consent" required />
      I agree that Red Door Property Management may contact me by phone, email, or text about this property and my rental analysis. Message and data rates may apply.
    </label>
    {
      turnstileSiteKey && (
        <div class="cf-turnstile" data-sitekey={turnstileSiteKey} />
      )
    }
  </div>

  <p class="error-text" aria-live="polite" data-form-error></p>
  <div class="form-actions">
    <button class="btn btn-secondary" type="button" data-form-prev>Back</button>
    <button class="btn btn-primary" type="button" data-form-next>Continue</button>
  </div>
</form>

{turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />}

{
  googlePlacesApiKey && (
    <script
      is:inline
      src={`https://maps.googleapis.com/maps/api/js?key=${googlePlacesApiKey}&libraries=places&callback=initAddressAutocomplete&loading=async`}
      async
      defer
    />
  )
}

{
  googlePlacesApiKey && (
    <script is:inline>
      // Registered before the Google script tag can possibly finish
      // loading, so the callback is always defined by the time it's
      // needed — see this component's header comment on why this key is
      // separate from street-view.ts's server-side one.
      //
      // Built against the headless "Places API (New)" JS library
      // (AutocompleteSuggestion.fetchAutocompleteSuggestions), not the
      // google.maps.places.Autocomplete widget or the newer
      // PlaceAutocompleteElement web component — found live 2026-09-24
      // that only "Places API (New)" is enabled on this Google Cloud
      // project (console: "You're calling a legacy API, which is not
      // enabled for your project"), and the widget-based options both
      // render their own opaque UI that's hard to visually match to
      // this form's existing custom-styled inputs. This keeps the real
      // <input name="property_street"> exactly as it was — same
      // FormData binding, same native `required` validation — and just
      // adds a custom-styled suggestion dropdown under it.
      //
      // Runs once per page. A page with more than one instance of this
      // component would need this guarded to run per-form (not the case
      // anywhere it's used today — see header comment).
      window.initAddressAutocomplete = async function () {
        if (!window.google?.maps?.importLibrary) return;
        const streetInput = document.querySelector('[data-address-autocomplete]');
        const cityInput = document.querySelector('[name="property_city_input"]');
        const zipInput = document.querySelector('[name="property_zip_input"]');
        const field = streetInput?.closest('.address-autocomplete-field');
        if (!streetInput || !field) return;

        const places = await window.google.maps.importLibrary('places');
        const { AutocompleteSessionToken, AutocompleteSuggestion } = places;

        const list = document.createElement('div');
        list.className = 'address-autocomplete-list';
        field.appendChild(list);

        let sessionToken = new AutocompleteSessionToken();
        let debounceTimer;
        let requestId = 0;
        let suppressNextInput = false;

        function hideList() {
          list.innerHTML = '';
          list.style.display = 'none';
        }

        async function selectSuggestion(suggestion) {
          const place = suggestion.placePrediction.toPlace();
          await place.fetchFields({ fields: ['addressComponents'] });
          const components = place.addressComponents || [];
          // Places API (New) uses longText/shortText, not the legacy
          // API's long_name/short_name.
          const get = (type) => components.find((c) => c.types.includes(type))?.longText || '';

          const streetNumber = get('street_number');
          const route = get('route');
          if (streetNumber || route) streetInput.value = [streetNumber, route].filter(Boolean).join(' ');

          // Falls back through sublocality/township level names — Google
          // doesn't always populate `locality` for unincorporated areas
          // and townships common in the Indianapolis metro.
          const city = get('locality') || get('sublocality') || get('administrative_area_level_3');
          if (city && cityInput) cityInput.value = city;

          const zip = get('postal_code');
          if (zip && zipInput) zipInput.value = zip;

          // Suppress just the next streetInput 'input' handling below —
          // this dispatch is only to clear the shared aria-invalid/
          // error-text listener in the outer form script, not to
          // re-trigger a fresh suggestion search against the value we
          // just set programmatically.
          suppressNextInput = true;
          [streetInput, cityInput, zipInput].forEach((el) => el && el.dispatchEvent(new Event('input', { bubbles: true })));
          hideList();
          // A fresh session starts after a completed selection — groups
          // the keystrokes leading up to one selection into a single
          // billed session rather than one per keystroke, per Google's
          // own session-token guidance.
          sessionToken = new AutocompleteSessionToken();
        }

        streetInput.addEventListener('input', () => {
          if (suppressNextInput) {
            suppressNextInput = false;
            return;
          }
          clearTimeout(debounceTimer);
          const query = streetInput.value.trim();
          if (query.length < 5) {
            hideList();
            return;
          }
          const thisRequestId = ++requestId;
          debounceTimer = setTimeout(async () => {
            let suggestions;
            try {
              ({ suggestions } = await AutocompleteSuggestion.fetchAutocompleteSuggestions({
                input: query,
                includedRegionCodes: ['us'],
                sessionToken,
              }));
            } catch (err) {
              console.error('[rental-analysis] Address autocomplete request failed:', err);
              return;
            }
            // A slower earlier request resolving after a newer one would
            // otherwise clobber the list with stale results.
            if (thisRequestId !== requestId) return;
            if (!suggestions || suggestions.length === 0) {
              hideList();
              return;
            }
            list.innerHTML = '';
            suggestions.slice(0, 5).forEach((suggestion) => {
              const item = document.createElement('button');
              item.type = 'button';
              item.className = 'address-autocomplete-item';
              item.textContent = suggestion.placePrediction.text.text;
              item.addEventListener('click', () => selectSuggestion(suggestion));
              list.appendChild(item);
            });
            list.style.display = 'block';
          }, 250);
        });

        document.addEventListener('click', (event) => {
          if (!field.contains(event.target)) hideList();
        });
      };
    </script>
  )
}

<script>
  (function () {
    const form = document.querySelector<HTMLFormElement>('[data-analysis-form]');
    if (!form) return;

    const STEP_NAMES = ['Property address', 'Property details', 'Your information'];

    const steps = Array.from(form.querySelectorAll<HTMLElement>('.form-step'));
    const previousButton = form.querySelector<HTMLButtonElement>('[data-form-prev]')!;
    const nextButton = form.querySelector<HTMLButtonElement>('[data-form-next]')!;
    const error = form.querySelector<HTMLElement>('[data-form-error]')!;
    const progressStepname = form.querySelector('[data-progress-stepname]')!;
    const progressText = form.querySelector('[data-progress-text]')!;
    const progressFill = form.querySelector<HTMLElement>('[data-progress-fill]')!;
    let current = 0;
    let submitting = false;

    function fieldsForStep(index: number): HTMLElement[] {
      return Array.from(steps[index].querySelectorAll('input, select, textarea'));
    }

    function updateForm() {
      steps.forEach((step, index) => step.classList.toggle('is-active', index === current));
      const percent = Math.round(((current + 1) / steps.length) * 100);
      progressStepname.textContent = STEP_NAMES[current] ?? '';
      progressText.textContent = `Step ${current + 1} of ${steps.length}`;
      progressFill.style.width = `${percent}%`;
      previousButton.style.visibility = current === 0 ? 'hidden' : 'visible';
      nextButton.textContent = current === steps.length - 1 ? 'Get My Rental Analysis' : 'Continue';
    }

    function validateStep(): boolean {
      let valid = true;
      let firstInvalid: HTMLElement | null = null;
      fieldsForStep(current).forEach((field) => {
        const input = field as HTMLInputElement;
        const fieldValid = input.checkValidity ? input.checkValidity() : true;
        field.setAttribute('aria-invalid', String(!fieldValid));
        if (!fieldValid && !firstInvalid) firstInvalid = field;
        valid = valid && fieldValid;
      });
      error.textContent = valid ? '' : 'Please complete the highlighted field before continuing.';
      if (firstInvalid) (firstInvalid as HTMLElement).focus();
      return valid;
    }

    function applyServerFieldErrors(fieldErrors: Record<string, string>) {
      const firstFieldName = Object.keys(fieldErrors)[0];
      const field = firstFieldName ? form!.querySelector(`[name="${firstFieldName}"]`) : null;
      if (field) {
        field.setAttribute('aria-invalid', 'true');
        const stepEl = field.closest<HTMLElement>('.form-step');
        if (stepEl) {
          const stepIndex = steps.indexOf(stepEl);
          if (stepIndex >= 0) {
            current = stepIndex;
            updateForm();
          }
        }
      }
      error.textContent = fieldErrors[firstFieldName] || 'Please fix the highlighted field.';
    }

    async function submitForm() {
      submitting = true;
      nextButton.disabled = true;
      previousButton.disabled = true;
      const previousLabel = nextButton.textContent;
      nextButton.textContent = 'Submitting…';
      error.textContent = '';

      // Opened synchronously, still inside the click handler's user-
      // gesture window, so popup blockers allow it — its destination is
      // filled in once the fetch below resolves. Opening only after the
      // await (a network round trip) would lose that user-gesture
      // standing and get silently blocked in most browsers, especially
      // Safari.
      const reportWindow = window.open('about:blank', '_blank');

      try {
        const formData = new FormData(form!);

        const response = await fetch('/api/rental-analysis/submit', {
          method: 'POST',
          body: formData,
        });
        const data = await response.json().catch(() => ({}));

        if (response.ok && data.reportUrl) {
          // Report opens in its own tab so the owner keeps this page
          // (and the form's state) around; the form's own tab moves to
          // a fixed, trackable thank-you URL — see
          // red-door-website-todo.md's "Rental analysis — thank-you/
          // tracking page" for why a fixed URL matters here (a GTM/GA4
          // URL-destination conversion goal needs one, and a per-
          // submission report URL can't serve as that goal).
          if (reportWindow) {
            reportWindow.location.href = data.reportUrl;
            window.location.href = data.redirectUrl || '/rental-analysis/thank-you';
          } else {
            // Popup blocked despite the synchronous open above (rare,
            // but possible with strict blocker settings) — fall back to
            // sending the owner straight to their report so the
            // submission still delivers value. They also get the report
            // link by email regardless (see submit.ts's Resend step).
            window.location.href = data.reportUrl;
          }
          return;
        }

        reportWindow?.close();

        if (response.status === 422 && data.fieldErrors) {
          applyServerFieldErrors(data.fieldErrors);
        } else {
          error.textContent = data.error || 'Something went wrong. Please try again.';
        }
      } catch {
        reportWindow?.close();
        error.textContent = 'Something went wrong. Please check your connection and try again.';
      } finally {
        submitting = false;
        nextButton.disabled = false;
        previousButton.disabled = false;
        nextButton.textContent = previousLabel;
      }
    }

    previousButton.addEventListener('click', () => {
      current = Math.max(0, current - 1);
      error.textContent = '';
      updateForm();
    });

    nextButton.addEventListener('click', () => {
      if (submitting) return;
      if (!validateStep()) return;
      if (current === steps.length - 1) {
        void submitForm();
        return;
      }
      current += 1;
      updateForm();
    });

    form.querySelectorAll('input, select, textarea').forEach((field) => {
      field.addEventListener('input', () => {
        field.setAttribute('aria-invalid', 'false');
        error.textContent = '';
      });
    });

    updateForm();
  })();
</script>
