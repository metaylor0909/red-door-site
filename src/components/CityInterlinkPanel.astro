---
// Replicable cross-link panel between a city's -property-management,
// -homes-for-rent, and -market-reports pages -- built 2026-09-28 per
// Michael's request, addressing red-door-website-todo.md's "interlinking
// is thin to nonexistent" item (flagged 2026-09-24). Data comes from
// src/lib/interlinking/city-links.ts, which cross-references the
// existing property-management/cities.ts and market-reports/markets.ts
// rather than duplicating either list.
//
// `current` hides whichever link would point back at the page this panel
// is rendered on. `cities` is an array (not a single city) so the same
// component works on a market-reports page whose market covers more than
// one city with real pages -- westside (Avon + Brownsburg) already does.
// Renders nothing if `cities` is empty (e.g. a property-management/
// homes-for-rent page whose city has no market-reports coverage at all).
//
// Each link kind gets one fixed thumbnail, reused across every city --
// generic "what this page type is" previews, not per-city images (a
// replicable module needs a treatment that works unchanged for all 19
// cities, and there's no per-city visual asset for property-management
// or homes-for-rent anyway). Redesigned 2026-09-28 as a compact
// icon-left row (was a tall card with a big 16:9 banner up top) after
// Michael called the banner version too big and the icon tiles too
// plain -- property-management and homes-for-rent are still inline SVG
// icon badges (nothing to source/maintain as an image file) but smaller
// and with more visual depth (radial highlight + ring); market-reports
// uses a real sample-report graphic Michael provided, cropped down to
// just one of its trend-chart panels ("AVG RENT PRICE TREND," a generic
// red line chart with no city name or date on it) rather than the full
// infographic, which had "Indianapolis | August 2026" baked into its
// header and so wasn't safe to reuse as a generic example for every
// other city's market-report link.
import type { CityPageLinks } from '../lib/interlinking/city-links';

interface Props {
  current: 'property-management' | 'homes-for-rent' | 'market-reports';
  cities: CityPageLinks[];
  /** This panel's own background is soft/gray by default (its usual spot
   * is between two plain sections on the property-management/market-
   * reports pages). Pass "white" when the section before or after it is
   * also fixed-soft (e.g. .snapshot on the homes-for-rent page) to keep
   * the sitewide alternating rhythm intact. */
  background?: 'soft' | 'white';
}

const { current, cities, background = 'soft' } = Astro.props;

const heading = cities.length === 1 ? `More About ${cities[0].name}` : 'Explore These Communities';
---

{cities.length > 0 && (
  <section class:list={['city-interlink-panel', background === 'white' && 'is-white']}>
    <div class="container reveal">
      <div class="section-head">
        <div class="section-kicker">Explore More</div>
        <h2>{heading}</h2>
      </div>
      <div class="city-interlink-grid">
        {cities.map((city: CityPageLinks) => (
          <div class="city-interlink-card">
            {cities.length > 1 && <h3>{city.name}</h3>}
            <div class="city-interlink-links">
              {current !== 'property-management' && (
                <a class="city-interlink-link" href={city.propertyManagementHref}>
                  <span class="city-interlink-thumb is-pm" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><rect x="6" y="4" width="12" height="16" rx="2"></rect><path d="M9 4V3a1 1 0 011-1h4a1 1 0 011 1v1"></path><path d="M9 12.5l2 2 4-4.5"></path></svg>
                  </span>
                  <span class="city-interlink-link-body">
                    <span class="city-interlink-link-label">Property Management</span>
                    <span class="city-interlink-link-title">{city.name} Property Management</span>
                  </span>
                  <svg class="city-interlink-link-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
                </a>
              )}
              {current !== 'homes-for-rent' && (
                <a class="city-interlink-link" href={city.homesForRentHref}>
                  <span class="city-interlink-thumb is-hfr" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><circle cx="8.5" cy="15.5" r="3.5"></circle><path d="M11 13l8-8"></path><path d="M16 8l2.5 2.5"></path><path d="M13.5 10.5L16 13"></path></svg>
                  </span>
                  <span class="city-interlink-link-body">
                    <span class="city-interlink-link-label">Available Rentals</span>
                    <span class="city-interlink-link-title">Homes for Rent in {city.name}</span>
                  </span>
                  <svg class="city-interlink-link-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
                </a>
              )}
              {current !== 'market-reports' && city.marketReportHref && (
                <a class="city-interlink-link" href={city.marketReportHref}>
                  <span class="city-interlink-thumb is-mr">
                    <img src="/images/interlinking/market-report-sample.webp" alt="" loading="lazy" />
                  </span>
                  <span class="city-interlink-link-body">
                    <span class="city-interlink-link-label">Market Data</span>
                    <span class="city-interlink-link-title">{city.marketReportLabel} Market Report</span>
                  </span>
                  <svg class="city-interlink-link-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .city-interlink-panel {
    padding: clamp(48px, 7vw, 72px) 0;
    background: var(--soft);
  }
  .city-interlink-panel.is-white {
    background: var(--white);
  }
  .city-interlink-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
  }
  .city-interlink-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  .city-interlink-card h3 {
    font-size: 1.15rem;
  }
  .city-interlink-links {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }
  .city-interlink-link {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 14px 10px 10px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    color: var(--ink);
    text-decoration: none;
    transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
  }
  .city-interlink-link:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-strong);
    border-color: var(--brand-tint);
  }
  .city-interlink-thumb {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
  }
  .city-interlink-thumb img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .city-interlink-thumb svg { position: relative; width: 46%; height: 46%; fill: none; stroke: var(--white); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .city-interlink-thumb.is-pm {
    background:
      radial-gradient(circle at 30% 25%, rgba(255, 255, 255, .35), transparent 55%),
      linear-gradient(135deg, var(--brand) 0%, var(--brand-mid) 100%);
  }
  .city-interlink-thumb.is-hfr {
    background:
      radial-gradient(circle at 30% 25%, rgba(255, 255, 255, .22), transparent 55%),
      linear-gradient(135deg, var(--charcoal) 0%, #45403f 100%);
  }
  .city-interlink-thumb.is-mr {
    background: var(--soft);
  }
  .city-interlink-link-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .city-interlink-link-label {
    color: var(--brand);
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .05em;
    text-transform: uppercase;
  }
  .city-interlink-link-title {
    font-weight: 800;
    font-size: .95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .city-interlink-link-arrow {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    margin-left: auto;
    fill: none;
    stroke: var(--muted);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform .15s ease, stroke .15s ease;
  }
  .city-interlink-link:hover .city-interlink-link-arrow {
    transform: translateX(3px);
    stroke: var(--brand);
  }
  @media (min-width: 640px) {
    .city-interlink-links { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  }
  @media (min-width: 900px) {
    .city-interlink-grid { grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); }
  }
</style>
