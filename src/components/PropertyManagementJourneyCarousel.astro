---
// Ported verbatim from indianapolis-property-management.html's own
// self-contained "rd-cx" 3D carousel widget (its own comments label it
// "BLOCK 1 of 4 — STYLES" through "BLOCK 4 of 4 — BEHAVIOUR", clearly
// authored as one drop-in unit — kept together here as one component for
// the same reason, rather than decomposed into this project's usual
// shared sections). Only used on this one page: it's Indianapolis's own
// replacement for the plain JourneyProcess component the other 18
// property-management pages and the homepage use.
//
// The carousel's own ItemList JSON-LD (Block 3) is kept here too, as its
// own <script> tag alongside the page-level Organization/Service/
// BreadcrumbList JSON-LD in indianapolis-property-management.astro's own
// head slot — both are valid separately, and this keeps the widget fully
// self-contained the way its source comments describe it.
---
<section class="rd-cx" aria-label="Red Door Indianapolis property management lifecycle">

  <div class="rd-cx-head">
    <h2 class="rd-cx-title">Follow the Indianapolis Property Management Journey</h2>
    <p class="rd-cx-lead">See how Red Door&rsquo;s property management process moves your rental from market readiness and marketing through tenant screening, leasing, maintenance, and communication. Select any step below to explore how each stage works together to protect your investment and create a better rental experience.</p>
  </div>

  <div class="rd-cx-stage" id="rd-cx-stage" aria-roledescription="carousel">
    <div class="rd-cx-viewport" id="rd-cx-viewport">

      <a class="rd-cx-card" href="https://www.reddoorrents.com/indianapolis-property-management" title="Indianapolis premium property management services roadmap" aria-label="Indianapolis premium property management services roadmap — Start Here: Your Owner Roadmap">
        <span class="rd-cx-ico"><svg viewBox="0 0 24 24" role="img" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><title>Red Door Indianapolis property management owner roadmap</title><path d="M9 4 4 6v14l5-2 6 2 5-2V4l-5 2-6-2z"/><path d="M9 4v14M15 6v14"/></svg></span>
        <span class="rd-cx-step">Start Here</span>
        <h3 class="rd-cx-name">Your Owner Roadmap</h3>
        <span class="rd-cx-desc">A proven framework combining local expertise and smart technology to maximize owner ROI.</span>
        <span class="rd-cx-go">Start the Journey <span>&rarr;</span></span>
      </a>

      <a class="rd-cx-card" href="https://www.reddoorrents.com/market-readiness-assessment" title="Indianapolis rental market readiness assessment" aria-label="Indianapolis rental market readiness assessment">
        <span class="rd-cx-ghost">1</span>
        <span class="rd-cx-ico"><svg viewBox="0 0 24 24" role="img" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><title>Indianapolis rental market readiness assessment checklist</title><rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4h6v3H9z"/><path d="M8.5 13l2 2 4-4.5"/></svg></span>
        <span class="rd-cx-step">Step 1</span>
        <h3 class="rd-cx-name">Market Readiness Assessment</h3>
        <span class="rd-cx-desc">Data-driven pricing and property evaluations designed to minimize vacancy and attract quality tenants.</span>
        <span class="rd-cx-go">Explore <span>&rarr;</span></span>
      </a>

      <a class="rd-cx-card" href="https://www.reddoorrents.com/marketing-process" title="Indianapolis home rental marketing process" aria-label="Indianapolis home rental marketing process">
        <span class="rd-cx-ghost">2</span>
        <span class="rd-cx-ico"><svg viewBox="0 0 24 24" role="img" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><title>Professional listing photography for Indianapolis rental marketing</title><path d="M3 9h3l2.5-2.5h7L17 9h4v9H3z"/><circle cx="12" cy="13.5" r="3.4"/></svg></span>
        <span class="rd-cx-step">Step 2</span>
        <h3 class="rd-cx-name">Marketing Process</h3>
        <span class="rd-cx-desc">High-impact listing strategies with professional media and broad exposure to capture renter demand.</span>
        <span class="rd-cx-go">Explore <span>&rarr;</span></span>
      </a>

      <a class="rd-cx-card" href="https://www.reddoorrents.com/tenant-screening" title="Indianapolis tenant screening and placement" aria-label="Indianapolis tenant screening and placement">
        <span class="rd-cx-ghost">3</span>
        <span class="rd-cx-ico"><svg viewBox="0 0 24 24" role="img" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><title>Indianapolis tenant screening, background and credit verification</title><path d="M12 3l7 3v5c0 4.6-3 7.7-7 9-4-1.3-7-4.4-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg></span>
        <span class="rd-cx-step">Step 3</span>
        <h3 class="rd-cx-name">Tenant Screening</h3>
        <span class="rd-cx-desc">Rigorous background, credit, and income verification to secure reliable, high-quality residents.</span>
        <span class="rd-cx-go">Explore <span>&rarr;</span></span>
      </a>

      <a class="rd-cx-card" href="https://www.reddoorrents.com/leasing-process" title="Indianapolis leasing process execution" aria-label="Indianapolis leasing process execution">
        <span class="rd-cx-ghost">4</span>
        <span class="rd-cx-ico"><svg viewBox="0 0 24 24" role="img" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><title>Indianapolis lease agreement execution and signing</title><path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4"/><path d="M9.5 16.5c1-1.3 2-1.3 3 0s2 1.3 3 0"/></svg></span>
        <span class="rd-cx-step">Step 4</span>
        <h3 class="rd-cx-name">Leasing Process</h3>
        <span class="rd-cx-desc">Ensure seamless lease execution and compliance, protecting cash flow and optimizing ROI.</span>
        <span class="rd-cx-go">Explore <span>&rarr;</span></span>
      </a>

      <a class="rd-cx-card" href="https://www.reddoorrents.com/maintenance" title="Indianapolis rental maintenance coordination" aria-label="Indianapolis rental maintenance coordination">
        <span class="rd-cx-ghost">5</span>
        <span class="rd-cx-ico"><svg viewBox="0 0 24 24" role="img" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><title>Indianapolis rental property maintenance and repair coordination</title><path d="M14.7 6.3a3.7 3.7 0 0 0-4.9 4.9l-5.1 5.1a1.6 1.6 0 0 0 2.3 2.3l5.1-5.1a3.7 3.7 0 0 0 4.9-4.9l-2.2 2.2-2-2z"/></svg></span>
        <span class="rd-cx-step">Step 5</span>
        <h3 class="rd-cx-name">Maintenance</h3>
        <span class="rd-cx-desc">Coordinated repairs and around-the-clock response for your Indianapolis property and tenants.</span>
        <span class="rd-cx-go">Explore <span>&rarr;</span></span>
      </a>

      <a class="rd-cx-card" href="https://www.reddoorrents.com/communication" title="Indianapolis property management communication" aria-label="Indianapolis property management communication">
        <span class="rd-cx-ghost">6</span>
        <span class="rd-cx-ico"><svg viewBox="0 0 24 24" role="img" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><title>Indianapolis property management owner communication and reporting</title><path d="M4 5h16v10H9l-4 4z"/><path d="M8.5 10h7M8.5 7.5h7"/></svg></span>
        <span class="rd-cx-step">Step 6</span>
        <h3 class="rd-cx-name">Communication</h3>
        <span class="rd-cx-desc">Owner portals, clear statements, and an Indianapolis team that answers the phone.</span>
        <span class="rd-cx-go">Explore <span>&rarr;</span></span>
      </a>

    </div>

  </div>

  <div class="rd-cx-controls">
    <button type="button" class="rd-cx-btn rd-cx-btn--prev is-muted" id="rd-cx-prev-bar" data-rd-dir="-1" title="Previous step" aria-label="Previous step in the Indianapolis property management lifecycle" aria-disabled="true" aria-controls="rd-cx-viewport">
      <svg viewBox="0 0 24 24" role="img" focusable="false" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><title>Previous step</title><path d="M15 6l-6 6 6 6"/></svg>
    </button>
    <button type="button" class="rd-cx-btn rd-cx-btn--next" id="rd-cx-next-bar" data-rd-dir="1" title="Next step" aria-label="Next step in the Indianapolis property management lifecycle" aria-controls="rd-cx-viewport">
      <svg viewBox="0 0 24 24" role="img" focusable="false" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><title>Next step</title><path d="M9 6l6 6-6 6"/></svg>
    </button>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Red Door Indianapolis Property Management Lifecycle',
  description: "The seven stages of Red Door's Indianapolis property management process, from the owner roadmap through market readiness, marketing, tenant screening, leasing, maintenance, and ongoing communication.",
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: 7,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Your Owner Roadmap — Indianapolis premium property management services', url: 'https://www.reddoorrents.com/indianapolis-property-management' },
    { '@type': 'ListItem', position: 2, name: 'Market Readiness Assessment — Indianapolis rental market readiness assessment', url: 'https://www.reddoorrents.com/market-readiness-assessment' },
    { '@type': 'ListItem', position: 3, name: 'Marketing Process — Indianapolis home rental marketing process', url: 'https://www.reddoorrents.com/marketing-process' },
    { '@type': 'ListItem', position: 4, name: 'Tenant Screening — Indianapolis tenant screening and placement', url: 'https://www.reddoorrents.com/tenant-screening' },
    { '@type': 'ListItem', position: 5, name: 'Leasing Process — Indianapolis leasing process execution', url: 'https://www.reddoorrents.com/leasing-process' },
    { '@type': 'ListItem', position: 6, name: 'Maintenance — Indianapolis rental maintenance coordination', url: 'https://www.reddoorrents.com/maintenance' },
    { '@type': 'ListItem', position: 7, name: 'Communication — Indianapolis property management communication', url: 'https://www.reddoorrents.com/communication' },
  ],
})} />

<style>
  .rd-cx {
    --red: var(--brand);
    --red-deep: var(--brand-mid);
    --red-light: var(--brand-light);
    --glow: rgba(140, 12, 3, .28);
    /* Must match the background the component sits on, so the edge fades
       blend invisibly. Change this if the host page is not white. */
    --page-bg: #ffffff;
    --card-1: #ffffff;
    --card-2: #f7f9fc;
    --hair: rgba(18, 22, 30, .08);
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
    padding: 22px 0 21px;
    background: transparent;
    font-family: var(--font);
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
  }
  .rd-cx *, .rd-cx *::before, .rd-cx *::after { box-sizing: border-box; }

  .rd-cx-fullbleed { width: 100vw; max-width: 100vw; margin-left: calc(50% - 50vw); }

  .rd-cx-head { max-width: 720px; margin: 0 auto 18px; padding: 0 22px; text-align: center; }
  .rd-cx-eyebrow {
    margin: 0 0 8px; color: var(--red); font-size: 11.5px; font-weight: 900;
    letter-spacing: .2em; text-transform: uppercase;
  }
  .rd-cx-title {
    margin: 0; color: var(--ink); font-family: var(--font-head);
    font-size: clamp(21px, 2.8vw, 30px); line-height: 1.14; font-weight: 600; letter-spacing: -.015em;
  }
  .rd-cx-title em { color: var(--red); font-style: normal; }
  .rd-cx-lead {
    margin: 10px auto 0; max-width: 640px;
    color: var(--muted); font-size: 14.5px; line-height: 1.55;
  }

  .rd-cx-stage {
    position: relative; height: 288px; margin-top: 5px;
    perspective: 1500px; perspective-origin: 50% 45%; cursor: default;
  }
  /* pointer-events:none is REQUIRED, not cosmetic. Under transform-style:
     preserve-3d the off-centre cards are pushed to negative Z, which puts them
     BEHIND this element's own plane — so the viewport swallowed every click
     aimed at a side card and only the centre card (at Z=0) was reachable.
     Making the viewport non-interactive lets clicks land on the cards, which
     carry their own explicit pointer-events. */
  .rd-cx-viewport { position: absolute; inset: 0; transform-style: preserve-3d; pointer-events: none; }
  .rd-cx-stage::before, .rd-cx-stage::after {
    content: ""; position: absolute; top: 0; bottom: 0; width: 16%; z-index: 50; pointer-events: none;
  }
  .rd-cx-stage::before { left: 0; background: linear-gradient(90deg, var(--page-bg), transparent); }
  .rd-cx-stage::after { right: 0; background: linear-gradient(270deg, var(--page-bg), transparent); }

  .rd-cx-card {
    position: absolute; top: 50%; left: 50%;
    width: 192px; height: 258px; margin: -129px 0 0 -96px;
    display: flex; flex-direction: column; padding: 21px 19px 18px;
    border-radius: 16px;
    background: linear-gradient(158deg, var(--card-1) 0%, var(--card-2) 100%);
    border: 1px solid var(--hair);
    box-shadow: 0 26px 50px -24px rgba(20, 24, 33, .35), 0 2px 6px rgba(20, 24, 33, .05);
    text-decoration: none; color: inherit; overflow: hidden;
    pointer-events: auto;
    will-change: transform;
    transition: box-shadow .4s ease, border-color .4s ease;
  }
  .rd-cx-card::after {
    content: ""; position: absolute; left: 0; right: 0; top: 0; height: 3px;
    background: linear-gradient(90deg, transparent, var(--red), transparent);
    opacity: .55; transition: opacity .4s ease;
  }
  .rd-cx-ghost {
    position: absolute; top: -11px; right: 5px;
    font-size: 90px; font-weight: 800; line-height: 1;
    color: rgba(18, 22, 30, .045); letter-spacing: -.04em; pointer-events: none;
  }
  .rd-cx-ico {
    width: 42px; height: 42px; flex: 0 0 auto; display: grid; place-items: center;
    border-radius: 11px;
    background: linear-gradient(150deg, var(--red), var(--red-deep));
    box-shadow: 0 12px 22px -8px var(--glow);
    color: #fff; margin-bottom: 12px;
  }
  .rd-cx-ico svg { width: 22px; height: 22px; }
  .rd-cx-step { color: var(--red); font-size: 10px; font-weight: 900; letter-spacing: .14em; text-transform: uppercase; margin-bottom: 6px; }
  .rd-cx-name { color: var(--ink); font-family: var(--font-head); font-size: 15px; font-weight: 600; line-height: 1.18; margin: 0 0 8px; }
  .rd-cx-desc { color: var(--muted); font-size: 11.5px; line-height: 1.42; }
  .rd-cx-go { margin-top: auto; color: var(--red); font-size: 10.5px; font-weight: 900; opacity: 1; }
  .rd-cx-go span { color: var(--red); }

  .rd-cx-card.is-center {
    border-color: rgba(216, 26, 34, .4);
    box-shadow: 0 34px 60px -22px rgba(20, 24, 33, .42), 0 0 0 1px rgba(216, 26, 34, .25), 0 0 46px -10px rgba(216, 26, 34, .35);
  }
  .rd-cx-card.is-center::after { opacity: 1; }

  .rd-cx-hint {
    display: flex; align-items: center; justify-content: center; gap: 14px;
    margin-top: 10px; color: var(--muted); font-size: 13px; font-weight: 700; letter-spacing: .03em;
  }
  .rd-cx-hint b { color: var(--ink); font-weight: 900; }
  .rd-cx-hint svg { color: var(--red); }

  .rd-cx.is-static .rd-cx-stage {
    height: auto; perspective: none; cursor: default;
    display: flex; gap: 13px; overflow-x: auto; scroll-snap-type: x mandatory;
    padding: 6px 18px 13px; -webkit-overflow-scrolling: touch; scrollbar-width: none;
  }
  .rd-cx.is-static .rd-cx-stage::-webkit-scrollbar { display: none; }
  .rd-cx.is-static .rd-cx-stage::before, .rd-cx.is-static .rd-cx-stage::after { display: none; }
  .rd-cx.is-static .rd-cx-viewport { position: static; display: contents; }
  .rd-cx.is-static .rd-cx-card {
    position: relative; top: auto; left: auto; margin: 0;
    flex: 0 0 78%; max-width: 224px; transform: none !important;
    opacity: 1 !important; scroll-snap-align: center;
  }
  .rd-cx.is-static .rd-cx-hint { display: none; }

  .rd-cx-controls {
    display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 11px;
  }
  .rd-cx-btn {
    width: 22px; height: 22px; border: 1px solid var(--hair); border-radius: 50%;
    display: grid; place-items: center; cursor: pointer;
    background: var(--card-1); color: var(--muted);
    box-shadow: 0 2px 5px rgba(20, 24, 33, .06);
    transition: opacity .3s ease, transform .18s ease, box-shadow .3s ease, color .3s ease, border-color .3s ease;
    -webkit-appearance: none; appearance: none; padding: 0;
  }
  .rd-cx-btn svg { width: 11px; height: 11px; }
  .rd-cx-btn:hover { color: var(--red); border-color: rgba(216, 26, 34, .35); box-shadow: 0 4px 10px rgba(20, 24, 33, .1); }
  .rd-cx-btn:active { transform: scale(.92); }
  .rd-cx-btn:focus-visible { outline: 2px solid var(--red); outline-offset: 3px; }
  .rd-cx-btn.is-muted { opacity: .3; cursor: not-allowed; pointer-events: none; box-shadow: none; }
  .rd-cx.is-static .rd-cx-controls { display: none; }

  @media (max-width: 640px) {
    .rd-cx { padding: 19px 0 18px; }
    .rd-cx.is-static .rd-cx-stage { gap: 11px; padding: 6px 13px 14px; }
    .rd-cx.is-static .rd-cx-card {
      flex: 0 0 84%; max-width: 288px; height: auto; min-height: 237px;
      padding: 18px 16px 16px;
    }
    .rd-cx-name, .rd-cx-desc { overflow-wrap: break-word; word-break: break-word; }
    .rd-cx-ghost { font-size: 69px; top: -6px; }
    .rd-cx-ico { width: 37px; height: 37px; margin-bottom: 11px; }
    .rd-cx-name { font-size: clamp(13px, 4.4vw, 14.5px); }
    .rd-cx-desc { font-size: clamp(10.5px, 3.6vw, 11.5px); line-height: 1.5; }
  }
  @media (max-width: 380px) {
    .rd-cx.is-static .rd-cx-card { flex: 0 0 88%; padding: 16px 14px 14px; }
    .rd-cx-name { font-size: 13px; }
    .rd-cx-desc { font-size: 10.5px; }
    .rd-cx-ghost { font-size: 59px; }
  }
</style>

<script>
(function () {
  var root = document.querySelector('.rd-cx');
  if (!root) return;
  var stage = root.querySelector('#rd-cx-stage');
  var cards = Array.prototype.slice.call(root.querySelectorAll('.rd-cx-card'));
  var N = cards.length;

  var coarse = window.matchMedia && window.matchMedia('(pointer: coarse)').matches;
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var small = window.matchMedia && window.matchMedia('(max-width: 640px)').matches;
  if (coarse || reduce || small) { root.classList.add('is-static'); return; }

  var GAP = 198, ANGLE = 38, DEPTH = 120;
  var GLIDE_MS = 480;
  var offset = 0;
  var index = 0;
  var from = 0, to = 0, t0 = 0;
  var raf = null;

  function layout() {
    for (var i = 0; i < N; i++) {
      var raw = i - offset;
      var p = ((raw + N / 2) % N + N) % N - N / 2;
      var ap = Math.abs(p);
      var tx = p * GAP;
      var ry = Math.max(-55, Math.min(55, -p * ANGLE));
      var tz = -ap * DEPTH;
      var sc = Math.max(0.62, 1 - ap * 0.12);
      var op = ap <= 1 ? 1 : Math.max(0, 1 - (ap - 1) * 0.62);
      var c = cards[i];
      c.style.transform = 'translate3d(' + tx + 'px,0,' + tz + 'px) rotateY(' + ry + 'deg) scale(' + sc + ')';
      c.style.opacity = op;
      c.style.zIndex = String(Math.round(100 - ap * 10));
      c.style.pointerEvents = op < 0.25 ? 'none' : 'auto';
      c.classList.toggle('is-center', ap < 0.5);
    }
  }

  var prevBtns = Array.prototype.slice.call(root.querySelectorAll('[data-rd-dir="-1"]'));
  var navBtns = Array.prototype.slice.call(root.querySelectorAll('[data-rd-dir]'));

  function atStart() { return index <= 0; }

  function updateArrows() {
    var muted = atStart();
    for (var i = 0; i < prevBtns.length; i++) {
      prevBtns[i].classList.toggle('is-muted', muted);
      prevBtns[i].setAttribute('aria-disabled', muted ? 'true' : 'false');
    }
  }

  function animate(now) {
    var t = (now - t0) / GLIDE_MS;
    if (t >= 1) {
      offset = to;
      if (offset >= N) { offset -= N; index -= N; to -= N; }
      layout(); updateArrows();
      raf = null;
      return;
    }
    var e = 1 - Math.pow(1 - t, 3);
    offset = from + (to - from) * e;
    layout(); updateArrows();
    raf = requestAnimationFrame(animate);
  }

  function startAnim() {
    if (raf) return;
    raf = requestAnimationFrame(animate);
  }

  function goTo(i) {
    index = i;
    if (raf === null && i === offset) { updateArrows(); return; }
    from = offset; to = i; t0 = performance.now();
    startAnim();
  }

  function step(dir) {
    if (dir < 0 && atStart()) return;
    goTo(Math.max(0, index + dir));
  }

  function slotOf(i) {
    var raw = i - offset;
    return ((raw + N / 2) % N + N) % N - N / 2;
  }

  function targetFor(i) {
    return Math.max(0, Math.round(offset + slotOf(i)));
  }

  cards.forEach(function (c, i) {
    c.addEventListener('click', function (e) {
      var settled = raf === null && offset === index;
      if (settled && slotOf(i) === 0) return;
      e.preventDefault();
      goTo(targetFor(i));
    });
    c.addEventListener('focus', function () { goTo(targetFor(i)); });
  });

  navBtns.forEach(function (b) {
    var dir = Number(b.getAttribute('data-rd-dir'));
    b.addEventListener('click', function () { step(dir); });
  });

  layout();
  updateArrows();
})();
</script>
