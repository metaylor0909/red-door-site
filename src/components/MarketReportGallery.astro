---
// "Market Reports Near {City}": shown on a property-management page in
// the spot where MarketReportStrip shows the city's own recent reports,
// for a city with no market report of its own (the 2026-11-10 pilots:
// Danville, Fortville, McCordsville). The Marketing L10 decided not to
// add market reports for new cities, so these pages point owners at the
// nearest markets Red Door already reports on instead of leaving the
// spot empty.
//
// Each featured card's numbers are that market's own RentCast snapshot
// (the same loadMarketReportSnapshot the -market-reports page shows),
// with its pull date. A market with no D1 row shows the link without
// numbers rather than a made-up figure.
import type { GalleryMarket } from '../lib/market-reports/gallery';

interface Props {
  cityName: string;
  /** Nearest markets first; rendered as cards with numbers. */
  featured: GalleryMarket[];
  /** Every other market, rendered as plain links. */
  others: Array<{ slug: string; name: string }>;
}

const { cityName, featured, others } = Astro.props;

function formatCurrency(value: number | null): string {
  return value == null ? '—' : `$${Math.round(value).toLocaleString('en-US')}`;
}
---
{featured.length > 0 && (
  <div class="market-report-gallery reveal">
    <div class="market-report-gallery-head">
      <h3>Market Reports Near {cityName}</h3>
      <p>Red Door doesn't publish a separate {cityName} report. These are the closest markets we report on, with rent trends, inventory, and days on market.</p>
    </div>
    <div class="market-report-gallery-grid">
      {featured.map((m) => (
        <a class="market-report-gallery-card" href={`/${m.slug}-market-reports`}>
          <span class="market-report-gallery-county">{m.county}</span>
          <h4 class="market-report-gallery-title">{m.name} Market Report</h4>
          {m.covers.length > 1 || m.covers[0] !== m.name ? (
            <span class="market-report-gallery-covers">Covers {m.covers.join(', ')}</span>
          ) : null}
          {m.snapshot && (
            <span class="market-report-gallery-stats">
              <span><strong>{formatCurrency(m.snapshot.medianRent)}</strong> median rent</span>
              <span><strong>{m.snapshot.activeListings}</strong> active rentals</span>
            </span>
          )}
          {m.snapshot?.dataAsOf && <span class="market-report-gallery-asof">RentCast data as of {m.snapshot.dataAsOf}</span>}
          <span class="market-report-gallery-cta">Read the {m.name} report &rarr;</span>
        </a>
      ))}
    </div>
    {others.length > 0 && (
      <p class="market-report-gallery-others">
        More market reports:{' '}
        {others.map((m, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> · </span>}
            <a class="area-link" href={`/${m.slug}-market-reports`}>{m.name}</a>
          </>
        ))}
      </p>
    )}
    <div class="journey-cta">
      <a class="btn btn-primary" href="/blog/topic/market-reports">Explore All Market Reports</a>
    </div>
  </div>
)}

<style>
  .market-report-gallery { margin-top: 48px; }
  .market-report-gallery-head { margin-bottom: 22px; }
  .market-report-gallery-head h3 { margin: 0 0 6px; font-size: clamp(1.35rem, 2.4vw, 1.7rem); }
  .market-report-gallery-head p { margin: 0; color: var(--muted); }
  .market-report-gallery-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .market-report-gallery-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: clamp(20px, 2.6vw, 26px);
    color: var(--ink);
    text-decoration: none;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    transition: transform .2s ease, border-color .2s ease;
  }
  .market-report-gallery-card:hover { transform: translateY(-2px); border-color: var(--brand-mid); }
  .market-report-gallery-county {
    color: var(--red);
    font-size: .76rem;
    font-weight: 900;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .market-report-gallery-title { margin: 0; font-size: 1.25rem; }
  .market-report-gallery-covers { color: var(--muted); font-size: .92rem; }
  .market-report-gallery-stats { display: flex; flex-wrap: wrap; gap: 6px 18px; padding: 10px 0 2px; border-top: 1px solid var(--line); font-size: .95rem; }
  .market-report-gallery-stats strong { font-size: 1.15rem; }
  .market-report-gallery-asof { color: var(--muted); font-size: .8rem; }
  .market-report-gallery-cta { margin-top: auto; padding-top: 6px; color: var(--red-dark); font-weight: 700; }
  .market-report-gallery-others { margin: 22px 0 0; color: var(--muted); }
  @media (max-width: 900px) {
    .market-report-gallery-grid { grid-template-columns: 1fr; }
  }
</style>
