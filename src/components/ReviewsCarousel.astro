---
// Google/Yellow Pages/client-testimonial reviews carousel — fully shared,
// byte-identical markup and copy across the homepage and every
// -property-management page (confirmed via diff before extracting). The
// review data and carousel behavior are self-contained here (not in
// chrome.js — that script's own header comment already says this
// carousel is deliberately left out of the shared sitewide script).
---
<section class="google-reviews" aria-labelledby="google-reviews-title">
  <div class="container reviews-shell">
    <div class="section-head center reveal">
      <div class="section-kicker">Trusted by hundreds of property owners and residents.</div>
      <h2 id="google-reviews-title">What People Say About Working With Red Door</h2>
    </div>

    <div class="reviews-toolbar reveal" aria-label="Review sources included">
      <span class="review-source-tab">
        <span class="source-mark" aria-hidden="true">G</span>
        <span>Google</span>
      </span>
      <span class="review-source-tab">
        <span class="source-mark is-yellow-pages" aria-hidden="true">YP</span>
        <span>Yellow Pages</span>
      </span>
      <span class="review-source-tab">
        <span class="source-mark is-client" aria-hidden="true">R</span>
        <span>Client testimonials</span>
      </span>
    </div>

    <div class="reviews-summary reveal" aria-label="Review summary">
      <span class="reviews-score">540+</span>
      <span class="review-stars" aria-label="Positive public reviews and client stories">
        <span></span><span></span><span></span><span></span><span></span>
      </span>
      <span>Public reviews and client stories from multiple places</span>
    </div>

    <div class="reviews-viewport reveal" data-review-viewport aria-label="Customer review carousel" tabindex="0">
      <div class="reviews-grid" data-review-grid></div>
    </div>

    <div class="reviews-nav reveal" aria-label="Review controls">
      <button class="review-nav-button" type="button" data-review-prev aria-label="Show previous reviews">&lt;</button>
      <button class="review-nav-button" type="button" data-review-next aria-label="Show more reviews">&gt;</button>
    </div>
    <p class="sr-only" aria-live="polite" data-review-status></p>
  </div>
</section>

<script>
  var reviewGrid = document.querySelector('[data-review-grid]') || document.querySelector('[data-google-review-grid]');
  if (reviewGrid) {
    var reviewViewport = document.querySelector('[data-review-viewport]');
    var reviewArea = reviewGrid.closest('.reviews-shell');
    var reviewStatus = document.querySelector('[data-review-status]');
    var previousReviews = document.querySelector('[data-review-prev]');
    var nextReviews = document.querySelector('[data-review-next]');
    var reviewAutoFrame = null;
    var reviewLastFrame = null;
    var reviewLoopWidth = 0;
    var reviewSpeed = 0.024;
    var reviewsPaused = false;
    var reduceReviewMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    var avatarGradients = [
      'linear-gradient(135deg, #c8102e, #7b1f26)',
      'linear-gradient(135deg, #146c94, #19a7ce)',
      'linear-gradient(135deg, #4d7c0f, #84cc16)',
      'linear-gradient(135deg, #6d28d9, #a78bfa)',
      'linear-gradient(135deg, #b45309, #f59e0b)',
      'linear-gradient(135deg, #0f766e, #2dd4bf)',
    ];
