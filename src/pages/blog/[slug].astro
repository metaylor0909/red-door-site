---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PortableText } from 'astro-portabletext';
import { sanityClient } from 'sanity:client';
import YoutubeEmbed from '../../components/portabletext/YoutubeEmbed.astro';
import TableBlock from '../../components/portabletext/TableBlock.astro';
import ImageBlock from '../../components/portabletext/ImageBlock.astro';
import AccordionSection from '../../components/portabletext/AccordionSection.astro';
import CityInterlinkPanel from '../../components/CityInterlinkPanel.astro';
import { getBlogCityLinks } from '../../lib/interlinking/city-links';
import { ORGANIZATION_ID, ORGANIZATION_JSONLD } from '../../lib/schema/organization';

const portableTextComponents = {
  type: {
    youtubeEmbed: YoutubeEmbed,
    table: TableBlock,
    image: ImageBlock,
    accordionSection: AccordionSection,
  },
};

export async function getStaticPaths() {
  try {
    const posts = await sanityClient.fetch(`*[_type == "post"]{ "slug": slug.current }`);
    return posts.map((post: { slug: string }) => ({ params: { slug: post.slug } }));
  } catch (err) {
    console.warn('[blog] Could not reach Sanity yet — no post pages will build. Set SANITY_PROJECT_ID once the project exists.', err);
    return [];
  }
}

const { slug } = Astro.params;

const post = await sanityClient.fetch(
  `*[_type == "post" && slug.current == $slug][0]{
    title,
    "slug": slug.current,
    publishedAt,
    excerpt,
    "body": body[]{
      ...,
      _type == "image" => { "asset": asset->{ url } }
    },
    "authorName": author->name,
    "mainImageUrl": mainImage.asset->url,
    "mainImageAlt": mainImage.alt,
    summary,
    "categories": categories[]->title,
    "youtubeUrl": body[_type == "youtubeEmbed"][0].url,
    seo
  }`,
  { slug }
);

if (!post) {
  return Astro.redirect('/blog', 404);
}

const BRAND_SUFFIX = ' | Red Door Property Management';
const pageTitle =
  post.seo?.title || ((post.title + BRAND_SUFFIX).length <= 60 ? post.title + BRAND_SUFFIX : post.title);
const pageDescription = post.seo?.description || post.excerpt || '';
const canonicalPath = `/blog/${post.slug}`;
const postUrl = `https://www.reddoorrents.com${canonicalPath}`;

// A private or deleted video can still sit in the post body; oEmbed refuses
// it (401/403/404), so it's never used as the share image or VideoObject.
// maxresdefault (16:9, no letterbox bars) 404s for some videos, so fall back
// to hqdefault. Network failures keep the video with the safe hqdefault.
const youtubeId = post.youtubeUrl?.match(/(?:v=|youtu\.be\/|shorts\/|embed\/)([a-zA-Z0-9_-]{11})/)?.[1];
let video: { id: string; thumbnailUrl: string } | null = null;
if (youtubeId) {
  const hq = `https://img.youtube.com/vi/${youtubeId}/hqdefault.jpg`;
  try {
    const watchUrl = `https://www.youtube.com/watch?v=${youtubeId}`;
    const [oembed, maxres] = await Promise.all([
      fetch(`https://www.youtube.com/oembed?url=${encodeURIComponent(watchUrl)}&format=json`),
      fetch(`https://img.youtube.com/vi/${youtubeId}/maxresdefault.jpg`, { method: 'HEAD' }),
    ]);
    await Promise.all([oembed.body?.cancel(), maxres.body?.cancel()]);
    if ([401, 403, 404].includes(oembed.status)) {
      console.warn(`[blog] ${post.slug}: video ${youtubeId} is not publicly available (oEmbed ${oembed.status}).`);
    } else {
      video = { id: youtubeId, thumbnailUrl: maxres.ok ? `https://img.youtube.com/vi/${youtubeId}/maxresdefault.jpg` : hq };
    }
  } catch {
    video = { id: youtubeId, thumbnailUrl: hq };
  }
}
const shareImage: string | undefined = post.mainImageUrl || video?.thumbnailUrl || undefined;

const TOPIC_CATEGORIES = new Set([
  'Market Reports',
  'Landlord Tips',
  'Tenant Resources',
  'Investment Strategy',
  'Property Maintenance',
  'Client Stories',
]);
const categories: string[] = post.categories ?? [];
const topic = categories.find((c) => TOPIC_CATEGORIES.has(c));
const cityTags = categories.filter((c) => !TOPIC_CATEGORIES.has(c));
// Metro-wide roundups carry 10+ city tags; a panel of every city adds noise.
const cityLinks = cityTags.length <= 3 ? getBlogCityLinks(cityTags) : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${postUrl}#article`,
      headline: post.title,
      ...(pageDescription ? { description: pageDescription } : {}),
      ...(post.summary ? { abstract: post.summary } : {}),
      datePublished: post.publishedAt,
      dateModified: post.publishedAt,
      ...(post.authorName ? { author: { '@type': 'Person', name: post.authorName } } : {}),
      publisher: { '@id': ORGANIZATION_ID },
      mainEntityOfPage: postUrl,
      ...(shareImage ? { image: shareImage } : {}),
      ...(topic ? { articleSection: topic } : {}),
      ...(video ? { video: { '@id': `${postUrl}#video` } } : {}),
    },
    ORGANIZATION_JSONLD,
    ...(video
      ? [
          {
            '@type': 'VideoObject',
            '@id': `${postUrl}#video`,
            name: post.title,
            description: pageDescription || post.title,
            thumbnailUrl: video.thumbnailUrl,
            uploadDate: post.publishedAt,
            embedUrl: `https://www.youtube.com/embed/${video.id}`,
          },
        ]
      : []),
  ],
};
---

<BaseLayout title={pageTitle} description={pageDescription} path={canonicalPath} ogImage={shareImage}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <article class="blog-post-page">
    <div class="container">
      {/* .content-block must nest inside its own .container, never combine
          both classes on one element — combining them makes the block
          center within the full page instead of sitting flush-left (see
          claude/listings-build-notes.md's "v6 layout refinement" notes,
          where this exact bug was found and fixed on the listing detail
          page). .content-block had no real CSS definition until that same
          pass gave it one, which is what would have activated this bug
          here too if left combined. */}
      <div class="content-block">
        <p class="listing-breadcrumb"><a href="/blog">Blog</a> &rsaquo; {post.title}</p>
        <h1>{post.title}</h1>
        <p class="blog-post-meta">
          {post.authorName && <span>{post.authorName}</span>}
          <span>{new Date(post.publishedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
        </p>
        {post.mainImageUrl && <img class="blog-post-hero-image" src={post.mainImageUrl} alt={post.mainImageAlt || ''} />}
        {post.summary && (
          <aside class="blog-post-summary" aria-label="Summary">
            <p class="blog-post-summary-label">Summary</p>
            <p>{post.summary}</p>
          </aside>
        )}
        <div class="blog-post-body">
          <PortableText value={post.body} components={portableTextComponents} />
        </div>
      </div>
    </div>
  </article>

  <CityInterlinkPanel cities={cityLinks} />
</BaseLayout>

<style>
  /* padding-top must clear the fixed .site-header -- this page never had
     any (44px, nowhere near enough), so the H1 rendered partly behind the
     header on load, found live 2026-09-28. Reusing the same measured
     values as .listing-breadcrumb-bar (global.css) rather than
     re-deriving them. */
  .blog-post-page { padding: 116px 0 80px; }
  @media (max-width: 980px) {
    .blog-post-page { padding-top: 74px; }
  }
  .blog-post-meta {
    display: flex;
    gap: 16px;
    color: var(--muted);
    font-weight: 800;
    font-size: 0.9rem;
    margin-bottom: 24px;
  }
  .blog-post-hero-image {
    width: 100%;
    border-radius: var(--radius);
    margin-bottom: 32px;
  }
  .blog-post-summary {
    margin: 0 0 32px;
    padding: 18px 22px;
    background: var(--brand-tint);
    border-left: 4px solid var(--brand);
    border-radius: var(--radius);
  }
  .blog-post-summary-label {
    margin: 0 0 6px;
    color: var(--brand);
    font-size: .75rem;
    font-weight: 800;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .blog-post-summary p:last-child { margin: 0; color: var(--ink); font-size: 1.05rem; line-height: 1.6; }
  .blog-post-body :global(h2) { margin-top: 36px; }
  .blog-post-body :global(h3) { margin-top: 28px; }
  .blog-post-body :global(p) { color: var(--charcoal); font-size: 1.05rem; margin-bottom: 18px; }
  .blog-post-body :global(img) { border-radius: var(--radius); margin: 24px 0; }
  .blog-post-body :global(blockquote) {
    margin: 24px 0;
    padding: 16px 20px;
    border-left: 4px solid var(--red);
    background: var(--brand-tint, #fcecea);
    color: var(--charcoal);
  }
</style>
