---
// / — homepage. Ported from the approved static mockup at the repo root
// (index.html, "v6"). Header/footer/mobile-sticky are already componentized
// (SiteHeader/SiteFooter/MobileSticky, rendered by BaseLayout) and chrome.js
// already handles header scroll state, mobile menu, nav dropdowns, and the
// .reveal scroll-in observer — none of that is reimplemented here.
//
// One deliberate departure from a pixel-for-pixel port: index.html's
// #rental-analysis section (old lines ~2675-2786) was a placeholder 6-step
// form mockup that predates the real, already-built rental-analysis tool at
// /rental-analysis (src/pages/rental-analysis/index.astro — a real
// RentEngine/RentCast-backed intake flow with different fields entirely; the
// mockup's own confirmation copy admitted as much: "In a production version,
// this submission should connect to Red Door's existing lead-delivery
// workflow"). Decision: keep that section's kicker/heading/lead/benefit-list
// copy, drop the form, link to /rental-analysis instead. Every other
// same-page `#rental-analysis` anchor on this page (hero CTA, final-cta) is
// updated to `/rental-analysis` too, since the anchor target no longer
// exists here. SiteHeader/MobileSticky/the two homes-for-rent pages were
// already fixed to point at /rental-analysis separately.
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Indianapolis Property Management | Red Door Property Management';
const pageDescription =
  'Experience hands-off Indianapolis property management with local expertise, proactive communication, professional leasing, maintenance, and proven owner protections.';

// Organization + LocalBusiness graph, ported verbatim (business data
// unchanged) from index.html's existing JSON-LD (old lines ~3087-3155) —
// this directly fills the "homepage has no JSON-LD at all" gap noted in
// CLAUDE.md's Known Issues. The source block's third graph node was a
// BreadcrumbList for "https://www.reddoorrents.com/homepage-mock" /
// "Homepage Mockup" — clearly a mockup-file artifact, not real site data (a
// single-entry breadcrumb pointing at a page named "Homepage Mockup" makes
// no sense for the real homepage) — so it's left out here rather than
// carried into production verbatim. Flagged in the port report.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://www.reddoorrents.com/#organization',
      name: 'Red Door Property Management',
      url: 'https://www.reddoorrents.com/',
      telephone: '+1-317-660-1626',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '3815 River Crossing Pkwy, Suite 100',
        addressLocality: 'Indianapolis',
        addressRegion: 'IN',
        postalCode: '46240',
        addressCountry: 'US',
      },
      sameAs: [
        'https://www.youtube.com/@reddoorrents',
        'https://www.facebook.com/RedDoorPropertyManagement/',
        'https://www.linkedin.com/company/red-door-property-management/',
        'https://www.instagram.com/reddoorrents/',
        'https://www.tiktok.com/@reddoorrents',
      ],
    },
    {
      '@type': 'LocalBusiness',
      '@id': 'https://www.reddoorrents.com/#localbusiness',
      name: 'Red Door Property Management',
      url: 'https://www.reddoorrents.com/',
      telephone: '+1-317-660-1626',
      parentOrganization: {
        '@id': 'https://www.reddoorrents.com/#organization',
      },
      areaServed: [
        'Indianapolis',
        'Carmel',
        'Fishers',
        'Noblesville',
        'Westfield',
        'Zionsville',
        'Greenwood',
        'Avon',
        'Brownsburg',
      ],
    },
  ],
};
---

<BaseLayout title={pageTitle} description={pageDescription} path="/">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <section class="hero" aria-labelledby="page-title">
    <div class="hero-content">
      <h1 id="page-title">
        <span>Discover the Freedom of Truly</span>
        <span>Hands-Off Property Management</span>
      </h1>
      <div class="cta-row">
        <a class="btn btn-primary" href="/rental-analysis" data-track="hero-rental-analysis">Get a Free Rental Analysis</a>
        <a class="btn btn-secondary" href="https://calendly.com/cknight-19/phone-call" target="_blank" rel="noopener" data-track="hero-schedule-call">Schedule a Call</a>
      </div>
    </div>
    <a class="scroll-cue" href="#trust-proof" aria-label="Scroll to proof points">
      <span aria-hidden="true"></span>
      Scroll
    </a>
  </section>

  <section class="proof-strip" id="trust-proof" aria-label="Trust and proof points">
    <div class="container">
      <div class="proof-panel reveal">
        <div class="proof-item">
          <strong>450+</strong>
          <span>Happy Customer Reviews</span>
        </div>
        <div class="proof-item">
          <strong>50+ Years</strong>
          <span>Combined Local Experience</span>
        </div>
        <div class="proof-item">
          <strong>24/7</strong>
          <span>Phone and Emergency Support</span>
        </div>
        <div class="proof-item proof-trust">
          <span>Trusted by Indianapolis rental owners and investors.</span>
        </div>
      </div>
    </div>
  </section>

  <section class="journey-wrap">
    <div class="container">
      <div class="section-head center reveal">
        <div class="section-kicker">Owner Roadmap</div>
        <h2>Follow the Indianapolis Property Management Journey</h2>
        <p>See how Red Door's property management process moves your rental from market readiness and marketing through tenant screening, leasing, maintenance, and communication. Explore each step to see how the entire system works together to protect your investment and create a more hands-off ownership experience.</p>
      </div>
      <div class="journey-track reveal" aria-label="Red Door property management journey">
        <a class="journey-card" href="/market-readiness-assessment" data-step="01">
          <span class="journey-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="6" y="4" width="12" height="17" rx="2"></rect><path d="M9 4h6v3H9z"></path><path d="M8.5 13l2 2 4-4.5"></path></svg>
          </span>
          <span class="journey-stage">Stage 01</span>
          <h3>Market Readiness</h3>
          <p>A free rental market analysis, an HD video walkthrough, and a readiness report so pricing and condition are settled before the first showing, not after the third.</p>
          <span class="text-link">Learn More</span>
        </a>
        <a class="journey-card" href="/marketing-process" data-step="02">
          <span class="journey-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M3 9h3l2.5-2.5h7L17 9h4v9H3z"></path><circle cx="12" cy="13.5" r="3.4"></circle></svg>
          </span>
          <span class="journey-stage">Stage 02</span>
          <h3>Marketing Process</h3>
          <p>Professional photography, virtual walkthrough video, syndication to more than twenty platforms, and self-guided showing technology that keeps the calendar full.</p>
          <span class="text-link">Learn More</span>
        </a>
        <a class="journey-card" href="/tenant-screening" data-step="03">
          <span class="journey-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 4.6-3 7.7-7 9-4-1.3-7-4.4-7-9V6z"></path><path d="M9 12l2 2 4-4"></path></svg>
          </span>
          <span class="journey-stage">Stage 03</span>
          <h3>Tenant Screening</h3>
          <p>Credit, nationwide criminal and eviction searches, income verified at three times rent, rental history, employment and identity on every adult applicant.</p>
          <span class="text-link">Learn More</span>
        </a>
        <a class="journey-card" href="/leasing-process" data-step="04">
          <span class="journey-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M7 3h7l4 4v14H7z"></path><path d="M14 3v4h4"></path><path d="M9.5 16.5c1-1.3 2-1.3 3 0s2 1.3 3 0"></path></svg>
          </span>
          <span class="journey-stage">Stage 04</span>
          <h3>Leasing Process</h3>
          <p>Documented move-in inspection, a legally robust lease signed digitally, and a renewal conversation that opens 110 days before the lease ends.</p>
          <span class="text-link">Learn More</span>
        </a>
        <a class="journey-card" href="/maintenance" data-step="05">
          <span class="journey-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M14.7 6.3a3.7 3.7 0 0 0-4.9 4.9l-5.1 5.1a1.6 1.6 0 0 0 2.3 2.3l5.1-5.1a3.7 3.7 0 0 0 4.9-4.9l-2.2 2.2-2-2z"></path></svg>
          </span>
          <span class="journey-stage">Stage 05</span>
          <h3>Maintenance</h3>
          <p>Troubleshooting before dispatch, vetted vendors, video documentation, and a 24/7 emergency line with your approval required above the agreed threshold.</p>
          <span class="text-link">Learn More</span>
        </a>
        <a class="journey-card" href="/communication" data-step="06">
          <span class="journey-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M4 5h16v10H9l-4 4z"></path><path d="M8.5 10h7M8.5 7.5h7"></path></svg>
          </span>
          <span class="journey-stage">Stage 06</span>
          <h3>Communication</h3>
          <p>Weekly updates while we market the property, monthly once it is leased, and immediate word on anything needing a decision. You never have to ask what is going on.</p>
          <span class="text-link">Learn More</span>
        </a>
      </div>
      <div class="journey-cta reveal">
        <a class="btn btn-secondary" href="/indianapolis-property-management">Explore Our Complete Process</a>
      </div>
    </div>
  </section>

  <section class="section-soft">
    <div class="container split">
      <div class="image-frame reveal" role="img" aria-label="Well-kept Indianapolis area rental home with a red front door">
        <div class="image-caption">A local team, a documented process, and fewer owner surprises.</div>
      </div>
      <div class="reveal">
        <div class="section-kicker">A Better Management Experience</div>
        <h2>Why Indianapolis Rental Owners Choose Red Door</h2>
        <p class="lead">Great property management is more than collecting rent. It is a connected system of local expertise, documented processes, smart technology, and proactive communication working together to protect your investment.</p>
        <div class="accordion" data-accordion>
          <article class="accordion-item is-open">
            <button class="accordion-trigger" type="button" aria-expanded="true">
              <span>Proactive Communication</span><span aria-hidden="true">+</span>
            </button>
            <div class="accordion-panel"><div><p>We do not wait for owners to ask what is happening. Our team provides clear updates through phone, email, text, video, and the owner portal so you understand what is happening, what decisions are needed, and why.</p></div></div>
          </article>
          <article class="accordion-item">
            <button class="accordion-trigger" type="button" aria-expanded="false">
              <span>Maintenance With an Investor Mindset</span><span aria-hidden="true">+</span>
            </button>
            <div class="accordion-panel"><div><p>Our in-house team and vetted local vendors focus on timely repairs, clear documentation, cost control, preventative recommendations, and protecting the property's long-term value.</p></div></div>
          </article>
          <article class="accordion-item">
            <button class="accordion-trigger" type="button" aria-expanded="false">
              <span>Data-Driven Local Expertise</span><span aria-hidden="true">+</span>
            </button>
            <div class="accordion-panel"><div><p>Our recommendations are informed by Indianapolis rental-market activity, comparable properties, renter feedback, property condition, and seasonal trends - not guesswork.</p></div></div>
          </article>
          <article class="accordion-item">
            <button class="accordion-trigger" type="button" aria-expanded="false">
              <span>Market Readiness Before Marketing</span><span aria-hidden="true">+</span>
            </button>
            <div class="accordion-panel"><div><p>We evaluate the property, document its condition, identify priorities, and help position it correctly before the listing goes live. Better preparation can lead to stronger tenant interest and fewer avoidable problems.</p></div></div>
          </article>
          <article class="accordion-item">
            <button class="accordion-trigger" type="button" aria-expanded="false">
              <span>Technology With a Human Team Behind It</span><span aria-hidden="true">+</span>
            </button>
            <div class="accordion-panel"><div><p>Professional photos, virtual walkthroughs, showing technology, online portals, digital documentation, and real-time maintenance tracking make management more efficient without replacing personal service.</p></div></div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="section-dark guarantee-section">
    <div class="container">
      <div class="section-head center reveal">
        <div class="section-kicker">A Process We Are Willing to Stand Behind</div>
        <h2>Property Management Backed by Real Guarantees</h2>
        <p>Red Door's documented management system is backed by owner protections that make the next step easier to evaluate.</p>
      </div>
      <div class="guarantee-grid reveal">
        <article class="guarantee-card">
          <span>Leasing</span>
          <h3>2-Week Leasing Guarantee</h3>
          <p>Secure a viable tenant within two weeks of marketing or your first month's management fee is waived.</p>
        </article>
        <article class="guarantee-card">
          <span>Tenant Placement</span>
          <h3>6-Month Tenant Guarantee</h3>
          <p>If a tenant placed by Red Door voids the lease within the first six months, your next New Lease Fee is waived.</p>
        </article>
        <article class="guarantee-card">
          <span>Owner Confidence</span>
          <h3>90-Day Money-Back Guarantee</h3>
          <p>If you change your mind during the first 90 days, Red Door will refund the management fees paid.</p>
        </article>
      </div>
      <div class="journey-cta reveal">
        <a class="btn btn-secondary" href="/indianapolis-property-management">Review Guarantee Details</a>
      </div>
    </div>
  </section>

  <section class="google-reviews" aria-labelledby="google-reviews-title">
    <div class="container reviews-shell">
      <div class="section-head center reveal">
        <div class="section-kicker">Trusted by hundreds of property owners and residents.</div>
        <h2 id="google-reviews-title">What People Say About Working With Red Door</h2>
      </div>

      <div class="reviews-toolbar reveal" aria-label="Review sources included">
        <span class="review-source-tab">
          <span class="source-mark" aria-hidden="true">G</span>
          <span>Google</span>
        </span>
        <span class="review-source-tab">
          <span class="source-mark is-yellow-pages" aria-hidden="true">YP</span>
          <span>Yellow Pages</span>
        </span>
        <span class="review-source-tab">
          <span class="source-mark is-client" aria-hidden="true">R</span>
          <span>Client testimonials</span>
        </span>
      </div>

      <div class="reviews-summary reveal" aria-label="Review summary">
        <span class="reviews-score">540+</span>
        <span class="review-stars" aria-label="Positive public reviews and client stories">
          <span></span><span></span><span></span><span></span><span></span>
        </span>
        <span>Public reviews and client stories from multiple places</span>
      </div>

      <div class="reviews-viewport reveal" data-review-viewport aria-label="Customer review carousel" tabindex="0">
        <div class="reviews-grid" data-review-grid></div>
      </div>

      <div class="reviews-nav reveal" aria-label="Review controls">
        <button class="review-nav-button" type="button" data-review-prev aria-label="Show previous reviews">&lt;</button>
        <button class="review-nav-button" type="button" data-review-next aria-label="Show more reviews">&gt;</button>
      </div>
      <p class="sr-only" aria-live="polite" data-review-status></p>
    </div>
  </section>

  {/* Replaces index.html's old placeholder 6-step form (see module comment)
      with a condensed pitch pointing at the real, already-built tool. */}
  <section class="section-soft" id="rental-analysis">
    <div class="container analysis-grid">
      <div class="reveal">
        <div class="section-kicker">Free Rental Analysis</div>
        <h2>What Could Your Indianapolis Rental Earn?</h2>
        <p class="lead">Get a professional rental analysis backed by local market activity, comparable homes, current competition, and Red Door's experience managing rentals across the Indianapolis area.</p>
        <ul class="benefit-list">
          <li><span>1</span>Understand your property's current rental value.</li>
          <li><span>2</span>Identify improvements that may strengthen rent and tenant appeal.</li>
          <li><span>3</span>See whether Red Door's management approach fits your goals.</li>
        </ul>
        <div class="journey-cta reveal">
          <a class="btn btn-primary" href="/rental-analysis">Get Your Free Rental Analysis</a>
        </div>
      </div>
    </div>
  </section>

  <section id="areas-served">
    <div class="container areas-visual">
      <div class="areas-copy reveal">
        <div class="section-kicker">Local Expertise Across Central Indiana</div>
        <h2><span>Indianapolis Property Management</span><span>Where You Need It</span></h2>
        <p class="lead">Red Door manages rental homes across Indianapolis and the surrounding Central Indiana communities where owners need steady leasing, responsive maintenance, and clear local guidance.</p>
        <div class="county-grid" aria-label="Cities served by county">
          <article class="county-card">
            <div>
              <h3>Marion County</h3>
              <p>Indianapolis core, southside neighborhoods, and close-in rental markets.</p>
            </div>
            <ul class="city-list">
              <li><a class="area-link" href="/indianapolis-property-management">Indianapolis</a></li>
              <li><span class="area-text">Southport</span></li>
              <li><span class="area-text">Beech Grove</span></li>
              <li><span class="area-text">Lawrence</span></li>
              <li><span class="area-text">Speedway</span></li>
            </ul>
          </article>
          <article class="county-card">
            <div>
              <h3>Hamilton County</h3>
              <p>Northside suburbs with strong single-family and executive rental demand.</p>
            </div>
            <ul class="city-list">
              <li><a class="area-link" href="/carmel-property-management">Carmel</a></li>
              <li><a class="area-link" href="/fishers-property-management">Fishers</a></li>
              <li><a class="area-link" href="/noblesville-property-management">Noblesville</a></li>
              <li><a class="area-link" href="/westfield-property-management">Westfield</a></li>
            </ul>
          </article>
          <article class="county-card">
            <div>
              <h3>Madison County</h3>
              <p>Northeast communities with commuter access and affordable rental options.</p>
            </div>
            <ul class="city-list">
              <li><span class="area-text">Anderson</span></li>
              <li><span class="area-text">Pendleton</span></li>
              <li><span class="area-text">Lapel</span></li>
              <li><span class="area-text">Ingalls</span></li>
            </ul>
          </article>
          <article class="county-card">
            <div>
              <h3>Hendricks County</h3>
              <p>Westside communities popular with commuters and long-term rental owners.</p>
            </div>
            <ul class="city-list">
              <li><a class="area-link" href="/avon-property-management">Avon</a></li>
              <li><a class="area-link" href="/brownsburg-property-management">Brownsburg</a></li>
              <li><span class="area-text">Danville</span></li>
              <li><span class="area-text">Plainfield</span></li>
            </ul>
          </article>
          <article class="county-card">
            <div>
              <h3>Johnson County</h3>
              <p>South metro rentals with steady demand from commuters and long-term renters.</p>
            </div>
            <ul class="city-list">
              <li><a class="area-link" href="/greenwood-property-management">Greenwood</a></li>
              <li><span class="area-text">Franklin</span></li>
              <li><span class="area-text">Whiteland</span></li>
              <li><span class="area-text">Bargersville</span></li>
            </ul>
          </article>
          <article class="county-card">
            <div>
              <h3>Hancock County</h3>
              <p>Eastside growth areas with newer-home inventory and suburban appeal.</p>
            </div>
            <ul class="city-list">
              <li><span class="area-text">Greenfield</span></li>
              <li><span class="area-text">McCordsville</span></li>
              <li><span class="area-text">New Palestine</span></li>
              <li><span class="area-text">Fortville</span></li>
              <li><span class="area-text">Cumberland</span></li>
            </ul>
          </article>
          <article class="county-card">
            <div>
              <h3>Shelby County</h3>
              <p>Southeast rental markets serving owners near the Indianapolis outer ring.</p>
            </div>
            <ul class="city-list">
              <li><span class="area-text">Shelbyville</span></li>
              <li><span class="area-text">Fairland</span></li>
              <li><span class="area-text">Morristown</span></li>
              <li><span class="area-text">Boggstown</span></li>
            </ul>
          </article>
          <article class="county-card">
            <div>
              <h3>Boone &amp; Morgan Counties</h3>
              <p>Northwest and southwest communities around the Indianapolis rental ring.</p>
            </div>
            <ul class="city-list">
              <li><a class="area-link" href="/zionsville-property-management">Zionsville</a></li>
              <li><span class="area-text">Whitestown</span></li>
