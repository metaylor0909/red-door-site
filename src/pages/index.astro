      var positiveReviews = redDoorReviews.filter(function (review) {
        return review.rating >= 5;
      });

      function createReviewStars(rating) {
        var stars = document.createElement('span');
        stars.className = 'review-stars';
        stars.setAttribute('aria-label', rating + ' out of 5 stars');
        for (var index = 0; index < rating; index += 1) {
          stars.appendChild(document.createElement('span'));
        }
        return stars;
      }

      function sourceShortName(source) {
        if (source === 'Yellow Pages') return 'YP';
        if (source === 'Client Testimonial') return 'R';
        return 'G';
      }

      function avatarBackgroundFor(author) {
        var total = 0;
        for (var index = 0; index < author.length; index += 1) {
          total += author.charCodeAt(index);
        }
        return avatarGradients[total % avatarGradients.length];
      }

      function inferReviewContext(review) {
        var text = review.text.toLowerCase();
        var propertyCount = text.match(/\b(2|3|4|5|two|three|four|five)\s+(rental\s+)?(properties|homes)\b/);
        if (propertyCount) {
          return propertyCount[1].charAt(0).toUpperCase() + propertyCount[1].slice(1) + ' rental property owner';
        }
        if (text.indexOf('new york') !== -1 || text.indexOf('out of state') !== -1 || text.indexOf('sight unseen') !== -1) {
          return 'Out-of-state property owner';
        }
        if (text.indexOf('life at the beach') !== -1) {
          return 'Remote owner peace of mind';
        }
        if (text.indexOf('previous pm') !== -1 || text.indexOf('previous property manager') !== -1) {
          return 'Owner switching property managers';
        }
        if (text.indexOf('third year') !== -1 || text.indexOf('renewed our lease') !== -1) {
          return 'Long-term renter';
        }
        if (text.indexOf('michigan') !== -1 || text.indexOf('job transfer') !== -1) {
          return 'Relocation renter';
        }
        if (text.indexOf('application') !== -1 || text.indexOf('lease signing') !== -1) {
          return 'Fast leasing process';
        }
        if (text.indexOf('maintenance') !== -1 || text.indexOf('repair') !== -1) {
          return 'Maintenance support';
        }
        if (text.indexOf('communication') !== -1 || text.indexOf('question') !== -1) {
          return 'Responsive communication';
        }
        return 'Red Door customer experience';
      }

      function createReviewCard(review, isClone) {
        var card = document.createElement('article');
        card.className = 'review-card';
        if (isClone) {
          card.setAttribute('aria-hidden', 'true');
        }

        var header = document.createElement('div');
        header.className = 'review-card-header';

        var avatar = document.createElement('div');
        avatar.className = 'review-avatar';
        avatar.setAttribute('aria-hidden', 'true');
        avatar.setAttribute('data-source', review.source);
        avatar.setAttribute('data-source-short', review.sourceShort || sourceShortName(review.source));
        avatar.style.setProperty('--avatar-bg', avatarBackgroundFor(review.author));
        if (review.avatarUrl) {
          var avatarImage = document.createElement('img');
          avatarImage.src = review.avatarUrl;
          avatarImage.alt = '';
          avatarImage.loading = 'lazy';
          avatarImage.addEventListener('error', function () {
            avatar.classList.remove('has-image');
            avatar.textContent = review.author.charAt(0);
          });
          avatar.classList.add('has-image');
          avatar.appendChild(avatarImage);
        } else {
          avatar.textContent = review.author.charAt(0);
        }

        var identity = document.createElement('div');
        var name = document.createElement('div');
        name.className = 'review-name';
        name.textContent = review.author;

        var verified = document.createElement('span');
        verified.className = 'review-verified';
        verified.setAttribute('aria-label', 'Verified review');
        name.appendChild(verified);

        var date = document.createElement('div');
        date.className = 'review-date';
        date.textContent = review.source + ' - ' + review.date;

        identity.appendChild(name);
        identity.appendChild(date);
        header.appendChild(avatar);
        header.appendChild(identity);

        var text = document.createElement('p');
        text.className = 'review-text';
        text.textContent = review.text;

        card.appendChild(header);
        card.appendChild(createReviewStars(review.rating));
        card.appendChild(text);

        if (review.text.length > 92) {
          var more = document.createElement('button');
          more.className = 'review-read-more';
          more.type = 'button';
          more.textContent = 'Read more';
          if (isClone) {
            more.tabIndex = -1;
          }
          more.addEventListener('click', function () {
            var expanded = card.classList.toggle('is-expanded');
            more.textContent = expanded ? 'Show less' : 'Read more';
            setReviewsPaused(expanded);
          });
          card.appendChild(more);
        }

        var context = document.createElement('div');
        context.className = 'review-context';
        context.textContent = review.context || inferReviewContext(review);
        card.appendChild(context);

        return card;
      }

      function getReviewLoopWidth() {
        var cards = reviewGrid.querySelectorAll('.review-card');
        if (cards.length > positiveReviews.length) {
          return cards[positiveReviews.length].offsetLeft - cards[0].offsetLeft;
        }
        return Math.round(reviewGrid.scrollWidth / 3);
      }

      function normalizeReviewPosition() {
        if (!reviewLoopWidth) {
          reviewLoopWidth = getReviewLoopWidth();
        }
        if (!reviewLoopWidth) {
          return;
        }
        if (reviewViewport.scrollLeft >= reviewLoopWidth * 2) {
          reviewViewport.scrollLeft -= reviewLoopWidth;
        } else if (reviewViewport.scrollLeft <= 0) {
          reviewViewport.scrollLeft += reviewLoopWidth;
        }
      }

      function renderReviews(announce) {
        reviewGrid.textContent = '';

        if (!positiveReviews.length) {
          var empty = document.createElement('p');
          empty.className = 'lead';
          empty.textContent = 'No customer reviews are available right now.';
          reviewGrid.appendChild(empty);
          if (previousReviews && nextReviews) {
            previousReviews.disabled = true;
            nextReviews.disabled = true;
          }
          return;
        }

        positiveReviews.concat(positiveReviews, positiveReviews).forEach(function (review, index) {
          reviewGrid.appendChild(createReviewCard(review, index >= positiveReviews.length));
        });
        function primeReviewAuto() {
          reviewLoopWidth = getReviewLoopWidth();
          if (reviewViewport && reviewLoopWidth) {
            reviewViewport.scrollLeft = reviewLoopWidth;
          }
          startReviewAuto();
        }
        // A single setTimeout(0) can fire before card layout (and any late
        // web-font swap) settles, so reviewsCanScroll() reads false and
        // autoplay never starts until the user manually advances the
        // carousel. Retry a few times so it self-corrects without input.
        window.setTimeout(primeReviewAuto, 0);
        window.setTimeout(primeReviewAuto, 250);
        window.setTimeout(primeReviewAuto, 800);

        if (announce && reviewStatus) {
          reviewStatus.textContent = 'Showing customer reviews from multiple sources.';
        }
      }

      function reviewsCanScroll() {
        return reviewViewport && reviewViewport.scrollWidth > reviewViewport.clientWidth + 8;
      }

      function moveReviews(direction) {
        if (!reviewsCanScroll()) {
          return;
        }
        normalizeReviewPosition();
        var step = reviewViewport.clientWidth * 0.85;
        reviewViewport.scrollBy({
          left: step * direction,
          behavior: reduceReviewMotion.matches ? 'auto' : 'smooth',
        });
        window.setTimeout(normalizeReviewPosition, 650);
      }

      function stopReviewAuto() {
        if (reviewAutoFrame) {
          window.cancelAnimationFrame(reviewAutoFrame);
          reviewAutoFrame = null;
        }
        reviewLastFrame = null;
      }

      function startReviewAuto() {
        stopReviewAuto();
        if (reviewsPaused || reduceReviewMotion.matches || !reviewsCanScroll()) {
          return;
        }
        reviewAutoFrame = window.requestAnimationFrame(autoMoveReviews);
      }

      function setReviewsPaused(paused) {
        reviewsPaused = paused;
        if (paused) {
          stopReviewAuto();
        } else {
          startReviewAuto();
        }
      }

      function autoMoveReviews(timestamp) {
        if (!reviewLastFrame) {
          reviewLastFrame = timestamp;
        }
        var elapsed = timestamp - reviewLastFrame;
        reviewLastFrame = timestamp;

        if (reviewViewport && !reviewsPaused && !reduceReviewMotion.matches && reviewsCanScroll()) {
          reviewViewport.scrollLeft += elapsed * reviewSpeed;
          normalizeReviewPosition();
        }

        reviewAutoFrame = window.requestAnimationFrame(autoMoveReviews);
      }

      function resumeReviewsIfClear() {
        window.setTimeout(function () {
          var expandedCard = reviewGrid.querySelector('.review-card.is-expanded');
          var focusedCard = reviewGrid.contains(document.activeElement);
          setReviewsPaused(Boolean(expandedCard || focusedCard));
        }, 900);
      }

      if (reviewArea) {
        reviewGrid.addEventListener('focusin', function () {
          setReviewsPaused(true);
        });
        reviewGrid.addEventListener('focusout', resumeReviewsIfClear);
        reviewArea.addEventListener(
          'touchstart',
          function () {
            setReviewsPaused(true);
          },
          { passive: true }
        );
        reviewArea.addEventListener('touchend', resumeReviewsIfClear);
      }

      if (previousReviews && nextReviews && reviewViewport) {
        previousReviews.addEventListener('click', function () {
          setReviewsPaused(true);
          moveReviews(-1);
          window.setTimeout(function () {
            setReviewsPaused(false);
          }, 1100);
        });

        nextReviews.addEventListener('click', function () {
          setReviewsPaused(true);
          moveReviews(1);
          window.setTimeout(function () {
            setReviewsPaused(false);
          }, 1100);
        });
      }

      renderReviews(false);
      window.addEventListener('resize', function () {
        reviewLoopWidth = getReviewLoopWidth();
        if (reviewViewport && reviewLoopWidth) {
          reviewViewport.scrollLeft = reviewLoopWidth;
        }
        startReviewAuto();
      });
      if (reduceReviewMotion.addEventListener) {
        reduceReviewMotion.addEventListener('change', startReviewAuto);
      } else if (reduceReviewMotion.addListener) {
        reduceReviewMotion.addListener(startReviewAuto);
      }
    }
  </script>
