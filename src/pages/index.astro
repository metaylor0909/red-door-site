---
// / — homepage. Ported from the approved static mockup at the repo root
// (index.html, "v6"). Header/footer/mobile-sticky are already componentized
// (SiteHeader/SiteFooter/MobileSticky, rendered by BaseLayout) and chrome.js
// already handles header scroll state, mobile menu, nav dropdowns, and the
// .reveal scroll-in observer — none of that is reimplemented here.
//
// REVISED 2026-09-21: sections shared with the 18 simple -property-
// management pages (ProofStrip, JourneyProcess, WhyChooseAccordion,
// GuaranteeSection, ReviewsCarousel, AreasServedGrid, LandlordLibrary)
// were extracted into src/components/ rather than duplicated per page —
// confirmed via diff against multiple city mockups that these sections'
// markup is byte-identical everywhere they're used, with only a handful
// of clearly-scoped text props actually varying. One deliberate content
// change from this extraction: JourneyProcess's heading is now "The Red
// Door Property Management Process" instead of the original "Follow the
// Indianapolis Property Management Journey" — per claude/avon-property-
// management-pilot-notes.md, which already made this exact fix on the
// pilot page and recommended it land here too, "so all 20 pages share
// literally the same component." Every other extracted section's text is
// passed as an explicit prop matching this page's own already-approved
// copy exactly (see each component's own header comment for why nothing
// is silently derived from a city name).
//
// index.html's #rental-analysis section (old lines ~2675-2786) was a
// placeholder 6-step form mockup that predates the real, already-built
// rental-analysis tool. Kept that section's kicker/heading/lead/benefit-
// list copy; the form itself is the real one, via <RentalAnalysisForm />
// (src/components/RentalAnalysisForm.astro) — this section originally
// (2026-09-21) just linked to /rental-analysis instead of embedding it,
// to avoid duplicating the form's logic across pages, but Michael asked
// 2026-09-24 for the real form to actually render here, so it was
// extracted into a shared component instead of staying link-only. Every
// other same-page #rental-analysis anchor on this page (hero CTA,
// final-cta) still points to the standalone /rental-analysis page.
import BaseLayout from '../layouts/BaseLayout.astro';
import ProofStrip from '../components/ProofStrip.astro';
import JourneyProcess from '../components/JourneyProcess.astro';
import WhyChooseAccordion from '../components/WhyChooseAccordion.astro';
import GuaranteeSection from '../components/GuaranteeSection.astro';
import ReviewsCarousel from '../components/ReviewsCarousel.astro';
import AreasServedGrid from '../components/AreasServedGrid.astro';
import LandlordLibrary from '../components/LandlordLibrary.astro';
import RentalAnalysisForm from '../components/RentalAnalysisForm.astro';

const pageTitle = 'Indianapolis Property Management | Red Door Property Management';
const pageDescription =
  'Experience hands-off Indianapolis property management with local expertise, proactive communication, professional leasing, maintenance, and proven owner protections.';

// Organization + LocalBusiness graph, ported verbatim (business data
// unchanged) from index.html's existing JSON-LD (old lines ~3087-3155) —
// this directly fills the "homepage has no JSON-LD at all" gap noted in
// CLAUDE.md's Known Issues. The source block's third graph node was a
// BreadcrumbList for "https://www.reddoorrents.com/homepage-mock" /
// "Homepage Mockup" — clearly a mockup-file artifact, not real site data (a
// single-entry breadcrumb pointing at a page named "Homepage Mockup" makes
// no sense for the real homepage) — so it's left out here rather than
// carried into production verbatim. Flagged in the port report.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://www.reddoorrents.com/#organization',
      name: 'Red Door Property Management',
      url: 'https://www.reddoorrents.com/',
      telephone: '+1-317-660-1626',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '3815 River Crossing Pkwy, Suite 100',
        addressLocality: 'Indianapolis',
        addressRegion: 'IN',
        postalCode: '46240',
        addressCountry: 'US',
      },
      sameAs: [
        'https://www.youtube.com/@reddoorrents',
        'https://www.facebook.com/RedDoorPropertyManagement/',
        'https://www.linkedin.com/company/red-door-property-management/',
        'https://www.instagram.com/reddoorrents/',
        'https://www.tiktok.com/@reddoorrents',
      ],
    },
    {
      '@type': 'LocalBusiness',
      '@id': 'https://www.reddoorrents.com/#localbusiness',
      name: 'Red Door Property Management',
      url: 'https://www.reddoorrents.com/',
      telephone: '+1-317-660-1626',
      parentOrganization: {
        '@id': 'https://www.reddoorrents.com/#organization',
      },
      areaServed: [
        'Indianapolis',
        'Carmel',
        'Fishers',
        'Noblesville',
        'Westfield',
        'Zionsville',
        'Greenwood',
        'Avon',
        'Brownsburg',
      ],
    },
  ],
};
---

<BaseLayout title={pageTitle} description={pageDescription} path="/">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <section class="hero" aria-labelledby="page-title">
    <div class="hero-content">
      <h1 id="page-title">
        <span>Discover the Freedom of Truly</span>
        <span>Hands-Off Property Management</span>
      </h1>
      <div class="cta-row">
        <a class="btn btn-primary" href="/rental-analysis" data-track="hero-rental-analysis">Get a Free Rental Analysis</a>
        <a class="btn btn-secondary" href="https://calendly.com/cknight-19/phone-call" target="_blank" rel="noopener" data-track="hero-schedule-call">Schedule a Call</a>
      </div>
    </div>
    <a class="scroll-cue" href="#trust-proof" aria-label="Scroll to proof points">
      <span aria-hidden="true"></span>
      Scroll
    </a>
  </section>

  <ProofStrip cityLabel="Indianapolis" />

  <JourneyProcess />

  <WhyChooseAccordion cityName="Indianapolis" areaLabel="Indianapolis" />

  <GuaranteeSection />

  <ReviewsCarousel />

  {/* Replaces index.html's old placeholder 6-step form (see module comment)
      with a condensed pitch pointing at the real, already-built tool. */}
  <section class="section-soft" id="rental-analysis">
    <div class="container analysis-grid">
      <div class="reveal">
        <div class="section-kicker">Free Rental Analysis</div>
        <h2>What Could Your Indianapolis Rental Earn?</h2>
        <p class="lead">Get a professional rental analysis backed by local market activity, comparable homes, current competition, and Red Door's experience managing rentals across the Indianapolis area.</p>
        <ul class="benefit-list">
          <li><span>1</span>Understand your property's current rental value.</li>
          <li><span>2</span>Identify improvements that may strengthen rent and tenant appeal.</li>
          <li><span>3</span>See whether Red Door's management approach fits your goals.</li>
        </ul>
      </div>

      <RentalAnalysisForm />
    </div>
  </section>

  <AreasServedGrid
    headingLine1="Indianapolis Property Management"
    headingLine2="Where You Need It"
    leadText="Red Door manages rental homes across Indianapolis and the surrounding Central Indiana communities where owners need steady leasing, responsive maintenance, and clear local guidance."
  />

  {/* The three linked posts (checked live against Sanity's production
      dataset during this port) already exist there, so all three link
      internally rather than to the old absolute reddoorrents.com URLs. */}
  <LandlordLibrary
    heading="The Indianapolis Landlord Library"
    subheading="Market updates, investment insights, and practical property-management guidance for Indianapolis rental owners."
  />

  <section class="local-section">
    <div class="container split">
      <div class="reveal">
        <h2>Indianapolis Property Management Built on Local Experience</h2>
        <p class="lead">Red Door Property Management helps accidental landlords, out-of-state owners, and growth-minded investors navigate the complete rental lifecycle. Our Indianapolis team combines documented processes, modern technology, and hands-on local market knowledge to help owners avoid costly mistakes and make better decisions for their properties.</p>
        <p class="statement">Smarter Property Management Powered by Process, Data-Driven Decisions, and Local Market Expertise.</p>
        <div class="cta-row" style="justify-content:flex-start">
          <a class="btn btn-primary" href="/about">Meet Our Team</a>
          <a class="btn btn-secondary" href="/indianapolis-property-management">Explore Our Process</a>
        </div>
      </div>
      <div class="image-frame reveal" role="img" aria-label="Red Door placeholder home photo representing local Indianapolis property management">
        <div class="image-caption">Indianapolis knowledge, practical recommendations, and clear owner visibility.</div>
      </div>
    </div>
  </section>

  <section class="section-dark final-cta">
    <div class="container reveal">
      <h2>Ready for a More Hands-Off Rental Experience?</h2>
      <p>Tell us about your Indianapolis rental property and discover how Red Door's proven management process can protect your investment, reduce day-to-day stress, and keep you informed without requiring you to manage every detail yourself.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/rental-analysis">Get a Free Rental Analysis</a>
        <a class="btn btn-secondary" href="https://calendly.com/cknight-19/phone-call" target="_blank" rel="noopener">Schedule a Call</a>
        <a class="btn btn-secondary" href="tel:3176601626">Call 317.660.1626</a>
      </div>
    </div>
  </section>
</BaseLayout>
