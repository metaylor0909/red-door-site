---
// /pricing — 7th of 7 "similar-pattern" pillar pages built this way (the
// 8th, Indianapolis property management, is a different page type, already
// built separately). Ported from pricing.html.
//
// Structurally different from the other 6 pillar pages: no video-section,
// no PropertyManagementJourneyCarousel (confirmed pricing.html contains no
// `rd-cx` markup at all — this page never had the carousel), and no
// LandlordLibrary section either (confirmed absent from the source file).
// Instead it has several genuinely unique sections: a pricing-at-a-glance
// grid, a working interactive self-manage/poor-management cost calculator,
// a full-service fee breakdown linking to the other 6 pillar pages, a
// services-included comparison table, an industry-standard vs. Red Door
// fee-comparison table, a $2,250 flat-fee tenant-placement plan, an inline
// Calendly scheduling embed, and its own FAQ.
//
// Same #rental-analysis -> /rental-analysis fix as every other page built
// this session: the source's old placeholder 6-step form (data-analysis-form)
// is replaced with a condensed pitch + CTA, keeping the kicker/heading/lead/
// benefit-list copy. Every other #rental-analysis anchor on this page (hero
// CTA, glance-grid CTA row, fee-comparison CTA, final-cta) points to
// /rental-analysis directly instead.
//
// FAQ note: the brief describing this task expected 18 questions; the
// source file actually contains 20 (confirmed by counting
// .accordion-item in the #faq section). All 20 are ported verbatim — see
// this file's own commit/report notes rather than trusting the 18 count.
//
// Calendly: the widget.js script tag is placed once, directly above the
// .calendly-section, so it loads before the inline embed div renders.
import BaseLayout from '../layouts/BaseLayout.astro';
import RentalAnalysisForm from '../components/RentalAnalysisForm.astro';

const pageTitle = 'Property Management Pricing | Red Door Property Management';
const pageDescription =
  'Clear, transparent Indianapolis property management pricing — 9% monthly management, no vacancy fee, and every cost disclosed up front.';
---

<BaseLayout title={pageTitle} description={pageDescription} path="/pricing">
  <section class="hero hero-pillar" aria-labelledby="page-title">
    <div class="hero-content">
      <div class="eyebrow">Clear Fees Before the First Call</div>
      <h1 id="page-title"><span>Indianapolis Property Management Pricing</span></h1>
      <p class="hero-copy">Red Door&rsquo;s core pricing is simple to scan, with the full value explained below.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/rental-analysis" data-track="hero-rental-analysis">Get a Free Rental Analysis</a>
        <a class="btn btn-secondary" href="https://calendly.com/cknight-19/phone-call" target="_blank" rel="noopener">Schedule a Call</a>
      </div>
    </div>
    <a class="scroll-cue" href="#pricing-glance" aria-label="Scroll to content">
      <span aria-hidden="true"></span>
      Scroll
    </a>
  </section>

  <section id="pricing-glance">
    <div class="container reveal">
      <div class="section-head center">
        <div class="section-kicker">Pricing at a Glance</div>
        <h2>Red Door Property Management</h2>
      </div>
      <div class="glance-grid">
        <article class="glance-card featured">
          <span>Monthly Management</span>
          <strong>9%</strong>
          <p>of monthly collected rent for full-service management. Investor pricing is 8% for owners with 3 or more doors.</p>
        </article>
        <article class="glance-card">
          <span>New Lease Fee</span>
          <strong>$995</strong>
          <p>flat fee when Red Door places a new tenant.</p>
        </article>
        <article class="glance-card">
          <span>Lease Renewal Fee</span>
          <strong>$350</strong>
          <p>charged when a tenant renewal is completed.</p>
        </article>
        <article class="glance-card">
          <span>Vacancy Management Fee</span>
          <strong>$0</strong>
          <p>No monthly management fee while your property is vacant.</p>
        </article>
      </div>
      <div class="pricing-cta-row">
        <a class="btn btn-primary" href="/rental-analysis">Get a Free Rental Analysis</a>
        <a class="btn btn-secondary" href="https://calendly.com/cknight-19/phone-call" target="_blank" rel="noopener">Schedule a Call</a>
      </div>
    </div>
  </section>

  <section class="section-soft">
    <div class="container reveal">
      <div class="pricing-widget-embed" aria-label="Self-manage versus professional management calculator">
        <div class="rd-calc-widget" data-rd-calc-widget>
          <div class="rd-calc-accent" aria-hidden="true"></div>
          <div class="rd-calc-inner">
            <div class="rd-calc-brand">
              <span class="rd-calc-door" aria-hidden="true"></span>
              <span>Red Door Property Management</span>
            </div>

            <h3>What does self-management or bad management <em>really cost</em> you?</h3>
            <p class="rd-calc-subhead">Estimate the hidden cost of doing it yourself or choosing the wrong property manager. Vacancy, underpricing, turnover, maintenance mistakes, and weak tenant screening can quickly erase any savings from cheaper management.</p>

            <div class="rd-calc-layout">
              <div class="rd-calc-controls">
                <div class="rd-calc-mode">
                  <span>I'm comparing Red Door against:</span>
                  <div class="rd-calc-segments" role="group" aria-label="Comparison type">
                    <button class="is-active" type="button" data-rd-mode="self" aria-pressed="true">Self-Managing</button>
                    <button type="button" data-rd-mode="poor" aria-pressed="false">Poor Management</button>
                  </div>
                </div>

                <div class="rd-calc-field">
                  <div class="rd-calc-field-top">
                    <label for="rd-calc-rent">Monthly rent</label>
                    <output for="rd-calc-rent" id="rd-calc-rent-out">$1,800</output>
                  </div>
                  <input type="range" id="rd-calc-rent" min="1000" max="3500" step="50" value="1800">
                </div>

                <div data-rd-panel="self">
                  <div class="rd-calc-field">
                    <div class="rd-calc-field-top">
                      <label for="rd-calc-hours">Hours you spend managing / month</label>
                      <output for="rd-calc-hours" id="rd-calc-hours-out">8 hrs</output>
                    </div>
                    <input type="range" id="rd-calc-hours" min="0" max="25" step="1" value="8">
                  </div>

                  <div class="rd-calc-field">
                    <div class="rd-calc-field-top">
                      <label for="rd-calc-hourly">What your time is worth / hour</label>
                      <output for="rd-calc-hourly" id="rd-calc-hourly-out">$50</output>
                    </div>
                    <input type="range" id="rd-calc-hourly" min="0" max="200" step="5" value="50">
                  </div>

                  <div class="rd-calc-field">
                    <div class="rd-calc-field-top">
                      <label for="rd-calc-self-vacancy">Extra vacancy days from self-managing</label>
                      <output for="rd-calc-self-vacancy" id="rd-calc-self-vacancy-out">14 days</output>
                    </div>
                    <input type="range" id="rd-calc-self-vacancy" min="0" max="45" step="1" value="14">
                  </div>

                  <label class="rd-calc-switch">
                    <input type="checkbox" id="rd-calc-count-time" checked>
                    <span class="track" aria-hidden="true"></span>
                    Count my time as money?
                  </label>
                </div>

                <div data-rd-panel="poor" hidden>
                  <div class="rd-calc-field">
                    <div class="rd-calc-field-top">
                      <label for="rd-calc-poor-vacancy">Extra vacancy days from slow leasing</label>
                      <output for="rd-calc-poor-vacancy" id="rd-calc-poor-vacancy-out">21 days</output>
                    </div>
                    <input type="range" id="rd-calc-poor-vacancy" min="0" max="60" step="1" value="21">
                    <p class="rd-calc-help">Poor marketing, weak follow-up, or slow leasing can create extra vacant days.</p>
                  </div>

                  <div class="rd-calc-field">
                    <div class="rd-calc-field-top">
                      <label for="rd-calc-underpricing">Monthly rent underpricing</label>
                      <output for="rd-calc-underpricing" id="rd-calc-underpricing-out">$100</output>
                    </div>
                    <input type="range" id="rd-calc-underpricing" min="0" max="300" step="25" value="100">
                    <p class="rd-calc-help">Even $100/month under market rent equals $1,200/year in lost income.</p>
                  </div>

                  <div class="rd-calc-field">
                    <div class="rd-calc-field-top">
                      <label for="rd-calc-turnover">Avoidable turnover risk</label>
                      <output for="rd-calc-turnover" id="rd-calc-turnover-out">35%</output>
                    </div>
                    <input type="range" id="rd-calc-turnover" min="0" max="100" step="5" value="35">
                    <p class="rd-calc-help">Poor communication, weak tenant relations, or poor renewal strategy can increase avoidable turnover.</p>
                  </div>

                  <div class="rd-calc-selector">
                    <span>Maintenance oversight risk</span>
                    <div class="rd-calc-option-group" role="group" aria-label="Maintenance oversight risk">
                      <button type="button" data-rd-risk="maintenance" data-value="250" aria-pressed="false">Conservative</button>
                      <button class="is-active" type="button" data-rd-risk="maintenance" data-value="750" aria-pressed="true">Moderate</button>
                      <button type="button" data-rd-risk="maintenance" data-value="1500" aria-pressed="false">High</button>
                    </div>
                    <p class="rd-calc-help">Poor maintenance coordination can lead to unnecessary dispatches, delayed repairs, bigger issues, or frustrated tenants.</p>
                  </div>

                  <div class="rd-calc-selector">
                    <span>Tenant placement risk</span>
                    <div class="rd-calc-option-group" role="group" aria-label="Tenant placement risk">
                      <button type="button" data-rd-risk="tenant" data-value="0" aria-pressed="false">Low</button>
                      <button class="is-active" type="button" data-rd-risk="tenant" data-value="1000" aria-pressed="true">Moderate</button>
                      <button type="button" data-rd-risk="tenant" data-value="3500" aria-pressed="false">High</button>
                    </div>
                    <p class="rd-calc-help">Weak tenant screening can increase exposure to late rent, damage, early lease breaks, or eviction-related costs.</p>
                  </div>
                </div>
              </div>

              <div class="rd-calc-output">
                <div class="rd-calc-result">
                  <p class="rd-calc-kicker" id="rd-calc-kicker">Professional Management May Net You</p>
                  <p class="rd-calc-big" id="rd-calc-big-number">$3,696</p>
                  <p class="rd-calc-sentence" id="rd-calc-sentence">more per year than self-managing.</p>
                  <p class="rd-calc-sr" id="rd-calc-sr-result" aria-live="polite" role="status">Self-management comparison: $3,696 estimated annual impact.</p>

                  <div class="rd-calc-breakdown" id="rd-calc-breakdown" aria-label="Cost breakdown"><div class="rd-calc-breakdown-row"><span>Owner time cost</span><strong>$4,800</strong></div><div class="rd-calc-breakdown-row"><span>Extra vacancy cost</span><strong>$840</strong></div><div class="rd-calc-breakdown-row"><span>Red Door management cost</span><strong>-$1,944</strong></div><div class="rd-calc-breakdown-row total"><span>Estimated annual impact</span><strong>$3,696</strong></div></div>
                  <p class="rd-calc-why" id="rd-calc-why">Red Door's process-driven management is built to reduce the hidden costs of owner time, vacancy, maintenance coordination, and tenant issues.</p>
                </div>

                <div class="calculator-cta-row">
                  <a class="rd-calc-cta" href="/contact">Get an exact quote for your property</a>
                  <a class="btn btn-secondary cta-call" href="https://calendly.com/cknight-19/phone-call" target="_blank" rel="noopener">Schedule a Call to Review Your Numbers</a>
                </div>

                <p class="rd-calc-footnote">Estimates for illustration only and are not financial advice. Defaults use industry averages and Red Door's published pricing.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-dark guarantee-section">
    <div class="container">
      <div class="section-head center reveal">
        <div class="section-kicker">Owner Confidence</div>
        <h2>Guarantees Built Around Owner Peace of Mind</h2>
        <p>Transparent pricing works best when it is backed by a management process owners can feel confident choosing.</p>
      </div>
      <div class="guarantee-grid reveal">
        <article class="guarantee-card">
          <span>Leasing</span>
          <h3>2-Week Leasing Guarantee</h3>
          <p>We will secure a viable tenant for your property within two weeks of marketing, or we will waive your first monthly management fee.</p>
        </article>
        <article class="guarantee-card">
          <span>Tenant Placement</span>
          <h3>6-Month Tenant Guarantee</h3>
          <p>If a tenant we place breaks their lease within the first six months, Red Door will waive your next new lease fee.</p>
        </article>
        <article class="guarantee-card">
          <span>Owner Confidence</span>
          <h3>90-Day Money-Back Guarantee</h3>
          <p>If you change your mind about working with us within the first 90 days, we will refund management fees paid during that period.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="pricing" class="section-soft">
    <div class="container reveal">
      <div class="section-head">
        <div class="section-kicker">Pricing Overview</div>
        <h2>Full-Service Management Fee</h2>
        <p>The monthly fee gives you access to Red Door's ongoing property management operating system, not just rent collection.</p>
      </div>

      <div class="management-pricing">
        <div class="fee-block">
          <span class="badge">Full-Service Property Management</span>
          <div class="price"><strong>9%</strong><span>of monthly collected rent</span></div>
          <p>Your monthly management fee is not just for collecting rent. It supports the systems, people, communication, maintenance coordination, documentation, and oversight needed to manage your rental property properly.</p>
          <div class="investor-rate">
            <strong>Investor Pricing:</strong> 8% monthly management for owners with 3 or more doors.
          </div>
          <div class="fee-details" aria-label="Full-service property management fees">
            <div><span>No vacancy management fee</span><strong>$0</strong></div>
            <div><span>New Lease Fee</span><strong>$995</strong></div>
            <div><span>Lease Renewal Fee</span><strong>$350</strong></div>
          </div>
        </div>
        <div class="value-summary">
          <h3>What Your Monthly Management Fee Supports</h3>
          <p>Red Door's fee supports a complete management system, from preparing your property for the market to marketing, screening, leasing, maintenance, communication, and long-term protection.</p>
          <div class="management-pillar-grid">
            <a href="/market-readiness-assessment" class="pillar-link-card">
              <div class="pillar-card-content">
                <h3>Market Readiness</h3>
                <ul>
                  <li>Rental pricing guidance, condition review, and readiness recommendations before marketing begins.</li>
                  <li>Helps reduce vacancy risk by making sure the property is positioned correctly from day one.</li>
                </ul>
                <span class="learn-more">Learn more &rarr;</span>
              </div>
            </a>
            <a href="/marketing-process" class="pillar-link-card">
              <div class="pillar-card-content">
                <h3>Marketing Process</h3>
                <ul>
                  <li>Professional photos, virtual walkthrough/video, listing syndication, and self-guided showing access.</li>
                  <li>Built to create stronger exposure, better showing activity, and faster leasing decisions.</li>
                </ul>
                <span class="learn-more">Learn more &rarr;</span>
              </div>
            </a>
            <a href="/tenant-screening" class="pillar-link-card">
              <div class="pillar-card-content">
                <h3>Tenant Screening</h3>
                <ul>
                  <li>Application review, income verification, rental history, criminal, eviction, fraud, and pet screening.</li>
                  <li>Designed to reduce placement risk and protect the property long after move-in.</li>
                </ul>
                <span class="learn-more">Learn more &rarr;</span>
              </div>
            </a>
            <a href="/leasing-process" class="pillar-link-card">
              <div class="pillar-card-content">
                <h3>Leasing Process</h3>
                <ul>
                  <li>Lease preparation, signing coordination, tenant onboarding, and move-in documentation.</li>
                  <li>Helps create a cleaner handoff from approved applicant to resident.</li>
                </ul>
                <span class="learn-more">Learn more &rarr;</span>
              </div>
            </a>
            <a href="/maintenance" class="pillar-link-card">
              <div class="pillar-card-content">
                <h3>Maintenance Coordination</h3>
                <ul>
                  <li>Maintenance request intake, troubleshooting, Property Meld tracking, vendor coordination, and emergency response.</li>
                  <li>Protects the property by keeping maintenance organized, documented, and actioned properly.</li>
                </ul>
                <span class="learn-more">Learn more &rarr;</span>
              </div>
            </a>
            <a href="/communication" class="pillar-link-card">
              <div class="pillar-card-content">
                <h3>Communication</h3>
                <ul>
                  <li>Owner updates, tenant communication, portal access, monthly statements, and documented communication systems.</li>
                  <li>Gives owners better visibility into what is happening with their property.</li>
                </ul>
                <span class="learn-more">Learn more &rarr;</span>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

