            <tr><td>Lease preparation</td><td><span class="included-mark">&#10003;</span></td><td><span class="included-mark">&#10003;</span></td></tr>
            <tr><td>Move-in coordination</td><td><span class="included-mark">&#10003;</span></td><td><span class="included-mark">&#10003;</span></td></tr>
            <tr class="category-row"><td colspan="3">Ongoing Management</td></tr>
            <tr><td>Monthly rent collection</td><td><span class="included-mark">&#10003;</span></td><td><span class="not-included">Not Included</span></td></tr>
            <tr><td>Owner portal access</td><td><span class="included-mark">&#10003;</span></td><td><span class="not-included">Not Included</span></td></tr>
            <tr><td>Monthly owner statements</td><td><span class="included-mark">&#10003;</span></td><td><span class="not-included">Not Included</span></td></tr>
            <tr><td>Tenant communication</td><td><span class="included-mark">&#10003;</span></td><td><span class="not-included">Not Included</span></td></tr>
            <tr><td>Lease enforcement</td><td><span class="included-mark">&#10003;</span></td><td><span class="not-included">Not Included</span></td></tr>
            <tr><td>Maintenance coordination</td><td><span class="included-mark">&#10003;</span></td><td><span class="not-included">Not Included</span></td></tr>
            <tr><td>24-hour emergency maintenance response</td><td><span class="included-mark">&#10003;</span></td><td><span class="not-included">Not Included</span></td></tr>
            <tr><td>Renewal coordination</td><td><span class="included-mark">&#10003;</span></td><td><span class="not-included">Not Included</span></td></tr>
            <tr><td>Annual inspection process</td><td><span class="included-mark">&#10003;</span></td><td><span class="not-included">Not Included</span></td></tr>
            <tr><td>Move-out coordination</td><td><span class="included-mark">&#10003;</span></td><td><span class="not-included">Not Included</span></td></tr>
            <tr><td>Security deposit processing</td><td><span class="included-mark">&#10003;</span></td><td><span class="not-included">Not Included</span></td></tr>
