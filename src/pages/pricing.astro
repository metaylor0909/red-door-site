    <div class="container reveal">
      <div class="section-head center">
        <div class="section-kicker">What's Included</div>
        <h2>What's Included With Red Door Property Management</h2>
        <p>A clear breakdown of the services included with full-service management and tenant placement only.</p>
      </div>

      <div class="comparison-table-wrap" aria-label="Services included comparison">
        <table class="service-comparison">
          <thead>
            <tr>
              <th>Feature / Service</th>
              <th>Full-Service Management</th>
              <th>Tenant Placement Only</th>
            </tr>
          </thead>
          <tbody>
            <tr class="category-row"><td colspan="3">Leasing &amp; Marketing</td></tr>
            <tr><td>Professional rental market analysis</td><td><span class="included-mark">&#10003;</span></td><td><span class="included-mark">&#10003;</span></td></tr>
            <tr><td>Market readiness recommendations</td><td><span class="included-mark">&#10003;</span></td><td><span class="included-mark">&#10003;</span></td></tr>
            <tr><td>Professional marketing photos</td><td><span class="included-mark">&#10003;</span></td><td><span class="included-mark">&#10003;</span></td></tr>
            <tr><td>Virtual walkthrough video</td><td><span class="included-mark">&#10003;</span></td><td><span class="included-mark">&#10003;</span></td></tr>
            <tr><td>Online listing syndication</td><td><span class="included-mark">&#10003;</span></td><td><span class="included-mark">&#10003;</span></td></tr>
