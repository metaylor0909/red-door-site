  </script>

  <script>
    (function () {
      var rdCalc = document.querySelector("[data-rd-calc-widget]");
      if (!rdCalc) { return; }

      var rdCalcConfig = { managementFeePct: 0.09 };
      var rdCalcMode = "self";
      var rdCalcRisk = { maintenance: 750, tenant: 1000 };
      var rdCalcDisplayed = 0;
      var rdCalcAnimation = null;
      var rdCalcAnnounceTimer = null;
      var rdCalcReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var rdCalcUsd = new Intl.NumberFormat("en-US", {
        style: "currency",
        currency: "USD",
        maximumFractionDigits: 0
      });

      function rdCalcById(id) {
        return document.getElementById(id);
      }

      function rdCalcPaint(range) {
        var low = parseFloat(range.min);
        var high = parseFloat(range.max);
        var value = parseFloat(range.value);
        var percent = Math.min(100, Math.max(0, (value - low) / (high - low) * 100));
        range.style.setProperty("--fill", percent + "%");
      }

      function rdCalcAnimateBig(target) {
        var el = rdCalcById("rd-calc-big-number");

        if (rdCalcReducedMotion) {
          rdCalcDisplayed = target;
          el.textContent = rdCalcUsd.format(Math.abs(target));
          return;
        }

        if (rdCalcAnimation) {
          cancelAnimationFrame(rdCalcAnimation);
        }

        var start = rdCalcDisplayed;
        var change = target - start;
        var duration = 500;
        var startTime = performance.now();

        function tick(now) {
          var progress = Math.min(1, (now - startTime) / duration);
          var eased = 1 - Math.pow(1 - progress, 3);
          rdCalcDisplayed = start + change * eased;
          el.textContent = rdCalcUsd.format(Math.abs(Math.round(rdCalcDisplayed)));

          if (progress < 1) {
            rdCalcAnimation = requestAnimationFrame(tick);
          }
        }

        rdCalcAnimation = requestAnimationFrame(tick);
      }

      function rdCalcAnnounce(text) {
        clearTimeout(rdCalcAnnounceTimer);
        rdCalcAnnounceTimer = setTimeout(function () {
          rdCalcById("rd-calc-sr-result").textContent = text;
        }, 600);
      }

      function rdCalcFormatDays(value) {
        return value + (value === 1 ? " day" : " days");
      }

      function rdCalcSetBreakdown(rows) {
        var container = rdCalcById("rd-calc-breakdown");
        container.innerHTML = rows.map(function (row) {
          return '<div class="rd-calc-breakdown-row' + (row.total ? ' total' : '') + '"><span>' + row.label + '</span><strong>' + rdCalcUsd.format(row.value) + '</strong></div>';
        }).join("");
      }

      function rdCalcSetMode(mode) {
        rdCalcMode = mode;

        rdCalc.querySelectorAll("[data-rd-mode]").forEach(function (button) {
          var isActive = button.getAttribute("data-rd-mode") === mode;
          button.classList.toggle("is-active", isActive);
          button.setAttribute("aria-pressed", String(isActive));
        });

        rdCalc.querySelectorAll("[data-rd-panel]").forEach(function (panel) {
          panel.hidden = panel.getAttribute("data-rd-panel") !== mode;
        });

        rdCalcUpdate();
      }

      function rdCalcUpdate() {
        var monthlyRent = parseFloat(rdCalcById("rd-calc-rent").value) || 0;
        var dailyRent = monthlyRent / 30;
        var redDoorAnnualManagementFee = monthlyRent * rdCalcConfig.managementFeePct * 12;
        var estimatedAnnualImpact = 0;
        var displayValue = 0;
        var big = rdCalcById("rd-calc-big-number");

        rdCalcById("rd-calc-rent-out").textContent = rdCalcUsd.format(monthlyRent);

        if (rdCalcMode === "self") {
          var hours = parseFloat(rdCalcById("rd-calc-hours").value) || 0;
          var hourly = parseFloat(rdCalcById("rd-calc-hourly").value) || 0;
          var selfVacancyDays = parseFloat(rdCalcById("rd-calc-self-vacancy").value) || 0;
          var ownerTimeCost = rdCalcById("rd-calc-count-time").checked ? hours * hourly * 12 : 0;
          var selfExtraVacancyCost = dailyRent * selfVacancyDays;

          estimatedAnnualImpact = ownerTimeCost + selfExtraVacancyCost - redDoorAnnualManagementFee;
          displayValue = Math.max(0, estimatedAnnualImpact);

          rdCalcById("rd-calc-hours-out").textContent = hours + (hours === 1 ? " hr" : " hrs");
          rdCalcById("rd-calc-hourly-out").textContent = rdCalcUsd.format(hourly);
          rdCalcById("rd-calc-self-vacancy-out").textContent = rdCalcFormatDays(selfVacancyDays);
          rdCalcById("rd-calc-kicker").textContent = estimatedAnnualImpact > 0 ? "Professional Management May Net You" : "Cost Comparison Is Close";
          rdCalcById("rd-calc-sentence").textContent = estimatedAnnualImpact > 0
            ? "more per year than self-managing."
            : "Self-management may cost less on paper, but risk still matters.";
          rdCalcById("rd-calc-why").textContent = estimatedAnnualImpact > 0
            ? "Red Door's process-driven management is built to reduce the hidden costs of owner time, vacancy, maintenance coordination, and tenant issues."
            : "Self-management may cost less on paper, but the decision still depends on vacancy risk, time, maintenance, tenant quality, and long-term property protection.";

          rdCalcSetBreakdown([
            { label: "Owner time cost", value: ownerTimeCost },
            { label: "Extra vacancy cost", value: selfExtraVacancyCost },
            { label: "Red Door management cost", value: -redDoorAnnualManagementFee },
            { label: "Estimated annual impact", value: displayValue, total: true }
          ]);
        } else {
          var poorVacancyDays = parseFloat(rdCalcById("rd-calc-poor-vacancy").value) || 0;
          var monthlyUnderpricing = parseFloat(rdCalcById("rd-calc-underpricing").value) || 0;
          var turnoverRiskPct = (parseFloat(rdCalcById("rd-calc-turnover").value) || 0) / 100;
          var poorExtraVacancyCost = dailyRent * poorVacancyDays;
          var rentUnderpricingCost = monthlyUnderpricing * 12;
          var turnoverRiskCost = 2500 * turnoverRiskPct;
          var maintenanceRiskCost = rdCalcRisk.maintenance;
          var tenantPlacementRiskCost = rdCalcRisk.tenant;

          estimatedAnnualImpact = poorExtraVacancyCost + rentUnderpricingCost + turnoverRiskCost + maintenanceRiskCost + tenantPlacementRiskCost;
          displayValue = Math.max(0, estimatedAnnualImpact);

          rdCalcById("rd-calc-poor-vacancy-out").textContent = rdCalcFormatDays(poorVacancyDays);
          rdCalcById("rd-calc-underpricing-out").textContent = rdCalcUsd.format(monthlyUnderpricing);
          rdCalcById("rd-calc-turnover-out").textContent = Math.round(turnoverRiskPct * 100) + "%";
          rdCalcById("rd-calc-kicker").textContent = estimatedAnnualImpact > 0 ? "Poor Management May Cost You" : "Cost Comparison Is Close";
          rdCalcById("rd-calc-sentence").textContent = estimatedAnnualImpact > 0
            ? "per year in preventable costs."
            : "The numbers are close on paper, but management quality still matters.";
          rdCalcById("rd-calc-why").textContent = estimatedAnnualImpact > 0
            ? "This estimate shows how vacancy, underpricing, turnover, maintenance issues, and weak tenant placement can create preventable costs beyond the management fee itself."
            : "The numbers are close on paper, but poor management can still create risk through vacancy, underpricing, maintenance mistakes, and tenant placement issues.";

          rdCalcSetBreakdown([
            { label: "Extra vacancy cost", value: poorExtraVacancyCost },
            { label: "Rent underpricing cost", value: rentUnderpricingCost },
            { label: "Avoidable turnover risk", value: turnoverRiskCost },
            { label: "Maintenance oversight risk", value: maintenanceRiskCost },
            { label: "Tenant placement risk", value: tenantPlacementRiskCost },
            { label: "Estimated Cost of Poor Management", value: displayValue, total: true }
          ]);
        }

        big.classList.toggle("negative", estimatedAnnualImpact <= 0);
        rdCalcAnimateBig(displayValue);
        rdCalcAnnounce((rdCalcMode === "self" ? "Self-management comparison: " : "Poor management comparison: ") + rdCalcUsd.format(displayValue) + " estimated annual impact.");
      }

      ["rd-calc-rent", "rd-calc-hours", "rd-calc-hourly", "rd-calc-self-vacancy", "rd-calc-poor-vacancy", "rd-calc-underpricing", "rd-calc-turnover"].forEach(function (id) {
        var range = rdCalcById(id);
        range.addEventListener("input", function () {
          rdCalcPaint(range);
          rdCalcUpdate();
        });
        rdCalcPaint(range);
      });

      rdCalcById("rd-calc-count-time").addEventListener("input", rdCalcUpdate);
      rdCalc.querySelectorAll("[data-rd-mode]").forEach(function (button) {
        button.addEventListener("click", function () {
          rdCalcSetMode(button.getAttribute("data-rd-mode"));
        });
      });
      rdCalc.querySelectorAll("[data-rd-risk]").forEach(function (button) {
        button.addEventListener("click", function () {
          var riskType = button.getAttribute("data-rd-risk");
          rdCalcRisk[riskType] = parseFloat(button.getAttribute("data-value")) || 0;
          rdCalc.querySelectorAll("[data-rd-risk='" + riskType + "']").forEach(function (option) {
            var isActive = option === button;
            option.classList.toggle("is-active", isActive);
            option.setAttribute("aria-pressed", String(isActive));
          });
          rdCalcUpdate();
        });
      });

      rdCalcUpdate();
    })();
  </script>
