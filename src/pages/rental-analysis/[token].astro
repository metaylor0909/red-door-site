---
// GET /rental-analysis/[token] — the hosted report page. See
// claude/rental-analysis-tool-build.md, decision #5's locked layout and
// decision #8's view-tracking/BD-alert spec.
//
// Built so far: address line, estimate card + confidence, one CTA,
// methodology note, market context (supply/demand + time-to-lease —
// decision #5's third panel, average rent by bedroom, now wired — see
// below), comps table (+ map, added 2026-09-22), the homes-for-rent
// cross-sell (a small, narrowly-scoped live RentEngine /units call — NOT
// the bigger listings-page rebuild project, which is separate and not
// started), the "From Red Door" post carousel (real Sanity query), a
// second CTA, and the view-tracking + BD-alert wiring against the
// confirmed-live Zapier webhook. NOT built: the 12-month rent trend chart
// (needs RentCast, decision #10's own data source).
//
// Snapshot, not live, per decision #5 — this renders exactly what
// submit.ts computed and stored; it never re-runs the cascade.
//
// REVISED 2026-09-22 (Michael's design pass, after seeing two real
// generated reports): hero restructured to match the homes-for-rent
// listing detail page's own template (dark breadcrumb bar + a summary
// band with bed/bath/sqft specs) rather than a plain light section;
// added a Street View photo and a subject-location Mapbox map as two of
// three equally-sized boxes alongside the estimate; market context
// rebuilt as three real card panels (adding an average-rent-by-bedroom
// chart, previously not wired since it needs RentCast); added the same
// RentCast city snapshot sections already built for the homes-for-rent
// and property-management pages, reusing their loaders directly rather
// than re-deriving the numbers; added a comps map with hover-sync
// between the table rows and the map pins, matching the pattern already
// built for the Indianapolis homes-for-rent search page.
import { env } from 'cloudflare:workers';
import { sanityClient } from 'sanity:client';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { haversineMiles } from '../../lib/rental-analysis/geo';
import { computeViewTrackingUpdate, fireBdAlertWebhook, type RentalAnalysisRow } from '../../lib/rental-analysis/view-tracking';
import { fetchAvailableUnits, type AvailableUnit } from '../../lib/rental-analysis/listings-client';
import { selectCrossSellUnits } from '../../lib/rental-analysis/cross-sell';
import { citySlug } from '../../lib/listings/rentengine';
import { CITIES } from '../../lib/property-management/cities';
import { loadCityContentMap } from '../../lib/listings/homes-for-rent-content';
import { resolveRentCastSlugs, loadBlendedCityMarketData, loadBlendedMarketSnapshot } from '../../lib/rental-analysis/rentcast-blend';
import type { RentEngineComp } from '../../lib/rental-analysis/types';
import type { ConfidenceResult } from '../../lib/rental-analysis/confidence';
import type { SupplyDemandStats, TimeToLeaseStats } from '../../lib/rental-analysis/market-context';

export const prerender = false;

// Mapbox public token (pk. prefix — publishable, not a secret) — same
// value already embedded client-side on the homes-for-rent search and
// listing-detail pages.
const MAPBOX_TOKEN =
  'pk.eyJ1IjoibWV0YXlsb3IwOTA5IiwiYSI6ImNtdTdmZXJ5MzBpM3cyenB1eXMwNWdwaXkifQ.0sGI21TcAeEe9v_Pa91a9A';

const PROPERTY_TYPE_LABELS: Record<string, string> = {
  'single-family': 'Single Family Residence',
  townhome: 'Townhome',
  condo: 'Condo',
  duplex: 'Duplex',
  'multi-family': 'Multi-Family',
  other: 'Other',
};

// Every city the RentCast pipeline actually covers (workers/rentcast-
// refresh's 20-area list), PLUS Plainfield — which has no
// rentcast_city_cache row of its own, but is reported together with
// Avon/Brownsburg as one "West Side" submarket everywhere else on the
// site (see rentcast-blend.ts's own header comment). Any other address
// outside this list gets both RentCast sections omitted entirely rather
// than a thrown error or a fabricated number, same pattern as the
// market-reports pages' own uncovered-city handling.
const RENTCAST_COVERED_SLUGS = new Set([
  'indianapolis',
  'downtown-indianapolis',
  'plainfield',
  ...CITIES.map((c) => c.slug),
]);

const CALENDLY_URL = 'https://calendly.com/cknight-19/phone-call';

const { token } = Astro.params;

interface DbRow extends RentalAnalysisRow {
  property_address: string;
  property_city: string;
  property_state: string;
  property_zip: string;
  property_lat: number;
  property_lon: number;
  property_beds: number;
  property_baths: number;
  property_sqft: number | null;
  property_type: string;
  snapshot_json: string;
}

interface Snapshot {
  comps: RentEngineComp[];
  estimatedRent: number;
  rangeLow: number;
  rangeHigh: number;
  confidence: ConfidenceResult;
  isMultiUnitPath: boolean;
  supplyDemand: SupplyDemandStats;
  timeToLease: TimeToLeaseStats;
}

const db = env.DB;
const row = await db
  .prepare('SELECT * FROM rental_analyses WHERE token = ?')
  .bind(token)
  .first<DbRow>();

if (!row) {
  return Astro.redirect('/', 404);
}

const snapshot: Snapshot = JSON.parse(row.snapshot_json);
const reportUrl = `https://www.reddoorrents.com/rental-analysis/${token}`;

// View tracking + decision #5's return-visit BD alert.
const update = computeViewTrackingUpdate(row, new Date());
await db
  .prepare(
    'UPDATE rental_analyses SET distinct_visit_count = ?, last_view_at = ?, last_bd_alert_fired_at = ? WHERE token = ?'
  )
  .bind(update.distinctVisitCount, update.lastViewAt, update.lastBdAlertFiredAt, token)
  .run();

if (update.shouldFireAlert) {
  const webhookUrl = (env as unknown as Record<string, unknown>).ZAPIER_BD_ALERT_WEBHOOK_URL;
  if (typeof webhookUrl === 'string' && webhookUrl.length > 0) {
    await fireBdAlertWebhook(webhookUrl, {
      ownerEmail: row.owner_email,
      propertyAddress: row.property_address,
      reportUrl,
      visitCount: update.distinctVisitCount,
    });
  } else {
    console.warn('[rental-analysis/token] ZAPIER_BD_ALERT_WEBHOOK_URL not configured — BD alert skipped.');
  }
}

// "From Red Door" post carousel — real Sanity query, most-recent-4 from
// the Market Reports / Landlord Tips categories (decision #5). Queried
// live on each view, not snapshotted, per decision #8 step 10's
// reasoning (cheap read, freshness is desirable here).
let posts: Array<{ title: string; slug: string; publishedAt: string; categoryTitle: string }> = [];
try {
  posts = await sanityClient.fetch(`
    *[_type == "post" && count((categories[]->title)[@ in ["Market Reports", "Landlord Tips"]]) > 0]
      | order(publishedAt desc)[0...4] {
        title,
        "slug": slug.current,
        publishedAt,
        "categoryTitle": categories[0]->title
      }
  `);
} catch (err) {
  console.warn('[rental-analysis/token] Could not reach Sanity for the post carousel.', err);
}

// Homes-for-rent cross-sell (decision #5) — a small, narrowly-scoped
// live /units call, city-first with a nearby fallback (decision #8 step
// 10: queried fresh on every view, not snapshotted, since freshness is
// desirable and it's a cheap read). Graceful skip if the key isn't
// configured, same pattern as every other optional integration.
//
// Reuses RENTENGINE_RENTAL_ANALYSIS_KEY (Michael's call, 2026-09-20 — one
// RentEngine key for everything rather than a split-per-feature key like
// decision #7 originally set up for comps vs. listings). The homes-for-
// rent build's own static pages (src/pages/homes-for-rent/, src/pages/
// [city]-homes-for-rent.astro) read the same underlying value too, just
// via .env's RENTENGINE_LISTINGS_KEY instead of .dev.vars — they're
// static (built via getStaticPaths, Vite/import.meta.env at build time),
// this page is SSR (cloudflare:workers/.dev.vars at request time), so the
// same credential has to live in both files under their own file's
// naming, not because they're actually different keys.
let crossSellUnits: AvailableUnit[] = [];
const listingsKey = (env as unknown as Record<string, unknown>).RENTENGINE_RENTAL_ANALYSIS_KEY;
if (typeof listingsKey === 'string' && listingsKey.length > 0) {
  const listingsAccountId = (env as unknown as Record<string, unknown>).RENTENGINE_ACCOUNT_ID;
  try {
    const allUnits = await fetchAvailableUnits({
      apiKey: listingsKey,
      accountId: typeof listingsAccountId === 'string' ? listingsAccountId : undefined,
    });
    crossSellUnits = selectCrossSellUnits(allUnits, {
      city: row.property_city,
      latitude: row.property_lat,
      longitude: row.property_lon,
    });
  } catch (err) {
    console.error('[rental-analysis/token] Homes-for-rent cross-sell fetch failed:', err);
  }
} else {
  console.warn('[rental-analysis/token] RENTENGINE_RENTAL_ANALYSIS_KEY not configured — cross-sell section skipped.');
}

const compsWithDistance = snapshot.comps.map((c) => ({
  ...c,
  distance: haversineMiles(row.property_lat, row.property_lon, c.latitude, c.longitude),
}));

// RentCast city sections (homes-for-rent-style snapshot + property-
// management-style rent/sales panels) — omitted entirely for a city
// outside the RentCast pipeline (and outside the West Side cluster)
// rather than throw or fabricate a number. Avon/Brownsburg/Plainfield
// resolve to the West Side pair per Michael's request (2026-09-22) —
// see rentcast-blend.ts's own header comment for why Plainfield alone
// has no direct row to fall back to.
const subjectCitySlug = citySlug(row.property_city);
const isRentCastCovered = RENTCAST_COVERED_SLUGS.has(subjectCitySlug);
const rentCastSlugs = resolveRentCastSlugs(subjectCitySlug);
const isRentCastBlended = rentCastSlugs.length > 1;

const cityMarketData = isRentCastCovered ? await loadBlendedCityMarketData(db, rentCastSlugs, row.property_state) : null;
const citySnapshot = isRentCastCovered ? await loadBlendedMarketSnapshot(db, rentCastSlugs, row.property_state) : null;

// "Plainfield" alone would misrepresent blended West Side data as if it
// were Plainfield's own real numbers — name the actual submarket being
// shown instead, matching how the market-reports westside page frames
// this same blend.
const rentCastDisplayName = isRentCastBlended ? 'West Side (Avon, Brownsburg & Plainfield)' : row.property_city;

// Indianapolis has no entry in homes-for-rent-content.json (it keeps its
// own real search/filter/map page, not one of the 18 simple-template
// cities) — the hand-written per-city prose paragraph is genuinely
// unavailable there, not a bug; the section just omits it.
const cityContentEntry = isRentCastCovered ? loadCityContentMap()[subjectCitySlug] : undefined;

// Same 3-tile pattern as the homes-for-rent pages' own stat tiles
// (src/lib/listings/homes-for-rent-content.ts's buildStatTiles), except
// the third tile swaps "Single-Family Average" for average days on
// market per Michael's request — more useful next to a rent estimate
// than a figure this page already shows a size-adjusted version of.
const reportStatTiles =
  cityMarketData && cityMarketData.statTiles.length > 0
    ? [
        ...cityMarketData.statTiles.slice(0, 2),
        ...(cityMarketData.averageDaysOnMarket != null
          ? [
              {
                label: 'Average Days on Market',
                value: `${Math.round(cityMarketData.averageDaysOnMarket)} days`,
                sub: "This month's RentCast pull",
              },
            ]
          : []),
      ]
    : [];

function formatCurrency(value: number | null): string {
  return value == null ? '—' : `$${Math.round(value).toLocaleString()}`;
}

// Average-rent-by-bedroom chart data for the rebuilt market-context
// panel — reuses the same bedroomLadder RentCast already derives for
// the homes-for-rent pages, just rendered as a small bar chart here
// instead of a fee-list-style table.
const bedroomChartData = (cityMarketData?.bedroomLadder ?? []).filter((b) => b.beds >= 1 && b.beds <= 5);
const bedroomChartMax = Math.max(1, ...bedroomChartData.map((b) => b.avgRent));

const propertyTypeLabel = PROPERTY_TYPE_LABELS[row.property_type] ?? 'Home';

// Supply & Demand card display — status-key for the CSS class, and the
// ratio bar's fill width capped at a sensible visual max (a literal
// ratio of e.g. 4.0 would otherwise blow the bar past the container).
const supplyStatusKey = snapshot.supplyDemand.statusLabel.split(' ')[0].toLowerCase();
const supplyRatioPercent = snapshot.supplyDemand.ratio != null ? Math.min(100, Math.round(snapshot.supplyDemand.ratio * 50)) : 0;

const timeToLeaseBucketMax = Math.max(
  1,
  snapshot.timeToLease.buckets.days0to14,
  snapshot.timeToLease.buckets.days15to30,
  snapshot.timeToLease.buckets.days31to45,
  snapshot.timeToLease.buckets.days46plus
);

const dateFormatter = new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' });
---

<BaseLayout
  title={`Rental Analysis for ${row.property_address} | Red Door Property Management`}
  description="Your free rental market analysis from Red Door Property Management."
  path={`/rental-analysis/${token}`}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://api.mapbox.com/mapbox-gl-js/v3.7.0/mapbox-gl.css" />
  </Fragment>

  {/* Must load, unblocked by async/defer, before the module script below
      that reads `mapboxgl` — see the homes-for-rent listing detail
      page's own header comment on this exact script-load-order bug. */}
  <script src="https://api.mapbox.com/mapbox-gl-js/v3.7.0/mapbox-gl.js" is:inline></script>

  <section class="listing-hero">
    <div class="listing-breadcrumb-bar">
      <div class="listing-breadcrumb-inner">
        <div class="container">
          <p class="listing-breadcrumb">
            <a href="/rental-analysis">Rental Market Analysis</a> &rsaquo; {row.property_address}, {row.property_city}, {row.property_state} {row.property_zip}
          </p>
        </div>
      </div>
    </div>

    <div class={`report-hero-grid${row.property_lat != null && row.property_lon != null ? '' : ' is-photo-missing'}`}>
      {row.property_lat != null && row.property_lon != null && (
        <div class="hero-media-col">
          <img
            class="subject-photo"
            src={`/api/street-view?lat=${row.property_lat}&lng=${row.property_lon}`}
            alt={`Street view of ${row.property_address}`}
            loading="eager"
            onerror="this.remove()"
          />
          <div class="subject-map" id="subject-map" data-lat={row.property_lat} data-lng={row.property_lon}></div>
        </div>
      )}
      <div class="estimate-card reveal">
        <div class="section-kicker">Estimated Monthly Rent</div>
        <div class="estimate-figure">${snapshot.estimatedRent.toLocaleString()}/mo</div>
        <p class="estimate-range">Range: ${snapshot.rangeLow.toLocaleString()} &ndash; ${snapshot.rangeHigh.toLocaleString()}/mo</p>
        <div class={`confidence-badge is-${snapshot.confidence.bucket}`}>
          {snapshot.confidence.displayPercent}% &mdash; {snapshot.confidence.bucketLabel}
        </div>
        <p class="methodology-note">{snapshot.confidence.templateSentence}</p>
        <div class="cta-row" style="margin-top:14px">
          <a class="btn btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener">Talk to Red Door About Managing This Property</a>
        </div>
      </div>
    </div>
  </section>

  <section class="listing-summary-band">
    <div class="container listing-summary-inner">
      <div class="listing-summary-main">
        <h1>{row.property_address}, {row.property_city}, {row.property_state}</h1>
        <p class="listing-location">{row.property_city}, {row.property_state} {row.property_zip}</p>
      </div>
      <div class="listing-summary-stats">
        <div class="listing-specs-row">
          <span><strong>{row.property_beds}</strong> beds</span>
          <span><strong>{row.property_baths}</strong> baths</span>
          {row.property_sqft && <span><strong>{row.property_sqft.toLocaleString()}</strong> sq ft</span>}
          <span>{propertyTypeLabel}</span>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">Market Context</div>
        <h2>What's Happening Nearby</h2>
      </div>
      <p class="section-dek">How this submarket is behaving beyond the {snapshot.comps.length} comps above &mdash; supply relative to demand, and where rents sit by bedroom count.</p>
      <div class="context-card-grid">
        <div class="context-card">
          <p class="context-card-label">Supply &amp; Demand Ratio</p>
          <div class="context-card-figure">
            {snapshot.supplyDemand.ratio != null ? snapshot.supplyDemand.ratio.toFixed(2) : '—'}
            <span class={`context-status-badge is-${supplyStatusKey}`}>{snapshot.supplyDemand.statusLabel}</span>
          </div>
          <div class="context-ratio-bar"><span class="context-ratio-fill" style={`width:${supplyRatioPercent}%`}></span></div>
          <div class="context-ratio-legend">
            <span><i class="context-dot is-available"></i>{snapshot.supplyDemand.availableCount} available</span>
            <span><i class="context-dot is-rented"></i>{snapshot.supplyDemand.rentedCount} rented</span>
          </div>
          <p class="context-card-note">
            {snapshot.supplyDemand.ratio != null
              ? `For every home leased nearby recently, about ${snapshot.supplyDemand.ratio.toFixed(1)} sit available at once — ${snapshot.supplyDemand.statusLabel === 'Healthy market' ? 'a healthy balance that supports steady, on-time leasing.' : snapshot.supplyDemand.statusLabel === 'Soft market' ? 'more supply than this comp set is currently absorbing.' : 'a roughly even balance between supply and demand.'}`
              : 'Not enough recently-leased comps nearby to compute this ratio.'}
          </p>
        </div>

        <div class="context-card">
          <p class="context-card-label">Time to Lease &mdash; This Comp Set</p>
          <div class="context-card-figure">
            {snapshot.timeToLease.medianDaysOnMarket != null ? snapshot.timeToLease.medianDaysOnMarket : '—'}
            <span class="context-card-figure-sub">median days on market</span>
          </div>
          <div class="context-bucket-rows">
            {[
              ['0–14 days', snapshot.timeToLease.buckets.days0to14],
              ['15–30 days', snapshot.timeToLease.buckets.days15to30],
              ['31–45 days', snapshot.timeToLease.buckets.days31to45],
              ['46+ days', snapshot.timeToLease.buckets.days46plus],
            ].map(([label, count]) => (
              <div class="context-bucket-row">
                <span class="context-bucket-label">{label}</span>
                <div class="context-bucket-bar"><span style={`width:${Math.round((Number(count) / timeToLeaseBucketMax) * 100)}%`}></span></div>
                <span class="context-bucket-count">{count}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="context-card">
          <p class="context-card-label">Average Rent by Bedroom Count</p>
          {
            bedroomChartData.length > 0 ? (
              <>
                <div class="context-bar-chart">
                  {bedroomChartData.map((b) => (
                    <div class="context-bar-col">
                      <span class="context-bar-value">${Math.round(b.avgRent).toLocaleString()}</span>
                      <div class={`context-bar${b.beds === row.property_beds ? ' is-subject' : ''}`} style={`height:${Math.max(6, Math.round((b.avgRent / bedroomChartMax) * 100))}%`} />
                      <span class="context-bar-label">{b.beds}bd{b.beds === row.property_beds && ' (subject)'}</span>
                    </div>
                  ))}
                </div>
                <p class="context-card-note">This property's {row.property_beds}-bedroom estimate sits {(() => {
                  const subjectRung = bedroomChartData.find((b) => b.beds === row.property_beds);
                  if (!subjectRung) return 'outside the current bedroom-count data for this submarket.';
                  return snapshot.estimatedRent > subjectRung.avgRent
                    ? 'above the broader ladder for this submarket.'
                    : snapshot.estimatedRent < subjectRung.avgRent
                      ? 'below the broader ladder for this submarket.'
                      : 'right in line with the broader ladder for this submarket.';
                })()}</p>
              </>
            ) : (
              <p class="context-card-note">Not enough RentCast bedroom-count data for {row.property_city} to chart this yet.</p>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section-soft">
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">Comparable Properties</div>
        <h2>{snapshot.comps.length} Properties Used in This Estimate</h2>
      </div>
      <p class="section-dek">
        Based on the median rent of {snapshot.comps.length} comparable {snapshot.comps.length === 1 ? 'property' : 'properties'} near
        this address, leased or currently listed within the past 12 months.
      </p>
      <div style="overflow-x:auto">
        <table class="comps-table">
          <thead>
            <tr>
              <th>Address</th>
              <th>Beds/Baths</th>
              <th>Sqft</th>
              <th>Rent</th>
              <th>Distance</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {compsWithDistance.map((c, i) => (
              <tr data-comp-index={i} class="comps-table-row">
                <td>{c.address}</td>
                <td>{c.beds}bd / {c.baths}ba</td>
                <td>{c.sqft ?? '—'}</td>
                <td>
                  ${c.rent.toLocaleString()}
                  {c.bedroomAdjustedRent != null && (
                    <span class="consent"> (${c.bedroomAdjustedRent.toLocaleString()} adjusted for {row.property_beds}bd)</span>
                  )}
                </td>
                <td>{c.distance.toFixed(1)} mi</td>
                <td>
                  <span class={`status-pill ${c.status === 'rented' ? 'is-rented' : 'is-available'}`}>{c.status === 'rented' ? 'Rented' : 'Available'}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {compsWithDistance.length > 0 && (
        <div class="comps-map" id="comps-map" data-comps={JSON.stringify(compsWithDistance.map((c) => ({ lat: c.latitude, lng: c.longitude, address: c.address, rent: c.rent })))}></div>
      )}
    </div>
  </section>

  {
    isRentCastCovered && reportStatTiles.length > 0 && (
      <section>
        <div class="container">
          <div class="section-head">
            <div class="section-kicker">{rentCastDisplayName} Rental Market</div>
            <h2>What Homes Are Renting for Nearby</h2>
          </div>
          {cityMarketData?.dataAsOf && <p class="data-asof">{cityMarketData.dataAsOf}</p>}
          {isRentCastBlended && (
            <p class="snapshot-note">Blended from Avon and Brownsburg RentCast data (weighted by listing count) — Plainfield isn&rsquo;t yet in Red Door&rsquo;s monthly RentCast pull, so it&rsquo;s not reflected separately in these figures.</p>
          )}
          <div class="snapshot-grid">
            {reportStatTiles.map((tile) => (
              <div class="stat-tile">
                <p class="stat-label">{tile.label}</p>
                <p class="stat-value">{tile.value}</p>
                <p class="stat-sub">{tile.sub}</p>
              </div>
            ))}
          </div>
          {cityContentEntry?.snapshotDetail.map((paragraph) => <p class="snapshot-detail">{paragraph}</p>)}
          {
            cityMarketData && cityMarketData.bedroomLadder.length > 0 && (
              <>
                <p class="snapshot-note">Rent by bedroom count, this month&rsquo;s RentCast pull:</p>
                <div class="bedroom-ladder">
                  {cityMarketData.bedroomLadder.map((b) => (
                    <div class="bedroom-ladder-row">
                      <span class="bedroom-ladder-beds">{b.beds === 0 ? 'Studio' : `${b.beds}-Bedroom`}</span>
                      <span class="bedroom-ladder-rent">${Math.round(b.avgRent).toLocaleString()}/mo</span>
                    </div>
                  ))}
                </div>
              </>
            )
          }
        </div>
      </section>
    )
  }

  {
    isRentCastCovered && citySnapshot && (
      <section class="section-soft">
        <div class="container">
          <div class="section-head">
            <div class="section-kicker">{rentCastDisplayName} Rent &amp; Sales</div>
            <h2>Rental &amp; Sales Data for the {rentCastDisplayName} Market</h2>
          </div>
          {citySnapshot.dataAsOf && <p class="snapshot-asof">{citySnapshot.dataAsOf}</p>}
          {isRentCastBlended && (
            <p class="snapshot-note">Blended from Avon and Brownsburg RentCast data (weighted by listing count) — Plainfield isn&rsquo;t yet in Red Door&rsquo;s monthly RentCast pull, so it&rsquo;s not reflected separately in these figures.</p>
          )}
          <div class="snapshot-panels">
            <div class="snapshot-panel">
              <span class="snapshot-panel-label">Rental Market</span>
              <h3>{rentCastDisplayName} Rentals</h3>
              <div class="snapshot-stat-row"><span class="snapshot-stat-label">Average Rent</span><span class="snapshot-stat-value">{formatCurrency(citySnapshot.rental.averageRent)}</span></div>
              <div class="snapshot-stat-row"><span class="snapshot-stat-label">Median Rent</span><span class="snapshot-stat-value">{formatCurrency(citySnapshot.rental.medianRent)}</span></div>
              <div class="snapshot-stat-row"><span class="snapshot-stat-label">Active Listings</span><span class="snapshot-stat-value">{citySnapshot.rental.activeListings}</span></div>
            </div>
            <div class="snapshot-panel is-sales">
              <span class="snapshot-panel-label">Sales Market</span>
              <h3>{rentCastDisplayName} For-Sale Homes</h3>
              <div class="snapshot-stat-row"><span class="snapshot-stat-label">Average Sale Price</span><span class="snapshot-stat-value">{formatCurrency(citySnapshot.sale.averagePrice)}</span></div>
              <div class="snapshot-stat-row"><span class="snapshot-stat-label">Median Sale Price</span><span class="snapshot-stat-value">{formatCurrency(citySnapshot.sale.medianPrice)}</span></div>
              <div class="snapshot-stat-row"><span class="snapshot-stat-label">Active Listings</span><span class="snapshot-stat-value">{citySnapshot.sale.activeListings}</span></div>
              <p class="snapshot-note">
                Weighing selling versus continuing to rent? {citySnapshot.sale.activeListings} active {rentCastDisplayName} listings are averaging {formatCurrency(citySnapshot.sale.averagePrice)}.
              </p>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {
    crossSellUnits.length > 0 && (
      <section>
        <div class="container">
          <div class="section-head">
            <div class="section-kicker">Homes for Rent</div>
            <h2>Other Red Door Homes {row.property_city ? `Near ${row.property_city}` : 'Available Now'}</h2>
          </div>
          <div class="post-mini-grid">
            {crossSellUnits.map((unit) => (
              <article class="post-mini-card">
                {unit.photoUrl && <img src={unit.photoUrl} alt={unit.formattedAddress} style="width:100%;border-radius:6px;margin-bottom:10px;aspect-ratio:16/10;object-fit:cover;" />}
                <h3>{unit.formattedAddress}</h3>
                <p class="consent">{unit.beds}bd / {unit.baths}ba &middot; ${unit.rent.toLocaleString()}/mo &middot; {unit.city}</p>
                {unit.applyUrl && (
                  <a class="btn btn-secondary" href={unit.applyUrl} target="_blank" rel="noopener" style="margin-top:8px;display:inline-block;">
                    View &amp; Apply
                  </a>
                )}
              </article>
            ))}
          </div>
          <p style="text-align:center;margin-top:24px">
            <a class="area-link" href="/indianapolis-homes-for-rent?areas=all">View all available Red Door properties &rarr;</a>
          </p>
        </div>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section>
        <div class="container">
          <div class="section-head">
            <div class="section-kicker">From Red Door</div>
            <h2>Recent Market Reports &amp; Landlord Guidance</h2>
          </div>
          <div class="post-mini-grid">
            {posts.map((post) => (
              <article class="post-mini-card">
                <span class="category">{post.categoryTitle}</span>
                <h3><a href={`/blog/${post.slug}`}>{post.title}</a></h3>
                <span class="date">{dateFormatter.format(new Date(post.publishedAt))}</span>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section-dark final-cta">
    <div class="container reveal">
      <h2>Curious What Red Door Could Do for This Property?</h2>
      <p>Talk through your options with Chris Knight, Red Door's business development manager &mdash; no obligation.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener">Schedule a Call</a>
      </div>
    </div>
  </section>

  <script define:vars={{ mapboxToken: MAPBOX_TOKEN }}>
    (function () {
      if (typeof mapboxgl === 'undefined') return;
      mapboxgl.accessToken = mapboxToken;

      // Subject-location map — one static marker, no interaction needed
      // beyond the map's own default pan/zoom controls.
      var subjectEl = document.getElementById('subject-map');
      if (subjectEl) {
        var lat = parseFloat(subjectEl.dataset.lat);
        var lng = parseFloat(subjectEl.dataset.lng);
        if (!isNaN(lat) && !isNaN(lng)) {
          var subjectMap = new mapboxgl.Map({
            container: 'subject-map',
            style: 'mapbox://styles/mapbox/light-v11',
            center: [lng, lat],
            zoom: 14,
            interactive: true,
          });
          subjectMap.addControl(new mapboxgl.NavigationControl(), 'top-right');
          subjectMap.on('load', function () {
            new mapboxgl.Marker({ color: '#8b0e04' }).setLngLat([lng, lat]).addTo(subjectMap);
          });
        }
      }

      // Comparable-properties map — one marker per comp, hover-synced
      // with the comps table rows above (same two-way hover pattern
      // already built for the Indianapolis homes-for-rent search page's
      // map: hovering a table row highlights its pin, and vice versa).
      var compsEl = document.getElementById('comps-map');
      if (compsEl) {
        var comps;
        try {
          comps = JSON.parse(compsEl.dataset.comps || '[]');
        } catch (e) {
          comps = [];
        }
        var withCoords = comps.filter(function (c) { return typeof c.lat === 'number' && typeof c.lng === 'number'; });
        if (withCoords.length > 0) {
          var compsMap = new mapboxgl.Map({
            container: 'comps-map',
            style: 'mapbox://styles/mapbox/light-v11',
            center: [withCoords[0].lng, withCoords[0].lat],
            zoom: 12,
          });
          compsMap.addControl(new mapboxgl.NavigationControl(), 'top-right');

          var pinsByIndex = {};
          var rows = document.querySelectorAll('.comps-table-row');

          compsMap.on('load', function () {
            var bounds = new mapboxgl.LngLatBounds();
            comps.forEach(function (c, i) {
              if (typeof c.lat !== 'number' || typeof c.lng !== 'number') return;
              var el = document.createElement('div');
              el.className = 'map-pin-price';
              el.textContent = c.rent ? '$' + Math.round(c.rent).toLocaleString() : '—';
              el.addEventListener('mouseenter', function () {
                var row = document.querySelector('.comps-table-row[data-comp-index="' + i + '"]');
                if (row) row.classList.add('is-map-hovered');
              });
              el.addEventListener('mouseleave', function () {
                var row = document.querySelector('.comps-table-row[data-comp-index="' + i + '"]');
                if (row) row.classList.remove('is-map-hovered');
              });
              var marker = new mapboxgl.Marker({ element: el, anchor: 'bottom' }).setLngLat([c.lng, c.lat]).addTo(compsMap);
              pinsByIndex[i] = el;
              bounds.extend([c.lng, c.lat]);
            });
            if (!bounds.isEmpty()) compsMap.fitBounds(bounds, { padding: 50, maxZoom: 14, duration: 0 });
          });

          rows.forEach(function (row) {
            var index = row.getAttribute('data-comp-index');
            row.addEventListener('mouseenter', function () {
              row.classList.add('is-hovered');
              var pin = pinsByIndex[index];
              if (pin) pin.classList.add('is-highlighted');
            });
            row.addEventListener('mouseleave', function () {
              row.classList.remove('is-hovered');
              var pin = pinsByIndex[index];
              if (pin) pin.classList.remove('is-highlighted');
            });
          });
        }
      }
    })();
  </script>
</BaseLayout>
