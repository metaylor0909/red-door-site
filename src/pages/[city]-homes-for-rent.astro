---
// /[city]-homes-for-rent — the 19 SIMPLE city "homes for rent" hub pages
// (Indianapolis excluded — it has its own real search/filter/map UI, built
// separately, and keeps its existing static indianapolis-homes-for-rent.html
// for now; out of scope here per CLAUDE.md's locked "three-page model").
//
// Ported faithfully from the already-approved static HTML reference pages
// at the repo root (avon-homes-for-rent.html is the canonical design
// source; the other 18 root-level *-homes-for-rent.html files are the same
// approved template already filled in per city with real Sep 17/18 content
// — extracted once into src/data/homes-for-rent-content.json by
// scripts/extract-homes-for-rent-content.mjs rather than re-typed by hand, so
// every city's hero copy, RentCast stat tiles, "What to Expect" facts, and
// curated "Homes Available Nearby" links are the real, already-reviewed
// text, not a re-derivation or a doorway-page template fill-in).
//
// What's genuinely live/dynamic per build, not baked from the static
// reference:
//   - The listing grid itself: fetched from RentEngine at build time and
//     filtered by this city's real ZIP list, NOT the fixed cards the Sep
//     18 reference pages hardcoded from a one-time pull. Empty/thin
//     inventory is the normal case (CLAUDE.md / listings-build-notes.md)
//     — the honest empty-state message below is ported from the
//     reference's own Zionsville/Fishers/Brownsburg empty-state pattern,
//     not invented here.
//   - REVISED 2026-09-21: the headline stat tiles, bedroom-rent
//     breakdown, and ZIP list now all come from the shared
//     rentcast_city_cache D1 table that workers/rentcast-refresh writes
//     monthly (falls back to the static data/homes-for-rent/*.json
//     snapshot if a city has no D1 row yet — see
//     src/lib/listings/homes-for-rent-content.ts). Previously only the
//     bedroom ladder was dynamic; the stat tiles were frozen at the
//     original Sep 17 extraction even after that ladder was added —
//     fixed now so the "live-refresh" pipeline actually keeps the page's
//     most prominent numbers current, not just a bonus table underneath
//     them. The hero copy, "What to Expect" prose, and CTA text stay
//     static — genuine editorial content, not RentCast-derived numbers.
//
// Known real bugs from the sibling listing-detail page, avoided here too:
//   - Never combine .container and .content-block on the same element —
//     nest them, or the block centers instead of sitting flush-left.
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ORGANIZATION_JSONLD } from '../lib/schema/organization';
import { fetchAllAvailableUnits, addressSlug, citySlug, RENTENGINE_ACCOUNT_ID } from '../lib/listings/rentengine';
import type { RentEngineUnit } from '../lib/listings/types';
import { petPolicy, petBadgeHtml } from '../lib/listings/pets';
import { loadCityContentMap, loadCityMarketData } from '../lib/listings/homes-for-rent-content';
import type { CityContent, BedroomLadderEntry } from '../lib/listings/homes-for-rent-content';
import CityInterlinkPanel from '../components/CityInterlinkPanel.astro';
import { getCityLinks } from '../lib/interlinking/city-links';
import AreasServedGrid from '../components/AreasServedGrid.astro';
import { CITY_CENTER } from '../lib/listings/city-coordinates';

// Mapbox public token (`pk.` prefix, publishable, not a secret) -- same
// value already hardcoded in indianapolis-homes-for-rent.astro,
// rental-analysis/[token].astro, and homes-for-rent/[city]/[slug].astro;
// see any of those files' own comment for why it's safe here (this page
// is prerendered, no request-time Worker env to read from).
const MAPBOX_TOKEN =
  'pk.eyJ1IjoibWV0YXlsb3IwOTA5IiwiYSI6ImNtdTdmZXJ5MzBpM3cyenB1eXMwNWdwaXkifQ.0sGI21TcAeEe9v_Pa91a9A';

export async function getStaticPaths() {
  const apiKey = import.meta.env.RENTENGINE_LISTINGS_KEY;
  let units: RentEngineUnit[] = [];
  if (!apiKey) {
    // Same graceful-degradation pattern as the sibling listing-detail route
    // and src/pages/blog/index.astro's missing-Sanity-credentials handling:
    // log and build with zero live listings rather than crash the build.
    console.warn(
      '[city homes-for-rent] RENTENGINE_LISTINGS_KEY not configured — all 19 city hub pages will build with zero live listings.'
    );
  } else {
    try {
      units = await fetchAllAvailableUnits({
        apiKey,
        accountId: import.meta.env.RENTENGINE_LISTINGS_ACCOUNT_ID || RENTENGINE_ACCOUNT_ID,
      });
    } catch (err) {
      console.warn('[city homes-for-rent] Could not reach RentEngine — all 19 city hub pages will build with zero live listings.', err);
    }
  }

  const cityContentMap = loadCityContentMap();
  const citySlugs = Object.keys(cityContentMap);

  // Shared across every city's own getStaticPaths call below — several
  // cities list each other as "nearby" (e.g. Avon and Brownsburg both
  // point at each other), so without this every such pair would re-fetch
  // the same city's D1 row twice per build, and every city referenced by
  // 3+ neighbors would get fetched 3+ times over.
  const marketDataCache = new Map<string, ReturnType<typeof loadCityMarketData>>();
  function loadCityMarketDataCached(slug: string) {
    if (!marketDataCache.has(slug)) {
      marketDataCache.set(slug, loadCityMarketData(env.DB, slug));
    }
    return marketDataCache.get(slug)!;
  }

  const NEARBY_LISTINGS_LIMIT = 8;

  return Promise.all(
    citySlugs.map(async (slug) => {
      const staticContent = cityContentMap[slug];
      const marketData = await loadCityMarketDataCached(slug);

      // Fresh stat tiles/dataAsOf override the static extraction's frozen
      // ones when available; fall back to the static values if the D1/
      // static read came back with nothing usable (e.g. a city whose
      // cached row has no rentalData yet) rather than show an empty tile row.
      const content: CityContent = {
        ...staticContent,
        statTiles: marketData.statTiles.length > 0 ? marketData.statTiles : staticContent.statTiles,
        dataAsOf: marketData.dataAsOf || staticContent.dataAsOf,
        marketNote: marketData.marketNote,
      };

      // City-to-listing matching is by ZIP, not RentEngine's own address.city
      // field (which only returns a broad name, e.g. every Indianapolis-area
      // address just says "Indianapolis") — see claude/red-door-rentcast-zip-
      // mapping.md and this task's own instructions. A unit can legitimately
      // match more than one city page when ZIPs overlap (shared township
      // ZIPs) — that's correct, not a bug.
      const zipSet = new Set(marketData.zipsUsed);
      const cityUnits = units.filter((u) => zipSet.has(u.address.zip_code));

      // "Homes Available Nearby" used to just be links to other cities'
      // own hub pages -- Michael asked 2026-09-28 for it to actually show
      // nearby listings instead. Pulled from this city's own curated
      // `nearby` list (staticContent.nearby), restricted to entries that
      // have a real page of their own (a null href, like Plainfield for
      // Avon, means no dedicated page and so no guaranteed D1/static row
      // to read a ZIP list from -- safer to just skip it than risk a
      // build-time throw from loadCityMarketData's fallback path).
      const nearbySlugs = staticContent.nearby
        .filter((n) => n.href)
        .map((n) => n.href!.replace(/^\//, '').replace(/-homes-for-rent$/, ''));
      const nearbyMarketData = await Promise.all(nearbySlugs.map((s) => loadCityMarketDataCached(s)));
      const nearbyZips = new Set(nearbyMarketData.flatMap((d) => d.zipsUsed));
      zipSet.forEach((z) => nearbyZips.delete(z));
      const nearbyUnits = units.filter((u) => nearbyZips.has(u.address.zip_code)).slice(0, NEARBY_LISTINGS_LIMIT);

      return {
        params: { city: slug },
        props: { content, bedroomLadder: marketData.bedroomLadder, cityUnits, nearbyUnits, allUnits: units },
      };
    })
  );
}

interface Props {
  content: CityContent;
  bedroomLadder: BedroomLadderEntry[];
  cityUnits: RentEngineUnit[];
  nearbyUnits: RentEngineUnit[];
  /** Every currently-available unit across the whole account, unfiltered
   * by city -- only used by the map (Michael's 2026-09-29 follow-up: the
   * map had silently inherited the same 8-listing cap as the "Homes
   * Available Nearby" cards, when the two are meant to be different --
   * a capped curated preview list vs. "show everything, we're just
   * anchored on this city"). The card grids above still use cityUnits/
   * nearbyUnits, capped, unchanged. */
  allUnits: RentEngineUnit[];
}

const { content, bedroomLadder, cityUnits, nearbyUnits, allUnits } = Astro.props;
const pagePath = `/${content.citySlug}-homes-for-rent`;
const cityLinks = getCityLinks(content.citySlug);
const cityCenter = CITY_CENTER[content.citySlug];
// The reference pages' empty-state copy and CTA headings use the bare city
// name ("Zionsville"), not the ", IN"-suffixed display form used in the H1
// ("Zionsville, IN Homes for Rent") — matching the approved reference text.
const shortCityName = content.cityName.replace(/,\s*IN$/, '');
const SMALL_SAMPLE_THRESHOLD = 5;
const canonicalUrl = `https://www.reddoorrents.com${pagePath}`;

// ItemList is only added when there's real inventory to list; an empty itemListElement
// array would be valid schema but pointless on a thin-inventory city.
const jsonLdGraph: object[] = [
  ORGANIZATION_JSONLD,
];

if (cityUnits.length > 0) {
  jsonLdGraph.push({
    '@type': 'ItemList',
    '@id': `${canonicalUrl}#listings`,
    name: content.h1,
    itemListElement: cityUnits.map((unit, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://www.reddoorrents.com/homes-for-rent/${citySlug(unit.address.city)}/${addressSlug(unit)}`,
    })),
  });
}

jsonLdGraph.push({
  '@type': 'BreadcrumbList',
  '@id': `${canonicalUrl}#breadcrumbs`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.reddoorrents.com/' },
    { '@type': 'ListItem', position: 2, name: content.h1, item: canonicalUrl },
  ],
});

const jsonLd = { '@context': 'https://schema.org', '@graph': jsonLdGraph };
---

<BaseLayout title={content.metaTitle} description={content.metaDescription} path={pagePath}>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://api.mapbox.com/mapbox-gl-js/v3.7.0/mapbox-gl.css" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  {/* Must load, unblocked by async/defer, before the module script below
      that reads `mapboxgl` -- same script-load-order requirement as
      rental-analysis/[token].astro and indianapolis-homes-for-rent.astro. */}
  <script src="https://api.mapbox.com/mapbox-gl-js/v3.7.0/mapbox-gl.js" is:inline></script>

  <section class="page-hero">
    <div class="container">
      <span class="section-kicker">Homes for Rent</span>
      <h1>{content.h1}</h1>
      <p class="lead">{content.heroDek}</p>
    </div>
  </section>

  {/* Reordered 2026-09-28 per Michael: Currently Available and Homes
      Available Nearby move up right after the hero (previously the last
      two sections before "How Renting Works"), then the new
      CityInterlinkPanel, then the rest of the page (rent-range/stat-tile
      snapshot, What to Expect, How Renting Works) continues in its
      original relative order. is-soft placement rebalanced across the
      move to keep the sitewide alternating light/white rhythm intact --
      .snapshot below and CityInterlinkPanel are both fixed-soft
      (background: var(--soft) in their own styles, not the is-soft
      modifier), so CityInterlinkPanel takes background="white" here
      specifically to avoid sitting soft-on-soft next to .snapshot.
      "Currently Available" flipped plain -> is-soft 2026-09-29 when the
      new map section (plain, between it and Homes Available Nearby) was
      added, to keep the whole chain alternating -- matches how
      .snapshot (fixed-soft) used to sit directly after the hero here
      before the 2026-09-28 reorder, so dark-hero-into-soft isn't a new
      pattern on this page. */}
  <section class="content-section is-soft">
    <div class="container">
      <h2>{content.currentlyAvailableHeading}</h2>
      <p class="section-dek">Live listings pull directly from Red Door's RentEngine feed.</p>
      {
        cityUnits.length > 0 ? (
          <div class="hub-listing-grid">
            {cityUnits.map((unit) => {
              const photo = unit.marketing_photos.find((p) => !p.hidden)?.original;
              const href = `/homes-for-rent/${citySlug(unit.address.city)}/${addressSlug(unit)}`;
              const rent = unit.target_rental_rate != null ? `$${unit.target_rental_rate.toLocaleString()}` : 'Contact for pricing';
              return (
                <a class="listing-card" href={href}>
                  <div class="listing-card-photo">
                    {photo && <img src={photo} alt={unit.address.formatted_address} loading="lazy" />}
                  </div>
                  <div class="listing-card-body">
                    <p class="listing-card-rent">
                      {rent}
                      <span>/mo</span>
                    </p>
                    <p class="listing-card-address">{unit.address.formatted_address}</p>
                    <p class="listing-card-specs">
                      {unit.bedrooms} bd &middot; {unit.bathrooms} ba
                      {unit.sqft ? ` · ${unit.sqft.toLocaleString()} sq ft` : ''}
                    </p>
                    <div class="listing-card-foot">
                      <Fragment set:html={petBadgeHtml(petPolicy(unit))} />
                      <span class="listing-card-viewlink">View details &rarr;</span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        ) : (
          <div class="listing-empty">
            <p>
              No homes are currently available in {shortCityName} right now. New availability appears here
              automatically as Red Door lists homes for rent.
            </p>
            <p>
              <a class="btn btn-secondary" href="/indianapolis-homes-for-rent">
                Browse Everything Currently Available
              </a>
            </p>
          </div>
        )
      }
    </div>
  </section>

  {/* Map view, added 2026-09-29 per Michael, between Currently Available
      and Homes Available Nearby -- same .map-pin-price/.map-popup-card
      pattern already used by the comps map (rental-analysis/[token].astro)
      and the Indianapolis homes-for-rent search page, reused as-is for
      visual consistency.

      Plots allUnits (every currently-available unit, whole account) --
      NOT cityUnits+nearbyUnits. Michael's second follow-up: the map had
      inherited nearbyUnits' 8-listing cap, when the two are meant to
      behave differently -- "Homes Available Nearby" below is a
      deliberately capped curated preview, but the map should show
      everything, since it's just a map (small portfolio, ~20-30 units
      account-wide per CLAUDE.md -- plotting all of them isn't a
      performance concern). Centered on cityCenter (src/lib/listings/
      city-coordinates.ts) at a fixed zoom rather than fitBounds to
      every pin's extent -- fitting bounds to the *whole account* would
      zoom out to the whole metro on every city's page, which is the
      opposite of what "anchored on this city" means. Pins outside the
      initial view are still there and reachable by panning/zooming out,
      same "local view first" pattern as most listing-search maps. */}
  {cityCenter && (
    <section class="content-section">
      <div class="container">
        <h2>{shortCityName} Rentals on the Map</h2>
        <p class="section-dek">Every Red Door listing, mapped around {shortCityName}.</p>
        <div
          class="city-listings-map"
          id="city-listings-map"
          data-lat={cityCenter[1]}
          data-lng={cityCenter[0]}
          data-units={JSON.stringify(
            allUnits
              .filter((u) => Array.isArray(u.address.coordinates))
              .map((u) => ({
                lat: u.address.coordinates![1],
                lng: u.address.coordinates![0],
                rent: u.target_rental_rate,
                address: u.address.formatted_address,
                photo: u.marketing_photos.find((p) => !p.hidden)?.original,
                href: `/homes-for-rent/${citySlug(u.address.city)}/${addressSlug(u)}`,
              }))
          )}
        />
      </div>
    </section>
  )}

  {/* Was a list of links to other cities' own hub pages -- Michael asked
      2026-09-28 for this to show actual nearby listings instead, same
      .listing-card grid as "Currently Available" above. nearbyUnits is
      built in getStaticPaths from this city's curated `nearby` cities'
      real ZIP lists (RentEngine units, not link targets) -- see that
      function's own comment for why href-less nearby entries (e.g.
      Plainfield for Avon, no dedicated page) are skipped. Hidden
      entirely when there's nothing to show, same as any other
      empty-data section on this page. */}
  {nearbyUnits.length > 0 && (
    <section class="content-section is-soft">
      <div class="container">
        <h2>Homes Available Nearby</h2>
        <p class="section-dek">{content.nearbyDek}</p>
        <div class="hub-listing-grid">
          {nearbyUnits.map((unit) => {
            const photo = unit.marketing_photos.find((p) => !p.hidden)?.original;
            const href = `/homes-for-rent/${citySlug(unit.address.city)}/${addressSlug(unit)}`;
            const rent = unit.target_rental_rate != null ? `$${unit.target_rental_rate.toLocaleString()}` : 'Contact for pricing';
            return (
              <a class="listing-card" href={href}>
                <div class="listing-card-photo">
                  {photo && <img src={photo} alt={unit.address.formatted_address} loading="lazy" />}
                </div>
                <div class="listing-card-body">
                  <p class="listing-card-rent">
                    {rent}
                    <span>/mo</span>
                  </p>
                  <p class="listing-card-address">{unit.address.formatted_address}</p>
                  <p class="listing-card-specs">
                    {unit.bedrooms} bd &middot; {unit.bathrooms} ba
                    {unit.sqft ? ` · ${unit.sqft.toLocaleString()} sq ft` : ''}
                  </p>
                  <div class="listing-card-foot">
                    <Fragment set:html={petBadgeHtml(petPolicy(unit))} />
                    <span class="listing-card-viewlink">View details &rarr;</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
        <p class="hub-listing-grid-cta">
          <a class="btn btn-secondary" href="/indianapolis-homes-for-rent">View All Red Door Listings</a>
        </p>
      </div>
    </section>
  )}

  <CityInterlinkPanel current="homes-for-rent" cities={cityLinks ? [cityLinks] : []} background="white" />

  <section class="snapshot">
    <div class="container">
      <p class="data-asof">{content.dataAsOf}</p>
      <div class="snapshot-grid">
        {
          content.statTiles.map((tile) => (
            <div class="stat-tile">
              <p class="stat-label">{tile.label}</p>
              <p class="stat-value">{tile.value}</p>
              <p class="stat-sub">{tile.sub}</p>
            </div>
          ))
        }
      </div>
      {content.snapshotDetail.map((paragraph) => <p class="snapshot-detail">{paragraph}</p>)}
      {content.marketNote && <p class="snapshot-detail">{content.marketNote}</p>}
      {
        bedroomLadder.length > 0 && (
          <>
            <p class="snapshot-note">Rent by bedroom count, this month&rsquo;s RentCast pull:</p>
            <div class="bedroom-ladder">
              {bedroomLadder.map((b) => (
                <div class="bedroom-ladder-row">
                  <span class="bedroom-ladder-beds">{b.beds === 0 ? 'Studio' : `${b.beds}-Bedroom`}</span>
                  <span class="bedroom-ladder-rent">${Math.round(b.avgRent).toLocaleString()}/mo</span>
                  {b.newListings < SMALL_SAMPLE_THRESHOLD && (
                    <span class="bedroom-ladder-note">
                      {b.newListings} new {b.newListings === 1 ? 'listing' : 'listings'} this pull &mdash; small sample
                    </span>
                  )}
                </div>
              ))}
            </div>
          </>
        )
      }
    </div>
  </section>

  <section class="content-section">
    <div class="container">
      <h2>{content.whatToExpectHeading}</h2>
      <ul>{content.whatToExpectItemsHtml.map((item) => <li set:html={item} />)}</ul>
    </div>
  </section>

  {/* Shared across all 19 pages, unchanged from the approved reference —
      not per-city content (see claude/red-door-homes-for-rent-data-schema.md,
      "What's shared, not per-city"). */}
  <section class="content-section is-soft">
    <div class="container">
      <h2>How Renting With Red Door Works</h2>
      <ul>
        <li>
          <strong>Browsing and applying:</strong> View details on any listing and apply directly online through Red
          Door's application flow.
        </li>
        <li>
          <strong>Screening criteria:</strong> Verifiable income of at least 3x rent, minimum 580 credit score,
          maximum 55% debt-to-income, no disqualifying convictions, no aggressive dog breeds, plus standard
          rental-history checks. Full detail on the <a class="area-link" href="/application-criteria">Tenant Qualification Criteria</a> page.
        </li>
        <li>
          <strong>Showings:</strong> Self-guided via digital lockbox once an application clears initial screening
          &mdash; no waiting to coordinate a showing time with an agent.
        </li>
      </ul>
    </div>
  </section>

  <AreasServedGrid
    headingLine1={`${shortCityName} Homes for Rent,`}
    headingLine2="Plus Every Community Nearby"
    leadText={`Red Door lists and manages rental homes in ${shortCityName} and across the surrounding Central Indiana communities.`}
    currentSlug={content.citySlug}
    pageType="homes-for-rent"
  />

  <section class="cta-band">
    <div class="container cta-inner">
      <div>
        <h2>{content.ctaHeading}</h2>
        <p>{content.ctaText}</p>
      </div>
      <div class="cta-buttons">
        <a class="btn btn-primary" href="/rental-analysis">Get a Free Rental Analysis</a>
        <a class="btn btn-ghost" href={content.propertyManagementHref}>See How We Manage Here</a>
      </div>
    </div>
  </section>

  <script define:vars={{ mapboxToken: MAPBOX_TOKEN }}>
    (function () {
      if (typeof mapboxgl === 'undefined') return;
      mapboxgl.accessToken = mapboxToken;

      // Same "don't construct until the whole page has loaded" fix as
      // rental-analysis/[token].astro and indianapolis-homes-for-rent.astro
      // -- constructing a Mapbox map before images/fonts/layout have
      // settled is the confirmed (real-phone-tested) cause of a
      // mis-positioned canvas on mobile.
      function initMap() {
        var el = document.getElementById('city-listings-map');
        if (!el) return;
        var lat = parseFloat(el.dataset.lat);
        var lng = parseFloat(el.dataset.lng);
        if (isNaN(lat) || isNaN(lng)) return;

        var units;
        try {
          units = JSON.parse(el.dataset.units || '[]');
        } catch (e) {
          units = [];
        }

        var map = new mapboxgl.Map({
          container: 'city-listings-map',
          style: 'mapbox://styles/mapbox/light-v11',
          center: [lng, lat],
          zoom: 10,
        });
        if (typeof ResizeObserver !== 'undefined') {
          new ResizeObserver(function () {
            map.resize();
          }).observe(el);
        }
        map.addControl(new mapboxgl.NavigationControl(), 'top-right');

        map.on('load', function () {
          // No fitBounds here on purpose -- see this section's own header
          // comment. Stays centered on the city at the fixed zoom set
          // above; every unit still gets a pin, whether or not it's in
          // the initial viewport.
          units.forEach(function (u) {
            var pin = document.createElement('div');
            pin.className = 'map-pin-price';
            pin.textContent = u.rent ? '$' + Math.round(u.rent).toLocaleString() : 'Contact';
            var popupHtml =
              '<div class="map-popup-card">' +
              (u.photo ? '<img src="' + u.photo + '" alt="">' : '') +
              '<span class="rent">' + (u.rent ? '$' + Math.round(u.rent).toLocaleString() + '/mo' : 'Contact for pricing') + '</span>' +
              '<span class="addr">' + (u.address || '') + '</span>' +
              '<a href="' + u.href + '">View details &rarr;</a></div>';
            new mapboxgl.Marker({ element: pin, anchor: 'bottom' })
              .setLngLat([u.lng, u.lat])
              .setPopup(new mapboxgl.Popup({ offset: 14 }).setHTML(popupHtml))
              .addTo(map);
          });
        });
      }

      if (document.readyState === 'complete') {
        initMap();
      } else {
        window.addEventListener('load', initMap);
      }
    })();
  </script>
</BaseLayout>
