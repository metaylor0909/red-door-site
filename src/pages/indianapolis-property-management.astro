  {/* FAQ accordion toggle — same self-contained behavior as
      WhyChooseAccordion.astro's own script, duplicated rather than
      imported since this page doesn't use that component (its "why
      choose" section is the "What Makes Red Door Different" list
      instead) and Astro components don't export plain functions to
      import into a page's own script block. */}
  <script>
    // Owner FAQ videos: the thumbnail is a plain YouTube link (works with
    // no JS); on click it's swapped for a youtube-nocookie embed so the
    // page loads no YouTube player code until someone actually plays one.
    // Hovering (or tabbing into) a smaller video makes it the large one.
    // It stays large after the pointer leaves, so the row doesn't jump
    // back and forth. Desktop layout with a real pointer only: on narrower
    // screens the first video stays full-width above the other two.
    var videoGrid = document.querySelector('[data-video-grid]');
    var canGrowVideos = window.matchMedia('(hover: hover) and (min-width: 1001px)');
    if (videoGrid) {
      videoGrid.querySelectorAll('[data-video-index]').forEach(function (card) {
        function feature() {
          if (!canGrowVideos.matches || card.classList.contains('is-featured')) return;
          videoGrid.querySelectorAll('.pm-video-card').forEach(function (c) {
            c.classList.toggle('is-featured', c === card);
          });
          videoGrid.setAttribute('data-active', card.getAttribute('data-video-index'));
        }
        card.addEventListener('mouseenter', feature);
        card.addEventListener('focusin', feature);
      });
    }

    document.querySelectorAll('[data-video-id]').forEach(function (link) {
      link.addEventListener('click', function (e) {
        e.preventDefault();
        var id = link.getAttribute('data-video-id');
        var iframe = document.createElement('iframe');
        iframe.src = 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(id) + '?autoplay=1&rel=0';
        iframe.title = link.getAttribute('aria-label').replace(/^Play video: /, '');
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.className = 'pm-video-frame';
        link.replaceWith(iframe);
      });
    });

    document.querySelectorAll('[data-accordion]').forEach(function (accordion) {
      accordion.querySelectorAll('.accordion-trigger').forEach(function (trigger) {
        trigger.addEventListener('click', function () {
          var item = trigger.closest('.accordion-item');
          accordion.querySelectorAll('.accordion-item').forEach(function (candidate) {
            var candidateTrigger = candidate.querySelector('.accordion-trigger');
            var shouldOpen = candidate === item && !candidate.classList.contains('is-open');
            candidate.classList.toggle('is-open', shouldOpen);
            candidateTrigger.setAttribute('aria-expanded', String(shouldOpen));
          });
        });
      });
    });
  </script>
</BaseLayout>
