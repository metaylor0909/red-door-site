  />

  <section id="faq">
    <div class="container reveal">
      <div class="section-head center">
        <div class="section-kicker">Questions Owners Ask</div>
        <h2>Frequently Asked Questions</h2>
      </div>
      <div class="accordion" data-accordion>
        {faqs.map((item, i) => (
          <article class={`accordion-item${i === 0 ? ' is-open' : ''}`}>
            <button class="accordion-trigger" type="button" aria-expanded={i === 0 ? 'true' : 'false'}>
              <span>{item.q}</span><span aria-hidden="true">+</span>
            </button>
            <div class="accordion-panel"><div><p set:html={item.a} /></div></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="local-section">
    <div class="container split">
      <div class="reveal">
        <h2>Indianapolis Property Management Built on Local Experience</h2>
        <p class="lead">Red Door Property Management helps accidental landlords, out-of-state owners, and growth-minded investors navigate the complete rental lifecycle. Our local team combines documented processes, modern technology, and hands-on Indianapolis-area market knowledge to help owners avoid costly mistakes and make better decisions for their properties.</p>
        <p class="statement">Smarter Property Management Powered by Process, Data-Driven Decisions, and Local Market Expertise.</p>
        <div class="cta-row" style="justify-content:flex-start">
          <a class="btn btn-primary" href="/about">Meet Our Team</a>
          <a class="btn btn-secondary" href="/pricing">See Management Pricing</a>
        </div>
      </div>
      <div class="image-frame reveal" role="img" aria-label="Red Door placeholder home photo representing local Indianapolis property management">
        <div class="image-caption">Indianapolis-area knowledge, practical recommendations, and clear owner visibility.</div>
      </div>
    </div>
  </section>

  <section class="section-dark final-cta">
    <div class="container reveal">
      <h2>Ready for Better Property Management in Indianapolis?</h2>
      <p>Whether you own one rental or a growing portfolio, Red Door Property Management is built to protect your asset and maximize results.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/rental-analysis">Get a Free Rental Analysis</a>
        <a class="btn btn-secondary" href="https://calendly.com/cknight-19/phone-call" target="_blank" rel="noopener">Schedule a Call</a>
        <a class="btn btn-secondary" href="tel:3176601626">Call 317.660.1626</a>
      </div>
    </div>
  </section>

  {/* FAQ accordion toggle — same self-contained behavior as
      WhyChooseAccordion.astro's own script, duplicated rather than
      imported since this page doesn't use that component (its "why
      choose" section is the "What Makes Red Door Different" list
      instead) and Astro components don't export plain functions to
      import into a page's own script block. */}
  <script>
    document.querySelectorAll('[data-accordion]').forEach(function (accordion) {
      accordion.querySelectorAll('.accordion-trigger').forEach(function (trigger) {
        trigger.addEventListener('click', function () {
          var item = trigger.closest('.accordion-item');
          accordion.querySelectorAll('.accordion-item').forEach(function (candidate) {
            var candidateTrigger = candidate.querySelector('.accordion-trigger');
            var shouldOpen = candidate === item && !candidate.classList.contains('is-open');
            candidate.classList.toggle('is-open', shouldOpen);
            candidateTrigger.setAttribute('aria-expanded', String(shouldOpen));
          });
        });
      });
    });
  </script>
</BaseLayout>
