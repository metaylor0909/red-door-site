---
// /indianapolis-property-management — the flagship page, built separately
// from the 18-city shared template (src/pages/[city]-property-management.astro)
// because its approved mockup uses a meaningfully different, richer
// design: no plain journey-wrap (replaced by its own 3D interactive
// carousel, see src/components/PropertyManagementJourneyCarousel.astro), plus
// a "What Makes Red Door Different" list, six detailed process-detail
// sections (one per pillar-page stage), a "What's Included" list, an
// "Owner Standards" list (removed 2026-10-06), and a 10-question FAQ accordion — none of
// which exist on the 18 simple pages.
//
// Redesigned 2026-10-06 (Michael): shorter hero; new "Who We Work With"
// owner-type cards and owner FAQ video band; "What Makes Red Door
// Different" and "A Chain, Not a Checklist" became card grids (the chain
// cards replace the six long process-detail sections, linking to the
// same pillar pages); the market snapshot moved below the reviews.
//
// Sections here mostly alternate backgrounds, so each one that follows a
// differently colored section carries .pm-pad to undo the sitewide
// `section + section { padding-top: 0 }` rule. Confirmed via a class-name diff
// against avon-property-management.html before starting (see that
// page's own commit message). Same "build the flagship page separately"
// precedent already used for indianapolis-homes-for-rent.astro.
//
// A single static page, not a dynamic route — no getStaticPaths needed,
// so the D1 read just happens directly in this frontmatter (confirmed
// D1 bindings are available during static prerendering generally, not
// just specifically inside getStaticPaths — see src/lib/property-
// management/market-snapshot.ts and the homes-for-rent pages' own
// earlier build-time D1 verification).
//
// Same rental-analysis section as the homepage and the 18 simple pages:
// the mockup's old placeholder 6-step form (same stale pre-real-tool
// pattern) is replaced with the real form — see
// src/components/RentalAnalysisForm.astro's header comment. Originally
// (this page's first build) a condensed pitch + CTA linking to
// /rental-analysis instead; Michael asked 2026-09-24 for the real form
// to render inline here too. Every other same-page #rental-analysis
// anchor on this page (hero CTA, final-cta) still points to the
// standalone /rental-analysis page.
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ORGANIZATION_JSONLD } from '../lib/schema/organization';
import ProofStrip from '../components/ProofStrip.astro';
import PropertyManagementJourneyCarousel from '../components/PropertyManagementJourneyCarousel.astro';
import ReviewsCarousel from '../components/ReviewsCarousel.astro';
import AreasServedGrid from '../components/AreasServedGrid.astro';
import LandlordLibrary from '../components/LandlordLibrary.astro';
import RentalAnalysisForm from '../components/RentalAnalysisForm.astro';
import { loadMarketSnapshot } from '../lib/property-management/market-snapshot';
import { PILLAR_LANDLORD_LIBRARY_POSTS } from '../lib/property-management/pillar-landlord-library-posts';
import MarketReportStrip from '../components/MarketReportStrip.astro';
import { loadRecentCityReports } from '../lib/blog/city-reports';

const snapshot = await loadMarketSnapshot(env.DB, 'indianapolis');
const recentReports = await loadRecentCityReports('indianapolis', 'Indianapolis');

const pageTitle = 'Indianapolis Property Management | Red Door Property Management';
const pageDescription =
  'Full-service Indianapolis property management — market readiness, marketing, tenant screening, leasing, maintenance, and proactive communication for rental owners.';
const pagePath = '/indianapolis-property-management';
const canonicalUrl = `https://www.reddoorrents.com${pagePath}`;

function formatCurrency(value: number | null): string {
  return value == null ? '—' : `$${Math.round(value).toLocaleString()}`;
}
function formatDays(value: number | null): string {
  return value == null ? 'n/a' : `${Math.round(value)}`;
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ORGANIZATION_JSONLD,
    {
      '@type': 'Service',
      '@id': `${canonicalUrl}#service`,
      serviceType: 'Residential Property Management',
      provider: { '@id': 'https://www.reddoorrents.com/#organization' },
      areaServed: 'Indianapolis, IN',
      url: canonicalUrl,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumbs`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.reddoorrents.com/' },
        { '@type': 'ListItem', position: 2, name: 'Indianapolis Property Management', item: canonicalUrl },
      ],
    },
  ],
};

const faqs = [
  {
    q: 'What does a property management company in Indianapolis actually do?',
    a: 'A professional property management company handles the full lifecycle of your rental property — preparing the home for market, marketing it, screening tenants, executing leases, collecting rent, coordinating maintenance, and communicating with tenants and owners. Red Door operates a structured system beginning with Market Readiness and continuing through marketing, tenant placement, maintenance coordination, and ongoing communication.',
  },
  {
    q: 'How much does property management cost in Indianapolis?',
    a: 'Property management fees in Indianapolis typically range between 8% and 12% of the monthly rent. Red Door offers a competitive, transparent fee structure and does not require long-term cancellation contracts. Full pricing detail is on our <a href="/pricing">Pricing</a> page.',
  },
  {
    q: 'How long does it usually take to find a tenant?',
    a: 'Most professionally marketed rental homes in Indianapolis lease within 2–4 weeks, depending on price, condition, location, and market conditions. Our 2-Week Leasing Guarantee reflects the strength of our marketing system.',
  },
  {
    q: 'How do you screen tenants?',
    a: 'Our process includes credit history evaluation, nationwide criminal and eviction background checks, employment and income verification (typically 3× monthly rent), rental history verification, identity and fraud detection, and pet screening through a third-party platform. See our full <a href="/tenant-screening">Tenant Screening</a> process.',
  },
  {
    q: 'Who handles maintenance requests?',
    a: 'Red Door coordinates all maintenance through a structured system: in-house technicians for common repairs, vetted local vendors for specialty work, preventative maintenance recommendations, 24/7 emergency response, and photo/video documentation for accountability.',
  },
  {
    q: 'How do owners stay informed about their property?',
    a: 'Owners get a modern owner portal with monthly financial statements, maintenance updates, photos and video documentation, lease agreements, and rent payment tracking — plus proactive communication via phone, email, text, and video.',
  },
  {
    q: 'Do you manage single homes or large portfolios?',
    a: 'Both. We work with first-time rental owners, accidental landlords, out-of-state investors, and experienced investors with multiple properties — our systems are designed to scale while maintaining consistent service.',
  },
  {
    q: 'What happens if a tenant breaks their lease early?',
    a: 'If a tenant placed by Red Door voids their lease within the first six months, our 6-Month Tenant Guarantee applies — your next New Lease Fee is waived.',
  },
  {
    q: 'Can I cancel property management if I’m not satisfied?',
    a: 'Yes. We don&rsquo;t require long-term cancellation contracts, and our 90-Day Money-Back Guarantee refunds management fees if you change your mind within the first 90 days.',
  },
  {
    q: 'How do I get started with Red Door Property Management?',
    a: 'The first step is a free Rental Market Analysis, which lets us evaluate your property, review market rent data, and determine how our Market Readiness process can position your home for the strongest performance. From there, we guide you through onboarding, market readiness preparation, and the full leasing process.',
  },
];

const OWNER_TYPES = [
  {
    title: 'Accidental landlords',
    text: 'If you are renting out a home for the first time, Red Door gives you structure, guidance, and protection from the common mistakes new landlords face.',
    points: [
      'Rental pricing guidance before the home hits the market',
      'Market readiness recommendations to reduce showing objections',
      'Lease, move-in, maintenance, and renewal systems already in place',
      'Clear communication so you know what is happening and why',
    ],
  },
  {
    title: 'Out-of-state owners',
    text: 'Distance should not mean uncertainty. We provide local eyes, documented updates, and vendor coordination when you cannot be at the property yourself.',
    points: [
      'Photo and video documentation for inspections, repairs, and turnovers',
      'Owner portal access to statements, documents, and property activity',
      'Local maintenance coordination with vetted resources',
      'Proactive updates by phone, email, text, and video when needed',
    ],
  },
  {
    title: 'Growing investors',
    text: 'For owners looking to expand, Red Door can support smarter acquisition decisions and help new properties become rent-ready faster.',
    points: [
      'Rental projections for prospective investment properties',
      'Local guidance on areas, rent demand, and property positioning',
      'Connections to local resources that help build your investing team',
      'Market readiness rehab coordination for BRRRR-style strategies',
    ],
  },
];

const DIFFERENTIATORS = [
  {
    title: 'Transparent, high-touch customer service',
    text: 'Owners are not routed into silence. Red Door emphasizes practical communication, clear next steps, and a team that answers questions before small issues become bigger frustrations.',
  },
  {
    title: '24-hour availability',
    text: 'Property issues do not always happen during office hours. Red Door maintains around-the-clock availability for urgent situations, and we answer our phones when owners and residents need help.',
  },
  {
    title: 'Communication and maintenance platforms',
    text: 'Continued investment in modern platforms helps organize maintenance requests, documentation, owner updates, statements, photos, videos, and important property documents.',
  },
  {
    title: 'Professional marketing with anti-scam protection',
    text: 'Professional photos, strong listing copy, broad online exposure, and anti-scam watermarking help your property stand out while protecting the listing from misuse.',
  },
  {
    title: 'Strong online presence to minimize vacancy',
    text: 'Red Door&rsquo;s marketing process is built to get rental homes in front of qualified renters quickly through high-visibility listing channels and a polished digital presentation.',
  },
  {
    title: 'Owner portal visibility',
    text: 'Owners can access monthly statements, documents, photos, videos, leases, and property information without digging through disconnected email threads.',
  },
  {
    title: 'Yearly rental analysis',
    text: 'Rental values change. Red Door reviews rent positioning so owners can make informed renewal and pricing decisions instead of relying on stale assumptions.',
  },
  {
    title: 'Competitive, published fees',
    text: 'Management fees, the New Lease Fee, and every separately billed service are listed on our <a href="/pricing">Pricing</a> page, so there are no surprises on your statement.',
  },
  {
    title: 'No long-term lock-in',
    text: 'There is no 12-month cancellation requirement. Clear expectations and flexible terms make it easier for owners to choose Red Door with confidence.',
  },
];

// Owner FAQ videos on the Red Door YouTube channel. Titles match the
// videos' own YouTube titles (checked via oEmbed 2026-10-06).
const OWNER_VIDEOS = [
  {
    id: 'r9jl7CdIkYw',
    kicker: 'Pricing Clarity',
    title: 'What do you charge?',
    text: 'Understand how Red Door approaches management fees, transparency, and value so you can compare the service with confidence.',
  },
  {
    id: 'ETOin2lklx0',
    kicker: 'Tenant Quality',
    title: 'How do you screen tenants?',
    text: 'Learn how applicant review helps reduce missed payments, property damage, evictions, fraud, and early turnover.',
  },
  {
    id: 'QZcX-UV0G_c',
    kicker: 'Repair Confidence',
    title: 'How do you handle maintenance?',
    text: 'See how maintenance requests are coordinated with documentation, vetted resources, emergency coverage, and owner visibility.',
  },
];

// Owner Roadmap order (Maintenance = 5, Communication = 6 — see CLAUDE.md).
const CHAIN_STEPS = [
  {
    label: 'Market Readiness',
    title: "Start with the property's condition and rent position.",
    text: 'Red Door identifies repairs, pricing issues, and presentation details before the home is marketed, helping owners avoid avoidable vacancy and weak first impressions.',
    href: '/market-readiness-assessment',
    linkLabel: 'Market Readiness',
  },
  {
    label: 'Marketing',
    title: 'Make the home easy to find, trust, and tour.',
    text: 'Professional photos, virtual walkthroughs, search-friendly listings, syndication, and showing tools help qualified renters move from interest to application.',
    href: '/marketing-process',
    linkLabel: 'Marketing',
  },
  {
    label: 'Tenant Screening',
    title: 'Place the right resident, not just the fastest applicant.',
    text: 'Screening includes credit, background, eviction, income, rental history, identity, fraud, and pet review so decisions are documented and consistent.',
    href: '/tenant-screening',
    linkLabel: 'Screening',
  },
  {
    label: 'Leasing',
    title: 'Protect the tenancy from day one.',
    text: 'Lease execution, move-in condition records, tenant portal setup, renewal planning, and move-out documentation create accountability through the full lease cycle.',
    href: '/leasing-process',
    linkLabel: 'Leasing',
  },
  {
    label: 'Maintenance',
    title: 'Keep small problems from becoming expensive surprises.',
    text: 'Requests are coordinated with troubleshooting, documentation, in-house support, vetted vendors, and emergency coverage for true habitability concerns.',
    href: '/maintenance',
    linkLabel: 'Maintenance',
  },
  {
    label: 'Communication',
    title: 'Make owner visibility part of the service.',
    text: 'Owners get updates through the portal, phone, email, text, photos, and video so they know what is happening and what decisions need approval.',
    href: '/communication',
    linkLabel: 'Communication',
  },
];

---

<BaseLayout title={pageTitle} description={pageDescription} path={pagePath}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <section class="hero" aria-labelledby="page-title">
    <div class="hero-content">
      <div class="eyebrow">Full-Service Property Management</div>
      <h1 id="page-title">
        <span>Indianapolis Property Management</span>
        <span>That Protects Your Investment</span>
      </h1>
      <p class="hero-copy">Full-service management for Indianapolis rental owners &mdash; one documented system from market readiness to move-out.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/rental-analysis" data-track="hero-rental-analysis">Get a Free Rental Analysis</a>
        <a class="btn btn-secondary" href="/contact" data-track="hero-contact">Talk to Our Team</a>
      </div>
    </div>
    <a class="scroll-cue" href="#trust-proof" aria-label="Scroll to proof points">
      <span aria-hidden="true"></span>
      Scroll
    </a>
  </section>

  <ProofStrip cityLabel="Indianapolis" />

  <PropertyManagementJourneyCarousel />

  <section class="pm-owners">
    <div class="container reveal">
      <div class="section-head">
        <div class="section-kicker">Who We Work With</div>
        <h2>Local Property Management With a Documented, Owner-First Process</h2>
        <p>Red Door manages the full rental lifecycle for Indianapolis owners &mdash; pricing and preparation, tenant placement, leases, maintenance, accounting, and ongoing communication &mdash; so small problems get handled before they become expensive ones.</p>
      </div>
      <div class="pm-card-grid">
        {OWNER_TYPES.map((t) => (
          <article class="pm-owner-card">
            <h3>{t.title}</h3>
            <p>{t.text}</p>
            <ul class="check-list">
              {t.points.map((p) => <li>{p}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-soft pm-pad">
    <div class="container reveal">
      <div class="pm-split-head">
        <div>
          <div class="section-kicker">What Makes Red Door Different</div>
          <h2>What Makes Red Door Property Management Different</h2>
        </div>
        <p>Red Door combines high-touch customer service, strong communication systems, modern property management technology, and competitive owner protections, so owners are not left guessing what is happening with their rental.</p>
      </div>
      <div class="pm-card-grid">
        {DIFFERENTIATORS.map((d) => (
          <article class="pm-feature-card">
            <h3>{d.title}</h3>
            <p set:html={d.text} />
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-dark pm-videos pm-pad" aria-labelledby="pm-videos-title">
    <div class="container reveal">
      <div class="pm-split-head">
        <div>
          <div class="section-kicker">Question of the Week</div>
          <h2 id="pm-videos-title">Questions You Should Be Asking</h2>
        </div>
        <p>Before choosing a property manager, owners should understand pricing, tenant screening, and maintenance standards. These short videos answer the questions that reveal how a management company really operates.</p>
      </div>
      <div class="pm-video-grid" data-video-grid data-active="0">
        {OWNER_VIDEOS.map((v, i) => (
          <article class={`pm-video-card${i === 0 ? ' is-featured' : ''}`} data-video-index={i}>
            <a
              class="pm-video-thumb"
              href={`https://www.youtube.com/watch?v=${v.id}`}
              target="_blank"
              rel="noopener"
              data-video-id={v.id}
              aria-label={`Play video: ${v.title}`}
            >
              {/* maxres for all three: any card can become the large one. */}
              <img src={`https://i.ytimg.com/vi/${v.id}/maxresdefault.jpg`} alt="" loading="lazy" width="1280" height="720" />
              <span class="pm-video-play" aria-hidden="true"></span>
            </a>
            <div class="pm-video-body">
              <span class="pm-video-kicker">{v.kicker}</span>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>



  <section class="section-dark guarantee-section pm-pad">
    <div class="container">
      <div class="section-head center reveal">
        <div class="section-kicker">A Process We Are Willing to Stand Behind</div>
        <h2>Red Door Guarantees</h2>
        <p>We stand behind our system with real guarantees:</p>
      </div>
      <div class="guarantee-grid reveal">
        <article class="guarantee-card">
          <span>Leasing</span>
          <h3>2-Week Leasing Guarantee</h3>
          <p>Secure a viable tenant within two weeks of marketing or your first month's management fee is waived.</p>
        </article>
        <article class="guarantee-card">
          <span>Tenant Placement</span>
          <h3>6-Month Tenant Guarantee</h3>
          <p>If a tenant placed by Red Door voids the lease within the first six months, your next New Lease Fee is waived.</p>
        </article>
        <article class="guarantee-card">
          <span>Owner Confidence</span>
          <h3>90-Day Money-Back Guarantee</h3>
          <p>If you change your mind during the first 90 days, Red Door will refund the management fees paid.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="pm-pad">
    <div class="container reveal">
      <div class="pm-split-head">
        <div>
          <div class="section-kicker">Our Proven Property Management System</div>
          <h2>A Chain, Not a Checklist</h2>
        </div>
        <p>Great property management is a chain. If any link breaks, owners pay for it. Red Door's system covers the full rental lifecycle, with each phase reinforcing the next.</p>
      </div>
      <div class="pm-card-grid">
        {CHAIN_STEPS.map((step, i) => (
          <article class="pm-chain-card">
            <span class="pm-chain-num">{String(i + 1).padStart(2, '0')} {step.label}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
            <a class="pm-chain-link" href={step.href}>Explore {step.linkLabel}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-soft pm-pad pm-included">
    <div class="container content-block reveal">
      <h2>What's Included (No Nickel-and-Diming)</h2>
      <p>We provide a large array of services at no additional cost:</p>
      <ul class="two-col-list check-list">
        <li>Property advertising across major platforms</li>
        <li>Showing coordination and lockbox access</li>
        <li>Tenant screening and placement</li>
        <li>Lease execution and renewals</li>
        <li>Video-documented move-in and move-out</li>
        <li>Rent collection via ACH</li>
        <li>Maintenance coordination and vendor management</li>
        <li>Tenant mediation</li>
        <li>Monthly accounting statements</li>
        <li>Year-end tax reporting</li>
        <li>Trust accounting (no added accounting fees)</li>
      </ul>
      <p class="callout-note">Full pricing detail &mdash; management fees, the New Lease Fee, and every separately billed service &mdash; is published on our <a href="/pricing">Pricing</a> page.</p>
    </div>
  </section>

  <ReviewsCarousel />

  <section class="section-soft pm-pad">
    <div class="container">
      <div class="section-head center reveal">
        <div class="section-kicker">Where the Indianapolis Market Stands Right Now</div>
        <h2>Indianapolis Rental &amp; Sales Snapshot</h2>
        <p>A condensed look at what's happening in Indianapolis right now &mdash; for the full rental trend data and bedroom-by-bedroom breakdown, see the <a class="area-link" href="/indianapolis-homes-for-rent">Indianapolis homes for rent page</a>.</p>
      </div>
      <p class="snapshot-asof reveal">
        {snapshot.dataAsOf} Covers the 37 standard-mail-delivery ZIP codes in Marion County; one ZIP (46282) returned no market data and is excluded.
      </p>
      <div class="snapshot-panels reveal">
        <div class="snapshot-panel">
          <span class="snapshot-panel-label">Rental Market</span>
          <h3>Indianapolis Rentals</h3>
          <div class="snapshot-stat-row"><span class="snapshot-stat-label">Average Rent</span><span class="snapshot-stat-value">{formatCurrency(snapshot.rental.averageRent)}</span></div>
          <div class="snapshot-stat-row"><span class="snapshot-stat-label">Median Rent</span><span class="snapshot-stat-value">{formatCurrency(snapshot.rental.medianRent)}</span></div>
          <div class="snapshot-stat-row"><span class="snapshot-stat-label">Active Listings</span><span class="snapshot-stat-value">{snapshot.rental.activeListings.toLocaleString()}</span></div>
          <p class="snapshot-note"><a class="area-link" href="/indianapolis-homes-for-rent">See the full Indianapolis rental market &rarr;</a></p>
        </div>
        <div class="snapshot-panel is-sales">
          <span class="snapshot-panel-label">Sales Market</span>
          <h3>Indianapolis For-Sale Homes</h3>
          <div class="snapshot-stat-row"><span class="snapshot-stat-label">Average Sale Price</span><span class="snapshot-stat-value">{formatCurrency(snapshot.sale.averagePrice)}</span></div>
          <div class="snapshot-stat-row"><span class="snapshot-stat-label">Median Sale Price</span><span class="snapshot-stat-value">{formatCurrency(snapshot.sale.medianPrice)}</span></div>
          <div class="snapshot-stat-row"><span class="snapshot-stat-label">Active Listings</span><span class="snapshot-stat-value">{snapshot.sale.activeListings.toLocaleString()}</span></div>
          <p class="snapshot-note">
            Weighing selling versus continuing to rent? {snapshot.sale.activeListings.toLocaleString()} active Indianapolis listings are averaging {formatCurrency(snapshot.sale.averagePrice)} and moving in about {formatDays(snapshot.sale.averageDaysOnMarket)} days, compared to {formatDays(snapshot.rental.averageDaysOnMarket)} days for rentals.
          </p>
        </div>
      </div>
      <MarketReportStrip cityName="Indianapolis" reports={recentReports} archiveHref="/indianapolis-market-reports" archiveLabel="Indianapolis" />
    </div>
  </section>

  {/* Replaces the mockup's old placeholder 6-step form (same stale
      pre-real-tool pattern as the homepage's) with the real form — see
      RentalAnalysisForm.astro's header comment. */}
  <section class="section-soft" id="rental-analysis">
    <div class="container analysis-grid">
      <div class="reveal">
        <div class="section-kicker">Free Rental Analysis</div>
        <h2>What Could Your Indianapolis Rental Earn?</h2>
        <p class="lead">Get a professional rental analysis backed by local market activity, comparable homes, current competition, and Red Door's experience managing rentals in Indianapolis and across Central Indiana.</p>
        <ul class="benefit-list">
          <li><span>1</span>Understand your property's current rental value.</li>
          <li><span>2</span>Identify improvements that may strengthen rent and tenant appeal.</li>
          <li><span>3</span>See whether Red Door's management approach fits your goals.</li>
        </ul>
      </div>

      <RentalAnalysisForm />
    </div>
  </section>

  <AreasServedGrid
    headingLine1="Indianapolis Property Management,"
    headingLine2="Plus Every Community Nearby"
    leadText="Red Door manages rental homes in Indianapolis and across the surrounding Central Indiana communities where owners need steady leasing, responsive maintenance, and clear local guidance."
    currentSlug="indianapolis"
  />

  <LandlordLibrary
    heading="The Red Door Landlord Library"
    subheading="Market updates, investment insights, and practical property-management guidance for Central Indiana rental owners."
    posts={PILLAR_LANDLORD_LIBRARY_POSTS}
  />

  <section id="faq">
    <div class="container reveal">
      <div class="section-head center">
        <div class="section-kicker">Questions Owners Ask</div>
        <h2>Frequently Asked Questions</h2>
      </div>
      <div class="accordion" data-accordion>
        {faqs.map((item, i) => (
          <article class={`accordion-item${i === 0 ? ' is-open' : ''}`}>
            <button class="accordion-trigger" type="button" aria-expanded={i === 0 ? 'true' : 'false'}>
              <span>{item.q}</span><span aria-hidden="true">+</span>
            </button>
            <div class="accordion-panel"><div><p set:html={item.a} /></div></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="local-section">
    <div class="container split">
      <div class="reveal">
        <h2>Indianapolis Property Management Built on Local Experience</h2>
        <p class="lead">Red Door Property Management helps accidental landlords, out-of-state owners, and growth-minded investors navigate the complete rental lifecycle. Our local team combines documented processes, modern technology, and hands-on Indianapolis-area market knowledge to help owners avoid costly mistakes and make better decisions for their properties.</p>
        <p class="statement">Smarter Property Management Powered by Process, Data-Driven Decisions, and Local Market Expertise.</p>
        <div class="cta-row" style="justify-content:flex-start">
          <a class="btn btn-primary" href="/about">Meet Our Team</a>
