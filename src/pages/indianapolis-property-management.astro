    </div>
  </section>

  <AreasServedGrid
    headingLine1="Indianapolis Property Management,"
    headingLine2="Plus Every Community Nearby"
    leadText="Red Door manages rental homes in Indianapolis and across the surrounding Central Indiana communities where owners need steady leasing, responsive maintenance, and clear local guidance."
