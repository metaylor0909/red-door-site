---
// /leasing-process — pillar page 5 of 8 built this way. Ported from
// leasing-process.html. Shares the same PropertyManagementJourneyCarousel
// used on the other pillar pages and the Indianapolis property-management
// page, and the same Landlord Library post set
// (src/lib/property-management/pillar-landlord-library-posts.ts).
//
// No page-level JSON-LD added beyond what the carousel component already
// provides (its own ItemList schema) — the source mockup didn't have
// page-level Organization/BreadcrumbList schema either, so none is invented
// here per CLAUDE.md's "never rewrite content during structural migration"
// rule.
//
// The hero uses the `.hero-pillar` class (see global.css) for the
// CTA-row/H1 spacing override these single-line-H1 pillar heroes need.
//
// Same #rental-analysis -> /rental-analysis fix as every other pillar page
// built this session.
import BaseLayout from '../layouts/BaseLayout.astro';
import PropertyManagementJourneyCarousel from '../components/PropertyManagementJourneyCarousel.astro';
import LandlordLibrary from '../components/LandlordLibrary.astro';
import SampleReportCard from '../components/SampleReportCard.astro';
import { PILLAR_LANDLORD_LIBRARY_POSTS } from '../lib/property-management/pillar-landlord-library-posts';

const pageTitle = 'Leasing Process | Red Door Property Management';
const pageDescription =
  'Legally robust leases, digital signing, and a proactive 110-day renewal strategy — Red Door\'s leasing process for Indianapolis-area rental owners.';
// Redesigned 2026-10-07 (Michael): split intro with "What Strong Leasing
// Accomplishes"; six 3x2 step tiles (the sixth, security deposit, is new);
// new documentation, lease terms + tenant portal, and renewal sections; the
// plain deposit paragraph became paired move-out / deposit cards. Copy
// carries the same facts as the previous page (110-day renewals, 24-48 hour
// move-outs, three-month video inspection, one month's rent deposit).

// Tenant portal walkthrough (Loom). Set to null to show the card without it.
const TENANT_PORTAL_LOOM_ID: string | null = 'd4d34616b18246d2bdb87f9f93949e85'; // "Online Portal Overview", 2:29


const LEASE_STEPS = [
  {
    title: 'Detailed Move-In Inspection',
    text: 'A full checklist documents the home before occupancy and creates the baseline used throughout the lease.',
    points: ['Room-by-room walkthrough form', 'High-resolution photos and video', 'Incoming tenant signature', 'Included three-month video inspection'],
  },
  {
    title: 'Legally Robust Lease Agreement',
    text: 'Custom lease documents, updated for Indiana housing law, protect the property and set clear expectations for residents.',
    points: ['HOA, utility, pest, and maintenance terms', 'Unauthorized occupant and subletting restrictions', 'Smoking, pet, payment, and enforcement language', 'Digital signing and online payment setup'],
  },
  {
    title: 'Tenant Portal for Payments & Communication',
    text: 'Tenants pay rent, see their history, submit maintenance requests, and access documents online.',
    points: ['ACH autopay and payment history', 'Lease documents stored digitally', 'Maintenance requests routed through the team', 'Policy reminders and notices handled professionally'],
  },
  {
    title: '110-Day Lease Renewal Process',
    text: 'Renewals start early, so owners can evaluate rent, property condition, and tenant performance.',
    points: ['Pre-renewal inspection', 'Market rent analysis', 'Rent recommendation to the owner', 'Digitally signed renewal'],
  },
  {
    title: 'Move-Out Inspection & Deposit Reconciliation',
    text: 'Move-out inspection happens quickly, with documentation compared against the original move-in baseline.',
    points: ['Inspection within 24–48 hours', 'Full photo and video documentation', 'Room-by-room comparison to move-in', 'Transparent, lawful deposit deductions'],
  },
  {
    title: 'Standard Security Deposit Policy',
    text: 'Deposit standards help protect against unpaid rent, damage, and lease violations.',
    points: ["Typically one full month's rent", 'Higher deposits when risk factors apply', 'Reconciled against the move-in baseline'],
  },
];

const LEASE_TERMS = [
  { title: 'Occupancy and subletting', text: 'Clear restrictions help prevent unauthorized occupants or use of the home.' },
  { title: 'HOA and community rules', text: 'Rules are communicated up front when they apply to the property.' },
  { title: 'Maintenance and utility duties', text: 'Tenants understand their responsibilities, including preventable maintenance issues.' },
  { title: 'Pets, smoking, payments, and enforcement', text: 'Expectations are documented before problems need to be addressed.' },
];

const RENEWAL_STEPS = [
  { label: '110 days', title: 'Inspect and evaluate', text: 'Review property condition and tenant performance before renewal terms are discussed.' },
  { label: 'Rent check', title: 'Run a market rent analysis', text: 'Compare the current rent to market conditions and identify adjustment opportunities.' },
  { label: 'Owner plan', title: 'Present recommendations', text: 'Give the owner a clear recommendation before negotiating terms with the resident.' },
  { label: 'Sign', title: 'Update and execute the lease', text: 'Once terms are set, the updated lease is signed digitally, with both sides prepared for the next lease period.' },
];
---

<BaseLayout title={pageTitle} description={pageDescription} path="/leasing-process">
  <section class="hero hero-pillar" aria-labelledby="page-title">
    <div class="hero-content">
      <div class="eyebrow">Stage 04 &middot; Owner Roadmap</div>
      <h1 id="page-title"><span>Leasing Process</span></h1>
      <p class="hero-copy">Protecting your property, simplifying the experience &mdash; legally sound documents, digital signing, and a proactive renewal strategy.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/contact">Contact Us</a>
        <a class="btn btn-secondary" href="/rental-analysis">Get a Free Rental Analysis</a>
      </div>
    </div>
    <a class="scroll-cue" href="#leasing-intro" aria-label="Scroll to content">
      <span aria-hidden="true"></span>
      Scroll
    </a>
  </section>

  <section class="video-section">
    <div class="container">
      <div class="video-embed reveal">
        <iframe src="https://www.youtube.com/embed/LUPBd-8_b8Q" title="Leasing Process overview video" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen loading="lazy"></iframe>
      </div>
    </div>
  </section>

  <PropertyManagementJourneyCarousel />

  <section id="leasing-intro">
    <div class="container reveal">
      <div class="lease-intro-grid">
        <div class="lease-intro-card">
          <div class="section-kicker">Leasing Is a System</div>
          <h2>Protecting Your Property, Simplifying the Experience</h2>
          <p>Securing a tenant is only the beginning. A strong leasing process creates a clear condition baseline, sets expectations through legally sound documents, gives tenants easy ways to pay and communicate, and creates a repeatable process for renewals and move-outs.</p>
          <p>For owners, that means fewer gray areas. When documentation, lease language, portals, inspections, renewals, and deposit reconciliation are connected, leasing becomes one of the strongest protections for long-term rental performance.</p>
        </div>
        <aside class="lease-accomplish">
          <h3>What Strong Leasing Accomplishes</h3>
          <ul class="check-list">
            <li>Protect the property before keys are handed over</li>
            <li>Make tenant expectations clear and enforceable</li>
            <li>Keep rent payments and maintenance requests traceable</li>
            <li>Start renewal strategy early enough to avoid vacancy surprises</li>
            <li>Compare move-out condition against the original baseline</li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="section-soft pm-pad">
    <div class="container reveal">
      <div class="section-head">
        <div class="section-kicker">What Our Leasing Process Includes</div>
        <h2>From Move-In to Move-Out</h2>
        <p>Every lease follows the same documented steps, from the first walkthrough to the final deposit reconciliation.</p>
      </div>
      <div class="step-grid is-three-across">
        {LEASE_STEPS.map((step, i) => (
          <article class="step-card">
            <span class="step-icon is-number" aria-hidden="true">{i + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
            <ul class="check-list">
              {step.points.map((p) => <li>{p}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pm-pad">
    <div class="container reveal">
      <div class="lease-doc-grid">
        <SampleReportCard />
        <div class="lease-doc-copy">
          <div class="section-kicker">Documentation Examples</div>
          <h2>Move-In Evidence That Protects Everyone Later</h2>
          <p>Move-in documentation gives owners and tenants a shared record of property condition before occupancy. That record becomes essential when maintenance questions, renewal decisions, or move-out disputes come up later.</p>
          <ul class="lease-pill-list">
            <li>Clear baseline before occupancy</li>
            <li>Photos and videos tied to room-by-room notes</li>
            <li>Tenant-signed walkthrough documentation</li>
            <li>Move-out comparison used for deposit decisions</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section-soft pm-pad">
    <div class="container reveal">
      <div class="lease-two-col">
        <div>
          <div class="section-kicker">Lease Protection</div>
          <h2>Lease Terms That Reduce Owner Risk</h2>
          <p class="lead">The lease does more than start rent payments. It defines behavior, responsibilities, payment expectations, and enforcement, so owners are not left exposed when issues come up.</p>
          <div class="lease-term-list">
            {LEASE_TERMS.map((t) => (
              <div class="lease-term">
                <h3>{t.title}</h3>
                <p>{t.text}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="lease-panel">
          {TENANT_PORTAL_LOOM_ID ? (
            <div class="lease-panel-video">
              <iframe src={`https://www.loom.com/embed/${TENANT_PORTAL_LOOM_ID}`} title="Tenant portal overview" allow="fullscreen" allowfullscreen loading="lazy"></iframe>
            </div>
          ) : (
            <div class="lease-panel-kicker">
              <div class="section-kicker">Tenant Portal</div>
            </div>
          )}
          <h3>Tenant Portal and Communication Flow</h3>
          <p>The tenant portal gives owners confidence that rent payments, maintenance requests, documents, and tenant communication are managed through organized systems instead of scattered messages.</p>
          <ul class="check-list">
            <li>ACH autopay, balances, and full payment history</li>
            <li>Maintenance requests submitted and tracked online</li>
            <li>Lease documents available to tenants anytime</li>
            <li>Notices and policy reminders sent by the Red Door team</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="pm-pad">
    <div class="container reveal">
      <div class="lease-two-col">
        <div>
          <div class="section-kicker">Renewal Strategy</div>
          <h2>Start Renewals Before the Lease Is Almost Over</h2>
          <p class="lead">Starting renewals early gives owners time to evaluate condition, rent strategy, and tenant performance before the lease is close to expiring.</p>
          <ol class="lease-renewal-steps">
            {RENEWAL_STEPS.map((s) => (
              <li>
                <span class="lease-renewal-label">{s.label}</span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
        <a class="lease-panel lease-panel-link" href="/rental-analysis">
          <img class="lease-panel-image" src="/images/market-readiness/rental-analysis-sample-3-trends.webp" alt="Sample Red Door rental analysis showing local rent and inventory trends" loading="lazy" />
          <h3>Rent Recommendations Are Supported by Data</h3>
          <p>Renewal pricing is not a guess or a last-minute conversation. Red Door reviews rent positioning against current local rents and comparable homes, so owners can make informed decisions before negotiating new terms.</p>
          <span class="lease-panel-cta">See a free rental analysis &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-soft pm-pad">
    <div class="container reveal">
      <div class="lease-protect-grid">
        <article class="guarantee-card">
          <span>Move-Out Protection</span>
          <h3>Move-Out Inspection Within 24&ndash;48 Hours</h3>
          <p>Red Door completes a move-out inspection quickly, so condition is documented while the property is fresh and before any new work begins.</p>
          <ul class="check-list">
            <li>Full photo and video documentation</li>
            <li>Room-by-room condition review</li>
            <li>Comparison to the move-in inspection report</li>
            <li>Clear support for any security deposit deductions</li>
          </ul>
        </article>
        <article class="guarantee-card">
          <span>Deposit Standards</span>
          <h3>Standard Security Deposit Policy</h3>
          <p>Unless special circumstances apply, Red Door collects one full month&rsquo;s rent as the security deposit. A higher deposit may apply when risk factors are present:</p>
          <ul class="check-list">
            <li>Low credit scores</li>
            <li>Limited rental history</li>
            <li>Negative landlord references</li>
            <li>Multiple pets or high-risk pet profiles</li>
          </ul>
          <p class="lease-note">Documented service and assistance animals are not pets: pet deposits and pet-related deposit increases don&rsquo;t apply to them. See our <a href="/application-criteria">Application Criteria</a>.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-dark guarantee-section pm-pad">
    <div class="container reveal" style="text-align:center">
      <div class="section-kicker">Peace of Mind, Built Into Every Lease</div>
      <h2>Protection, Clarity, and Consistency</h2>
      <p style="max-width:56rem;margin-inline:auto">With Red Door Property Management, leasing is more than a signed document &mdash; it&rsquo;s a system for protection, clarity, and peace of mind. Whether you&rsquo;re leasing your first property or managing an entire portfolio, our team handles the details from start to finish so you don&rsquo;t have to.</p>
    </div>
  </section>

  <section id="faq">
    <div class="container reveal">
      <div class="section-head center">
        <div class="section-kicker">Questions Owners Ask</div>
        <h2>Leasing Process FAQs</h2>
      </div>
      <div class="accordion" data-accordion>
        <article class="accordion-item is-open">
          <button class="accordion-trigger" type="button" aria-expanded="true">
            <span>How do tenants pay rent?</span><span aria-hidden="true">+</span>
          </button>
          <div class="accordion-panel"><div><p>Through our secure online portal. Most set up ACH autopay, and they can always see balances and history.</p></div></div>
        </article>
        <article class="accordion-item">
          <button class="accordion-trigger" type="button" aria-expanded="false">
            <span>What happens if a tenant breaks a rule, like an HOA policy?</span><span aria-hidden="true">+</span>
          </button>
          <div class="accordion-panel"><div><p>All communication routes through Red Door. We issue reminders or notices, and we hold tenants accountable for violations or negligence that leads to avoidable costs.</p></div></div>
        </article>
        <article class="accordion-item">
          <button class="accordion-trigger" type="button" aria-expanded="false">
            <span>When do you start renewals?</span><span aria-hidden="true">+</span>
          </button>
          <div class="accordion-panel"><div><p>We start 110 days before the lease ends to maximize occupancy and ROI while keeping great tenants in place.</p></div></div>
        </article>
        <article class="accordion-item">
          <button class="accordion-trigger" type="button" aria-expanded="false">
            <span>How do you document move-in and move-out?</span><span aria-hidden="true">+</span>
          </button>
          <div class="accordion-panel"><div><p>Move-in includes a signed walkthrough, photos, and video; we repeat at move-out within 24&ndash;48 hours and compare against move-in to settle the deposit fairly.</p></div></div>
        </article>
        <article class="accordion-item">
          <button class="accordion-trigger" type="button" aria-expanded="false">
            <span>What&rsquo;s the standard security deposit?</span><span aria-hidden="true">+</span>
          </button>
          <div class="accordion-panel"><div><p>Typically one month&rsquo;s rent; higher deposits may apply for risk factors such as low credit, limited history, negative references, or multiple/high-risk pets.</p></div></div>
        </article>
        <article class="accordion-item">
          <button class="accordion-trigger" type="button" aria-expanded="false">
            <span>Do you inspect after tenants move in?</span><span aria-hidden="true">+</span>
          </button>
          <div class="accordion-panel"><div><p>Yes &mdash; besides move-in documentation, we conduct a proactive 3-month video inspection at no extra cost to the owner.</p></div></div>
        </article>
      </div>
    </div>
  </section>

  <LandlordLibrary
    heading="The Red Door Landlord Library"
    subheading="Market updates, investment insights, and practical property-management guidance for Central Indiana rental owners."
    posts={PILLAR_LANDLORD_LIBRARY_POSTS}
  />

  <section class="section-dark final-cta">
    <div class="container reveal">
      <h2>Ready for Stress-Free Leasing?</h2>
      <p>Contact us today to learn how we handle leasing the right way.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/rental-analysis">Get a Free Rental Analysis</a>
        <a class="btn btn-secondary" href="https://calendly.com/cknight-19/phone-call" target="_blank" rel="noopener">Schedule a Call</a>
        <a class="btn btn-secondary" href="tel:3176601626">Call 317.660.1626</a>
      </div>
    </div>
  </section>

  <script>
    document.querySelectorAll('[data-accordion]').forEach(function (accordion) {
      accordion.querySelectorAll('.accordion-trigger').forEach(function (trigger) {
        trigger.addEventListener('click', function () {
          var item = trigger.closest('.accordion-item');
          accordion.querySelectorAll('.accordion-item').forEach(function (candidate) {
            var candidateTrigger = candidate.querySelector('.accordion-trigger');
            var shouldOpen = candidate === item && !candidate.classList.contains('is-open');
            candidate.classList.toggle('is-open', shouldOpen);
            candidateTrigger.setAttribute('aria-expanded', String(shouldOpen));
          });
        });
      });
    });
  </script>
</BaseLayout>
