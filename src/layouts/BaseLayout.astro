---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileSticky from '../components/MobileSticky.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/blog/some-post" — the domain is added here. */
  path: string;
  ogImage?: string;
}

const {
  title,
  description,
  path,
  ogImage = 'https://www.reddoorrents.com/red-door-og-image.png',
} = Astro.props;

const canonicalUrl = `https://www.reddoorrents.com${path}`;

// GA4, installed 2026-09-24 — reuses the exact measurement ID already
// live on the old PMW site (confirmed directly from its own Google tag
// dashboard, "Installation instructions" panel) rather than creating a
// new property, so historical data stays continuous — same reasoning as
// CLAUDE.md's GTM-container-reuse decision, except there turned out to
// be no separate GTM-XXXXXXX container here to reuse: the old site's
// setup is a direct gtag.js Google tag, not a classic GTM container (its
// dashboard literally reads "the global site tag (gtag.js) is now the
// Google tag" — Google's newer unified product). The GTM container audit
// itself (tags/triggers, including a half-remembered "Paperclip" vendor
// tag Michael flagged) is still a separate, not-yet-done open item — see
// red-door-website-todo.md — this is just GA4 continuity, installed on
// its own gtag.js snippet per Google's own current instructions, not
// nested inside any GTM container.
const ga4MeasurementId = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID;
---

<!doctype html>
<html lang="en">
  <head>
    {
      ga4MeasurementId && (
        <Fragment>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4MeasurementId}`} />
          {/* set:html rather than define:vars — define:vars wraps the
              script body in an IIFE to scope the injected variable,
              which would make `gtag` a local closure instead of the
              global `window.gtag` Google's own snippet (and any future
              custom-event code elsewhere on the site) expects. */}
          <script set:html={`
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', ${JSON.stringify(ga4MeasurementId)});
          `} />
        </Fragment>
      )
    }
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <link rel="icon" href="/red-door-favicon-tile.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180.png" />
    <meta name="theme-color" content="#8c0c03" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Literata:opsz,wght@7..72,400;7..72,500;7..72,600;7..72,700&display=swap"
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip Navigation</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <MobileSticky />
    <script src="../scripts/chrome.js"></script>
  </body>
</html>
